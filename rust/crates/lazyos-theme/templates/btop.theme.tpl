{{ header }}
# btop's colour theme (btop 1.4: `color_theme = "lazyos"` in btop.conf reads
# this file). The keys are btop's own names; the values are the theme's roles,
# so a switch repaints the whole box without touching btop.conf.
theme[main_bg]="{{ background }}"
theme[main_fg]="{{ text }}"
theme[title]="{{ strong }}"
theme[hi_fg]="{{ accent }}"
theme[selected_bg]="{{ selection }}"
theme[selected_fg]="{{ text }}"
theme[inactive_fg]="{{ dim }}"
theme[graph_text]="{{ dim }}"
theme[meter_bg]="{{ surface_alt }}"
theme[proc_misc]="{{ accent_alt }}"
theme[cpu_box]="{{ surface_alt }}"
theme[mem_box]="{{ surface_alt }}"
theme[net_box]="{{ surface_alt }}"
theme[proc_box]="{{ surface_alt }}"
theme[div_line]="{{ surface_alt }}"
theme[temp_start]="{{ ok }}"
theme[temp_mid]="{{ warn }}"
theme[temp_end]="{{ danger }}"
theme[cpu_start]="{{ ok }}"
theme[cpu_mid]="{{ warn }}"
theme[cpu_end]="{{ danger }}"
theme[free_start]="{{ danger }}"
theme[free_mid]="{{ warn }}"
theme[free_end]="{{ ok }}"
theme[cached_start]="{{ accent_alt }}"
theme[cached_mid]="{{ accent }}"
theme[cached_end]="{{ strong }}"
theme[available_start]="{{ warn }}"
theme[available_mid]="{{ warn }}"
theme[available_end]="{{ ok }}"
theme[used_start]="{{ ok }}"
theme[used_mid]="{{ warn }}"
theme[used_end]="{{ danger }}"
theme[download_start]="{{ ok }}"
theme[download_mid]="{{ accent }}"
theme[download_end]="{{ accent_alt }}"
theme[upload_start]="{{ warn }}"
theme[upload_mid]="{{ accent }}"
theme[upload_end]="{{ accent_alt }}"
theme[process_start]="{{ ok }}"
theme[process_mid]="{{ warn }}"
theme[process_end]="{{ danger }}"
