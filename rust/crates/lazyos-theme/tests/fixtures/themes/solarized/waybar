# LazyOS theme: Solarized Dark (solarized) - generated by `lazyos theme set`; do not edit.
# Change the theme (`lazyos theme set NAME`) or the template, then set it again.
/* The bar: restrained terminal aesthetic with consistent module spacing. The
   palette comes from the active theme (spec 004) - this file is generated. */
* {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 600;
    min-height: 0;
    border: none;
    border-radius: 0;
    transition: background-color 120ms ease, color 120ms ease;
}

/* The theme's colours, as roles */
/* The bar is a layer-shell surface with alpha < 1 so that swayfx can blur the
   wallpaper behind it (layer_effects "waybar" in
   /etc/sway/config.d/26-swayfx.conf). The cards below keep enough opacity for
   base1 text to stay readable over any wallpaper; the blur shows through the
   bar itself and between the cards. */
window#waybar {
    background: rgba(0, 43, 54, 0.71);
    color: #93a1a1;
    border-bottom: 1px solid #073642;
}

tooltip {
    background: #073642;
    color: #eee8d5;
    border: 1px solid #586e75;
    border-radius: 6px;
    padding: 5px 8px;
}

tooltip label {
    color: #eee8d5;
}

/* Every indicator is the same card, whether it is a built-in module or one of
   the bar-* scripts: equal padding, height and background. */
#custom-menu,
#custom-busy,
#custom-updates,
#tray,
#custom-keyboard-layout,
#custom-bluetooth,
#custom-vnc,
#network,
#pulseaudio,
#backlight,
#idle_inhibitor,
#battery {
    margin: 4px 0;
    padding: 0 9px;
    background: rgba(7, 54, 66, 0.80);
    border: 1px solid rgba(9, 64, 76, 0.9);
    border-radius: 5px;
}

#custom-menu          { color: #2aa198; } /* cyan */
#custom-busy          { color: #b58900; } /* yellow: something is happening */
#custom-updates       { color: #b58900; } /* yellow */
#custom-keyboard-layout { color: #839496; }
#custom-bluetooth     { color: #586e75; }
#custom-bluetooth.on  { color: #268bd2; } /* blue */
#custom-vnc           { color: #b58900; } /* yellow: this session is being served */
#network              { color: #2aa198; }
#network.disconnected {
    color: #dc322f;
    border-color: #dc322f;
}
#pulseaudio           { color: #268bd2; } /* violet */
#pulseaudio.muted     { color: #dc322f; }
#backlight            { color: #b58900; }
/* The coffee cup is a switch: dim is its off state, yellow is on. */
#idle_inhibitor       { color: #586e75; }
#idle_inhibitor.activated { color: #b58900; } /* yellow: kept awake */
#battery              { color: #859900; }
#battery.warning      { color: #b58900; }
#battery.critical:not(.charging) {
    color: #dc322f;
    background: #3b2023;
    border-color: #dc322f;
}
#battery.charging,
#battery.plugged { color: #2aa198; }

#custom-menu:hover,
#custom-busy:hover,
#custom-updates:hover,
#custom-keyboard-layout:hover,
#custom-bluetooth:hover,
#custom-vnc:hover,
#network:hover,
#pulseaudio:hover,
#backlight:hover,
#idle_inhibitor:hover,
#battery:hover {
    background: rgba(9, 64, 76, 0.86);
}

/* The StatusNotifier icons keep their own colours; only the slot is themed. */
#tray {
    padding: 0 6px;
    color: #93a1a1;
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    background: #3b2023;
    border-color: #dc322f;
}

/* A module whose script reports nothing (no upgrades, a single keyboard
   layout) collapses to zero width instead of leaving an empty card on the
   bar.  The class comes from the JSON the script prints. */
#custom-updates.empty,
#custom-busy.empty,
#custom-keyboard-layout.empty,
#custom-vnc.empty {
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
}

/* The centered clock is plain text, not a rounded module/card. */
#clock {
    color: #eee8d5;
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    padding: 0;
    margin: 0;
}

/* Workspace buttons look like compact terminal tabs. */
#workspaces {
    margin: 4px 2px 4px 0;
    padding: 0;
}

#workspaces button {
    min-width: 22px;
    padding: 0 7px;
    margin: 0 2px;
    background: rgba(7, 54, 66, 0.80);
    color: #93a1a1;
    border: 1px solid rgba(9, 64, 76, 0.9);
    border-radius: 5px;
    box-shadow: none;
}

#workspaces button:hover {
    background: #586e75;
    color: #eee8d5;
    border-color: #839496;
}

#workspaces button.focused,
#workspaces button.active {
    background: #2aa198; /* cyan */
    color: #002b36;
    border-color: #2aa198;
    box-shadow: none;
}

#workspaces button.urgent {
    background: #dc322f; /* red */
    color: #eee8d5;
    border-color: #dc322f;
}

#workspaces button label {
    font-size: 12px;
    font-weight: 700;
}

#mode {
    margin: 4px 0;
    padding: 0 9px;
    color: #002b36;
    background: #b58900; /* yellow */
    border: 1px solid #b58900;
    border-radius: 5px;
}
