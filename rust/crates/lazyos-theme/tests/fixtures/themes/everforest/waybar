# LazyOS theme: Everforest Dark (everforest) - generated by `lazyos theme set`; do not edit.
# Change the theme (`lazyos theme set NAME`) or the template, then set it again.
/* The bar: restrained terminal aesthetic with consistent module spacing. The
   palette comes from the active theme (spec 004) - this file is generated. */
* {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 600;
    min-height: 0;
    border: none;
    border-radius: 0;
    transition: background-color 120ms ease, color 120ms ease;
}

/* The theme's colours, as roles */
/* The bar is a layer-shell surface with alpha < 1 so that swayfx can blur the
   wallpaper behind it (layer_effects "waybar" in
   /etc/sway/config.d/26-swayfx.conf). The cards below keep enough opacity for
   base1 text to stay readable over any wallpaper; the blur shows through the
   bar itself and between the cards. */
window#waybar {
    background: rgba(45, 53, 59, 0.71);
    color: #d3c6aa;
    border-bottom: 1px solid #343f44;
}

tooltip {
    background: #343f44;
    color: #d3c6aa;
    border: 1px solid #8d897b;
    border-radius: 6px;
    padding: 5px 8px;
}

tooltip label {
    color: #d3c6aa;
}

/* Every indicator is the same card, whether it is a built-in module or one of
   the bar-* scripts: equal padding, height and background. */
#custom-menu,
#custom-busy,
#custom-updates,
#tray,
#custom-keyboard-layout,
#custom-bluetooth,
#custom-vnc,
#network,
#pulseaudio,
#backlight,
#idle_inhibitor,
#battery {
    margin: 4px 0;
    padding: 0 9px;
    background: rgba(52, 63, 68, 0.80);
    border: 1px solid rgba(50, 60, 65, 0.9);
    border-radius: 5px;
}

#custom-menu          { color: #a7c080; } /* cyan */
#custom-busy          { color: #dbbc7f; } /* yellow: something is happening */
#custom-updates       { color: #dbbc7f; } /* yellow */
#custom-keyboard-layout { color: #888578; }
#custom-bluetooth     { color: #8d897b; }
#custom-bluetooth.on  { color: #7fbbb3; } /* blue */
#custom-vnc           { color: #dbbc7f; } /* yellow: this session is being served */
#network              { color: #a7c080; }
#network.disconnected {
    color: #e67e80;
    border-color: #e67e80;
}
#pulseaudio           { color: #7fbbb3; } /* violet */
#pulseaudio.muted     { color: #e67e80; }
#backlight            { color: #dbbc7f; }
/* The coffee cup is a switch: dim is its off state, yellow is on. */
#idle_inhibitor       { color: #8d897b; }
#idle_inhibitor.activated { color: #dbbc7f; } /* yellow: kept awake */
#battery              { color: #a7c080; }
#battery.warning      { color: #dbbc7f; }
#battery.critical:not(.charging) {
    color: #e67e80;
    background: #4e4247;
    border-color: #e67e80;
}
#battery.charging,
#battery.plugged { color: #a7c080; }

#custom-menu:hover,
#custom-busy:hover,
#custom-updates:hover,
#custom-keyboard-layout:hover,
#custom-bluetooth:hover,
#custom-vnc:hover,
#network:hover,
#pulseaudio:hover,
#backlight:hover,
#idle_inhibitor:hover,
#battery:hover {
    background: rgba(50, 60, 65, 0.86);
}

/* The StatusNotifier icons keep their own colours; only the slot is themed. */
#tray {
    padding: 0 6px;
    color: #d3c6aa;
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    background: #4e4247;
    border-color: #e67e80;
}

/* A module whose script reports nothing (no upgrades, a single keyboard
   layout) collapses to zero width instead of leaving an empty card on the
   bar.  The class comes from the JSON the script prints. */
#custom-updates.empty,
#custom-busy.empty,
#custom-keyboard-layout.empty,
#custom-vnc.empty {
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
}

/* The centered clock is plain text, not a rounded module/card. */
#clock {
    color: #d3c6aa;
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    padding: 0;
    margin: 0;
}

/* Workspace buttons look like compact terminal tabs. */
#workspaces {
    margin: 4px 2px 4px 0;
    padding: 0;
}

#workspaces button {
    min-width: 22px;
    padding: 0 7px;
    margin: 0 2px;
    background: rgba(52, 63, 68, 0.80);
    color: #d3c6aa;
    border: 1px solid rgba(50, 60, 65, 0.9);
    border-radius: 5px;
    box-shadow: none;
}

#workspaces button:hover {
    background: #8d897b;
    color: #d3c6aa;
    border-color: #888578;
}

#workspaces button.focused,
#workspaces button.active {
    background: #a7c080; /* cyan */
    color: #2d353b;
    border-color: #a7c080;
    box-shadow: none;
}

#workspaces button.urgent {
    background: #e67e80; /* red */
    color: #d3c6aa;
    border-color: #e67e80;
}

#workspaces button label {
    font-size: 12px;
    font-weight: 700;
}

#mode {
    margin: 4px 0;
    padding: 0 9px;
    color: #2d353b;
    background: #dbbc7f; /* yellow */
    border: 1px solid #dbbc7f;
    border-radius: 5px;
}
