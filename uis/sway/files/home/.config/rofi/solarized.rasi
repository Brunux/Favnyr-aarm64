/* The session palette for rofi, in the same roles it has everywhere else:
 * base03 background, base02 as the selected card, base1 text, base2 for what has
 * been typed, cyan for the accent (prompt, rim, matched characters).
 *
 * Loaded by ~/.config/rofi/config.rasi, so the launcher, the window switcher and
 * the bar's dmenu popups all look the same. The layout hides everything rofi
 * shows by default and does not need here: no mode switcher, no message bar, no
 * counter - one row of input and the list.
 */

* {
    /* 0.88/0.94 rather than opaque: rofi is a layer-shell client and swayfx
     * draws the blur behind it (layer_effects "rofi" in
     * /etc/sway/config.d/26-swayfx.conf). The selected row stays darker and
     * more opaque than the list so the choice is unambiguous over any
     * wallpaper, and the accent rim is unchanged. */
    bg: rgba(0, 43, 54, 0.88);
    bg-alt: rgba(7, 54, 66, 0.94);
    fg: #93a1a1;
    fg-strong: #eee8d5;
    accent: #2aa198;
    dim: #586e75;

    font: "JetBrains Mono 12";
    background-color: @bg;
    text-color: @fg;
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 45%;
    border: 2px;
    border-color: @accent;
    border-radius: 8px;
    padding: 12px;
    location: center;
    anchor: center;
}

/* One input row and the list; the mode switcher and the message bar are left out
 * of the layout entirely. */
mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 8px;
    padding: 2px 4px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search";
    placeholder-color: @dim;
    text-color: @fg-strong;
}

listview {
    /* Up to ten rows, and the box shrinks to the number of entries it has: the
     * bar's three-item menus and the launcher's eight applications both get a box
     * that fits them, instead of ten rows with a gap under the list. */
    lines: 10;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 2px;
    padding: 0;
}

element {
    padding: 8px 10px;
    spacing: 10px;
    border-radius: 6px;
}

/* Used by the two modes that show application icons (drun and window, see
 * show-icons in config.rasi).  The lists this port draws itself pass
 * -no-show-icons and put a font glyph in the text instead, so they never
 * reserve this column. */
element-icon {
    size: 26px;
    padding: 0 6px 0 0;
}

element-text {
    text-color: inherit;
}

element selected {
    background-color: @bg-alt;
    text-color: @fg-strong;
}
