#!/bin/sh
# Install LazyOS: copy this running system onto the internal eMMC.
#
# The installer this port has is scripts/install-emmc.sh, and this menu is its
# front-end, not a second implementation of it.  It collects the facts a person
# would otherwise have to remember (which disk is the internal one, whether the
# machine is running from it, whether there is room, whether the charger is in,
# whether the installer's tools are here), draws them as the session's glyph
# rows, asks for the target's name typed in full, and hands the work to
# ~/.config/bin/lazyos-install-run.  That runner is the only thing that writes,
# and it writes by calling scripts/install-emmc.sh unchanged with CONFIRM=yes,
# which is what keeps this install byte for byte the documented one -
# check-system.sh fails if a destructive verb ever appears in the runner.
#
# Two processes, and neither stays resident: this menu is one rofi process while
# it is open (like every rofi-* here), and the runner is detached with setsid
# because a copy of the system outlives the menu that started it.  It reports
# through the session's busy card and the bar's spinner, and it leaves its log,
# its pid and its one-line result in $XDG_RUNTIME_DIR/lazyos-install so the next
# time this menu opens it can say what happened and where to read it.
#
# The layout of the menu is the safety.  `Cancel` is the first row and the
# install row is second, so a stray Enter cancels instead of erasing; when
# anything would make the write unsafe there is no install row at all and the
# red rows say why; every row is rebuilt each time the menu is drawn, so
# pressing Enter on a note re-reads the machine (plug the charger in, press
# Enter, and the reason is gone); and the last gate is typed - the disk's name,
# `mmcblk0` - which no arrow key can do.  The copy itself is deliberately not
# stoppable: a killed copy leaves a disk that is neither the old system nor the
# new one.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

# The sbin directories are on PATH from lib-rofi.sh (the session does not export
# them and half of the installer's tools - parted, mkfs.* - live there), so the
# preflight below cannot refuse an install the machine can run.

target=${DEVICE_BLOCK:-/dev/mmcblk0}
name=${target##*/}

state=${XDG_RUNTIME_DIR:-/tmp}/lazyos-install
mkdir -p "$state" 2>/dev/null || true

tmp=$(mktemp -d "${TMPDIR:-/tmp}/install.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

have() { command -v "$1" >/dev/null 2>&1; }

# runner_alive: 0 while the detached runner is still running.  The pid file is
# written by the runner itself - setsid may fork, so the pid a parent could read
# from $! is not necessarily the runner's - and a pid file can be stale, which is
# why the pid is checked with kill -0 and nothing is done with it otherwise.
runner_alive() {
	[ -s "$state/run.pid" ] || return 1
	_pid=$(cat "$state/run.pid" 2>/dev/null || :)
	case ${_pid:-} in
	'' | *[!0-9]*) return 1 ;;
	esac
	kill -0 "$_pid" 2>/dev/null
}

# find_repo: where this machine's copy of the repository is.  The image carries
# it at ~/Dev/<name> (build-rootfs.sh stages the committed tree there), LAZYOS_REPO
# overrides, and the glob covers a directory that was renamed or moved.
find_repo() {
	if [ -n "${LAZYOS_REPO:-}" ] && [ -x "$LAZYOS_REPO/scripts/install-emmc.sh" ]; then
		printf '%s\n' "$LAZYOS_REPO"
		return 0
	fi
	if [ -x "$HOME/Dev/LazyOS/scripts/install-emmc.sh" ]; then
		printf '%s\n' "$HOME/Dev/LazyOS"
		return 0
	fi
	for _d in "$HOME"/Dev/*; do
		if [ -x "$_d/scripts/install-emmc.sh" ]; then
			printf '%s\n' "$_d"
			return 0
		fi
	done
	return 1
}

# num VALUE: VALUE when it is a number, 0 otherwise.  Every byte count below
# comes from a tool that can fail, and `$((...))` on an empty string would end
# the script with set -u.
num() {
	case ${1:-} in
	'' | *[!0-9]*) printf '0' ;;
	*) printf '%s' "$1" ;;
	esac
}

# human BYTES: GiB or MiB, because "62277025792 bytes" is not a fact a person
# reads.
human() {
	awk -v b="${1:-0}" 'BEGIN {
		if (b >= 1073741824) printf "%.1f GiB", b / 1073741824
		else if (b >= 1048576) printf "%.0f MiB", b / 1048576
		else printf "%d bytes", b
	}'
}

# The preflight collects one line per fact in three files rather than in
# variables, so a label and its detail stay one row each:
#   block  reasons there is no install row at all
#   warn   things the runner handles by itself (it stops udisks2, it unmounts
#          the target's partitions) or that only cost a feature
#   info   what was checked and passed, which is what makes the menu a report
#          and not just a button
blocker() {
	printf '%s|%s\n' "$1" "$2" >>"$tmp/block"
	blocked=yes
}
warning() { printf '%s|%s\n' "$1" "$2" >>"$tmp/warn"; }
checked() { printf '%s|%s\n' "$1" "$2" >>"$tmp/info"; }

# What the copy weighs.  `df` on / counts everything, but install-emmc.sh leaves
# the build tree out (--exclude="$WORK_DIR"), and on a machine that has built
# this port that tree is bigger than the system it built.  Measured once: the
# menu is open for seconds and the number cannot change under it.  A du that does
# not finish prints nothing, which falls back to counting the tree (the
# pessimistic direction), and the timeout is there because a cold cache over
# hundreds of thousands of files is not worth a menu that will not open.
copy_bytes() {
	_root=$(df -B1 / 2>/dev/null | awk 'NR == 2 { print $3 }' || :)
	_boot=0
	if [ "$(findmnt -n -o TARGET /boot 2>/dev/null || :)" = /boot ]; then
		_boot=$(df -B1 /boot 2>/dev/null | awk 'NR == 2 { print $3 }' || :)
	fi
	_work=${WORK_DIR:-$HOME/.cache/debian-aarch64/work}
	_excl=0
	if [ -d "$_work" ]; then
		_du=$(timeout 5 du -sx -B1 "$_work" 2>/dev/null || :)
		_excl=$(num "${_du%%[[:space:]]*}")
	fi
	_used=$(( $(num "$_root") + $(num "$_boot") ))
	[ "$_excl" -lt "$_used" ] || _excl=0
	printf '%s\n' "$((_used - _excl))"
}

# check_rows: one pass of the preflight.  Sets `blocked` and the facts the menu
# message needs, and fills the three files above.  Everything here is read-only:
# this script never touches the target.
check_rows() {
	: >"$tmp/block"
	: >"$tmp/warn"
	: >"$tmp/info"
	blocked=no

	# --- the target ---------------------------------------------------------
	bytes=0
	if [ -b "$target" ]; then
		bytes=$(num "$(lsblk -bdno SIZE "$target" 2>/dev/null || :)")
		_model=$(lsblk -dnro MODEL "$target" 2>/dev/null | tr -s ' ' | sed 's/ *$//' || :)
		checked 'target' "$target${_model:+ · $_model} · $(human "$bytes")"
	else
		blocker "no $target on this machine" \
			'the internal disk is /dev/mmcblk0; there is nothing to install to'
	fi

	# --- where this system runs from ---------------------------------------
	# install-emmc.sh refuses this itself, and so does the runner; the menu is
	# where it can be said in words before anything is typed.
	root_src=$(findmnt -n -o SOURCE / 2>/dev/null || :)
	root_src=${root_src%%\[*}
	root_disk=$(lsblk -snro NAME "$root_src" 2>/dev/null | tail -n 1 || :)
	if [ -n "$root_disk" ] && [ "$root_disk" = "$name" ]; then
		blocker "this system is running from $target" \
			'boot the microSD and run the install from the card'
	fi

	# --- space --------------------------------------------------------------
	# The layout costs 128 MiB of kernel partition, 512 MiB of /boot and the GPT
	# itself, and the copy has to leave a little room to grow into: a rootfs that
	# fills its disk exactly cannot be updated later.
	layout=$((704 * 1024 * 1024))
	margin=$((1024 * 1024 * 1024))
	usable=$((bytes - layout))
	if [ "$bytes" -gt 0 ]; then
		if [ "$copy_size" -gt $((usable - margin)) ]; then
			blocker 'the target is too small for this system' \
				"at most $(human "$copy_size") to copy, $(human "$usable") usable on $target"
		else
			checked 'space' "at most $(human "$copy_size") to copy · $(human "$usable") on $target"
		fi
	fi

	# --- power --------------------------------------------------------------
	# The copy is minutes of writing to the internal disk.  A machine on its last
	# fifth without a charger is not the machine to start it from; below half is
	# worth saying out loud.
	ac=no
	cap=
	for _ps in /sys/class/power_supply/*; do
		[ -d "$_ps" ] || continue
		case $(cat "$_ps/type" 2>/dev/null || :) in
		Mains | USB | USB_C)
			[ "$(cat "$_ps/online" 2>/dev/null || echo 0)" = 1 ] && ac=yes
			;;
		Battery)
			# The touchpad and the stylus report a battery of their own with a
			# capacity of 0; only the fuel gauge is a battery this cares about.
			case ${_ps##*/} in
			hid-*) ;;
			*) [ -n "$cap" ] || cap=$(cat "$_ps/capacity" 2>/dev/null || :) ;;
			esac
			;;
		esac
	done
	cap=$(num "$cap")
	if [ "$ac" = yes ]; then
		_power='charger connected'
		[ "$cap" -gt 0 ] && _power="$_power · battery ${cap}%"
		checked 'power' "$_power"
	elif [ "$cap" -gt 0 ] && [ "$cap" -lt 20 ]; then
		blocker 'the battery is too low to start' \
			"${cap}% and the charger is not connected"
	elif [ "$cap" -gt 0 ] && [ "$cap" -lt 50 ]; then
		warning 'the battery is below half' \
			"${cap}% and the charger is not connected: plug it in first"
	elif [ "$cap" -gt 0 ]; then
		checked 'power' "battery ${cap}% · on battery"
	else
		checked 'power' 'no battery reading: a machine that cannot lose power is safest'
	fi

	# --- the kernel the kernel partition is built from ----------------------
	# install-emmc.sh takes the image, the initramfs and the modules from the
	# running system; when they are not here it dies after the disk was already
	# formatted, which is exactly the failure this menu exists to catch early.
	rel=$(uname -r)
	if [ -d "/lib/modules/$rel" ] && [ -f "/boot/vmlinuz-$rel" ] && [ -f "/boot/initrd.img-$rel" ]; then
		checked 'kernel' "$rel · modules, image and initramfs are here"
	else
		blocker "the running kernel's files are incomplete" \
			"need /lib/modules/$rel and /boot/vmlinuz-$rel"
	fi

	# --- the repository, and the tools it installs with ---------------------
	repo=$(find_repo || :)
	if [ -z "$repo" ]; then
		blocker 'the repository is not on this machine' \
			'the installer is ~/Dev/LazyOS/scripts/install-emmc.sh'
	fi
	missing=
	for _c in rsync parted cgpt depthchargectl mkfs.ext2 mkfs.ext4 blkid \
		blockdev partx findmnt mount umount flock setsid; do
		have "$_c" || missing="$missing $_c"
	done
	if [ -n "$missing" ]; then
		blocker 'the installer is incomplete' \
			"missing:${missing} (see devices/google-asurada/packages.list)"
	else
		# 59 characters: ui_trim keeps 60, and a sentence one over is cut by its
		# path rule (a slash in "mkfs/blkid" turned the row into "…/blkid set are
		# here"), which is how a reassuring row became a puzzling one.
		checked 'tools' 'rsync, parted, cgpt, depthchargectl, mkfs and blkid are here'
	fi
	if ! have futility; then
		warning 'futility is not installed' \
			'the kernel partition cannot be verified after the write'
	fi
	if ! have systemd-inhibit; then
		warning 'systemd-inhibit is not installed' \
			'the machine could suspend in the middle of the copy'
	fi
	if ! have less || ! have foot; then
		warning 'less or foot is not installed' \
			'the log window will not open (the log file is still written)'
	fi

	# --- sudo ---------------------------------------------------------------
	# The write is one privileged call made by a detached process: there is no
	# terminal to answer a password prompt on.
	if sudo -n true 2>/dev/null; then
		checked 'sudo' 'the installer can run without a password prompt'
	else
		blocker 'sudo asks for a password' \
			'the install runs detached and cannot answer a prompt'
	fi

	# --- what the runner will do, said before it does it --------------------
	if systemctl is-active --quiet udisks2 2>/dev/null; then
		warning 'udisks2 is running' \
			'the runner stops it for the write and starts it again'
	fi
	mounted=
	for _p in $(lsblk -nro PATH "$target" 2>/dev/null || :); do
		[ "$_p" != "$target" ] || continue
		if findmnt -rn -S "$_p" >/dev/null 2>&1; then
			mounted="$mounted $_p"
		fi
	done
	if [ -n "$mounted" ]; then
		warning 'the target has mounted partitions' \
			"they will be unmounted first:${mounted}"
	fi
}

# emit_rows FILE GLYPH COLOUR: the collected label|detail lines as menu rows.
# The key is `none`, so pressing Enter on one of them re-checks the machine
# instead of closing the menu (bar-menu's heading rows work the same way).
emit_rows() {
	while IFS='|' read -r _label _detail; do
		[ -n "$_label" ] || continue
		ui_row "$2" "$_label" "$_detail" none "$3"
	done <"$tmp/$1"
}

# menu_rows: the list, built from one pass of check_rows, plus what the last run
# did (the runner leaves `done`, `failed: ...` or a stale `running` behind, and
# the log is the only place the details live).
menu_rows() {
	check_rows
	if [ "$blocked" = yes ]; then
		ui_row "$UI_I_WARN" 'Cannot install yet' 'nothing is written · Enter re-checks' none "$UI_RED"
		ui_row "$UI_I_UNDO" 'Close' 'fix the reasons, then open this again' close "$UI_GREEN"
		ui_heading 'the reasons'
		emit_rows block "$UI_I_WARN" "$UI_RED"
		emit_rows warn "$UI_I_WARN" "$UI_YELLOW"
		mesg='nothing is written · Enter re-checks the machine'
	else
		ui_row "$UI_I_UNDO" 'Cancel' 'nothing is written' cancel "$UI_GREEN"
		ui_row "$UI_I_SHIELD" 'Install LazyOS' "$target · everything on it is erased" install "$UI_RED"
		emit_rows warn "$UI_I_WARN" "$UI_YELLOW"
		mesg="$target · running from $root_src · a stray Enter cancels"
	fi
	if [ -s "$tmp/info" ]; then
		ui_heading 'checked'
		emit_rows info "$UI_I_CHECK" "$UI_GREEN"
	fi
	if [ -s "$state/status" ]; then
		ui_heading 'last time'
		case $(head -n 1 "$state/status" 2>/dev/null || :) in
		done)
			ui_row "$UI_I_CHECK" 'The last install finished' \
				"$(cat "$state/target" 2>/dev/null || echo "$target") · reboot and pick the internal disk" none "$UI_GREEN"
			;;
		failed*)
			ui_row "$UI_I_WARN" 'The last install failed' \
				"$(head -n 1 "$state/status" | sed 's/^failed: *//')" none "$UI_RED"
			;;
		running)
			# A pid file that is gone and a status that still says running
			# means the runner was killed: the disk may be half written, and
			# the log is where that is visible.
			ui_row "$UI_I_WARN" 'The last install did not finish' \
				'the log says where it stopped' none "$UI_RED"
			;;
		esac
		if [ -s "$state/log" ]; then
			ui_row "$UI_I_EYE" 'Show the last log' "$(cat "$state/log")" log "$UI_DIM"
		fi
	fi
}

# menu_running: what the menu says while the copy is on its way.  There is no
# stop row: killing the runner would leave a disk that is neither system, so the
# menu offers the log and nothing else.
menu_running() {
	ui_row "$UI_I_EYE" 'Show the install log' "$(cat "$state/log" 2>/dev/null || echo 'no log yet')" log "$UI_CYAN"
	ui_row "$UI_I_UNDO" 'Close' 'the copy continues without this window' close "$UI_GREEN"
	ui_heading 'installing'
	ui_note 'not stoppable' 'a killed copy leaves the disk half written'
	ui_note 'the bar shows it' 'the spinner next to the clock, until the card says how it went'
}

# Measured once, before the menu opens: the number cannot change while it is up,
# and a redraw has to be cheap (it re-reads the machine, not the disk).
copy_size=$(copy_bytes)

while :; do
	if runner_alive; then
		menu_running >"$tmp/rows"
		key=$(ui_pick 'Installing LazyOS' \
			'a copy is in progress · the bar shows it · it cannot be stopped' <"$tmp/rows") || exit 0
		case $key in
		log) exec "$dir/lazyos-install-log" ;;
		*) exit 0 ;;
		esac
	fi
	menu_rows >"$tmp/rows"
	key=$(ui_pick 'Install LazyOS' "$mesg" <"$tmp/rows") || exit 0
	case $key in
	install) break ;;
	log) exec "$dir/lazyos-install-log" ;;
	close) exit 0 ;;
	none) continue ;;
	*) exit 0 ;;
	esac
done

# The last gate: the target's name typed in full.  A list cannot ask this - Enter
# on a row is exactly the gesture that must not start an erase - and the answer is
# compared whole, so a typo, a trailing space or the *other* disk's name writes
# nothing at all.
answer=$("$UI_BIN/bar-pick" "Type $name to confirm" -free \
	-mesg "Everything on $target will be erased" \
	-theme-str 'mainbox { children: [ inputbar, message, listview ]; }') || exit 0
if [ "$answer" != "$name" ]; then
	ui_say 'Install LazyOS' "Nothing was written: the name did not match ($name expected)" \
		critical "$UI_ICON_ERROR"
	exit 1
fi

# The runner is detached because the copy takes minutes and the menu is not the
# thing that should own it.  It writes its own pid file as its first action, so
# this waits for that instead of trusting a pid from the shell, and if it died in
# that first second the log's tail is the reason.
setsid "$dir/lazyos-install-run" "$target" "$repo" >/dev/null 2>&1 &
_n=0
while [ ! -s "$state/run.pid" ] && [ "$_n" -lt 30 ]; do
	sleep 0.1
	_n=$((_n + 1))
done
if ! runner_alive; then
	_why=$(tail -n 2 "$state/log" 2>/dev/null | tr '\n' ' ' || :)
	ui_say 'Install LazyOS' "The install did not start: ${_why:-no message}" \
		critical "$UI_ICON_ERROR"
	exit 1
fi
ui_say 'Install LazyOS' \
	"Copying this system to $target · the bar shows the progress · open Install LazyOS again for the log" \
	normal "$UI_ICON_INSTALL"
