#!/bin/sh
# Browse the filesystem in rofi - or search all of $HOME from one entry - and
# open what is chosen with the program that fits it.
#
#   text  -> bat in a floated foot window (paged, solarized, line numbers)
#   image -> imv, the GPU viewer (zoom, pan, rotate, slideshow of the folder);
#            chafa's sixels in that same foot window if imv cannot start
#   video -> mpv, detached: a real player with seek, subtitles and sound, and
#            mpv-mpris loaded so playerctl and the Media menu see it
#   doc   -> papers: PDF, DjVu, comics (CBZ/CBR/CB7/CBT), Illustrator
#   rest  -> firefox-esr: an HTML page, an EPUB, a .deb
#
# rofi 2.0 does have a filebrowser mode, but with -show-icons it draws no
# thumbnails on this image (the XDG cache is never written and every row keeps
# its mimetype icon), and it would replace the markup rows and the bat/popup
# behaviour below. The browsing is therefore a shell script over rofi's dmenu:
# the entries as markup rows, directories first, and an icon on *every* row - a
# 32 px `thumbnail://` picture where lazyos-thumbnail can make one, a glyph from
# the LazyOS icon theme (folder, text-x-generic, application-pdf, ...) everywhere
# else, chosen from the extension alone. Every row having one is the point: a
# row without an icon loses the icon column and its name starts further left, so
# a directory of text files used to be a bare, unstyled list. rofi renders a
# thumbnail through lazyos-thumbnail for the rows it is about to show, all at
# once, and only when that picture is not cached in ~/.cache/thumbnails yet.
#
#   rofi-files              start where you were last time (or in $HOME)
#   rofi-files <dir>        start there
#   rofi-files --search     every file under $HOME, narrowed by typing
#   rofi-files --hidden     start with the dotfiles shown (in either mode)
#
# Enter opens a directory (the listing reopens there) or a file; a typed path
# works too, because dmenu hands back the typed text when no row matches.
# **Alt+1 acts on the row instead of opening it** (rofi's -kb-custom-1, exit
# status 10): ~/.config/bin/rofi-file-actions offers what fits it - the size of a
# directory, packing it, unpacking an archive, mounting a disk image, converting
# a video, the path in the clipboard, a terminal in that folder. That needs
# `global-kb: true` in ~/.config/rofi/config.rasi, or sway answers Alt+1 with
# "workspace number 1" and the browser never sees the key.
# Alt+Ctrl+F opens the browser from the session, the Search key opens
# `--search`, and it is also in the root menu and the launcher ("Files").
#
# The search is one bounded fd run (--max-results 500, caches and build
# directories excluded) plus one `stat` for the metadata of whatever it found -
# never a subprocess per row - so the list is up as fast as the browser, and a
# home directory of a hundred thousand files does not become a beach ball.
# Escape closes either mode with nothing.
#
# The browser remembers where it was: the last directory browsed, or the folder
# of the last file opened (from a row or from --search), is one line in
# $XDG_STATE_HOME/lazyos/files-last. The first run, and a deleted state file,
# start in $HOME - never in $PWD, which is whatever directory the session's
# launcher happened to be in and reads as the browser forgetting.
set -eu

theme="$HOME/.config/rofi/solarized.rasi"

# State, not cache and not config: it survives a reboot, deleting it is the way
# back to $HOME, and a directory that cannot be written must not stop a file
# from opening (remember below ignores every failure).
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/lazyos
state_file=$state_dir/files-last

# remember DIR: the directory the next Alt+Ctrl+F should reopen. It is called
# for every directory browsed and for the parent of every file opened, and
# every failure is ignored - a read-only state directory must not stop a file
# from opening, and the browser still works without its memory.
remember() {
	[ -n "${1:-}" ] || return 0
	[ -d "$1" ] || return 0
	mkdir -p -- "$state_dir" 2>/dev/null || return 0
	printf '%s\n' "$1" >"$state_file" 2>/dev/null || :
}
base1="#93a1a1"     # file names, a step above the dim metadata
base01="#586e75"    # metadata, paths and the arrows
cyan="#2aa198"      # directories, the same colour the key view gives a section
yellow="#b58900"    # the hidden-files switch
tab=$(printf '\t')

# How many entries the search lists at once. rofi filters what it was given, so
# this is the size of the pool a query works on, not a page: 500 rows of a home
# directory is every file a person can name from memory, and the list is capped
# so that the one fd run stays bounded on a big tree.
LIMIT=500

hidden=no
mode=browse
from_search=no
dir=""
while [ $# -gt 0 ]; do
	case $1 in
		--hidden) hidden=yes; shift ;;
		--search) mode=search; from_search=yes; shift ;;
		--) shift; break ;;
		-*) printf 'usage: rofi-files [--hidden] [--search] [directory]\n' >&2; exit 2 ;;
		*) dir=$1; shift ;;
	esac
done
if [ $# -gt 0 ]; then dir=$1; fi

if [ "$mode" = search ]; then
	dir=$HOME
	if [ -z "$dir" ] || [ ! -d "$dir" ]; then
		notify-send -a Files -i dialog-error "No home directory" "\$HOME is $dir"
		exit 1
	fi
	# Debian's binary is fdfind; the image also has /usr/local/bin/fd (the
	# alias the shell and FZF_DEFAULT_COMMAND use), so ask $PATH and accept
	# either name. Without it the search is the one thing that cannot run, and
	# falling back to the browser is better than a key that does nothing - it
	# says so, because the Search key opening a directory listing instead of a
	# prompt would otherwise read as a broken binding.
	fd=$(command -v fd || command -v fdfind || :)
	if [ -z "$fd" ]; then
		notify-send -a Files -i system-search "Search is not available" \
			"fd is missing (package fd-find); opening the browser instead"
		mode=browse
	fi
fi
# No directory argument: reopen where the browser was, if that still exists.
# $PWD is deliberately not the fallback - Alt+Ctrl+F is pressed from wherever
# the session is, and starting there made the browser look like it forgot.
# The search always starts at $HOME and never reads or writes this memory here.
if [ -z "$dir" ]; then
	if [ "$mode" = browse ] && [ "$from_search" = no ] && [ -r "$state_file" ]; then
		last=$(head -n 1 "$state_file" 2>/dev/null || :)
		if [ -n "$last" ] && [ -d "$last" ]; then
			dir=$last
		fi
	fi
	[ -n "$dir" ] || dir=$HOME
fi
if [ ! -d "$dir" ]; then
	notify-send -a Files -i dialog-warning "Not a directory" "$dir"
	exit 1
fi
dir=$(cd -- "$dir" && pwd)

# Browsing a directory is what the next Alt+Ctrl+F should reopen, including
# the re-exec into a subdirectory (browse() starts this script again, which
# reaches this line). The search is skipped: it is defined to start at $HOME,
# and letting that overwrite the memory would send the browser home after
# every search.
if [ "$mode" = browse ] && [ "$from_search" = no ]; then
	remember "$dir"
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/files.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
table="$tmp/table"
list="$tmp/list"

# The browser reopens on a directory; a typed path goes through it, because
# dmenu returns the input text when no row matches, so it is resolved the way
# the shell would and the listing starts over.
browse() {
	exec "$0" $( if [ "$hidden" = yes ]; then printf -- --hidden; fi ) "$1"
}

# The same list again, with or without the dotfiles. Both modes get here from
# the hidden-files row, so the flags are rebuilt from the state instead of
# carrying the old command line around.
resume() {
	if [ "$mode" = search ]; then
		if [ "$hidden" = yes ]; then
			exec "$0" --hidden --search
		else
			exec "$0" --search
		fi
	fi
	if [ "$hidden" = yes ]; then
		exec "$0" --hidden "$dir"
	else
		exec "$0" "$dir"
	fi
}

# Both listings write the same seven fields per entry - type, name (as shown),
# size, date, mode, link target, absolute path - so one rows() below renders
# them and the path a row acts on is carried instead of guessed:
#
#   browse: find -L over one directory (a link to a directory is a directory
#           to open, a link to a file is a file to read; only a broken link
#           stays an `l`). -maxdepth 1 and no name filter: the dotfiles are
#           dropped by the caller, so that the hidden-files row is the one place
#           that decides. A name with a tab or a newline is skipped instead of
#           corrupting a row.
#   search: fd over $HOME, hidden only on request, caches and build trees
#           excluded, and the metadata of the matches from a single `stat`
#           (fd's own %f/%p placeholders are not enough: rofi wants a size and
#           a date per row, and `stat` formats all of them in one call).
if [ "$mode" = search ]; then
	# Newest first: a search is usually for what was just written, and with 500
	# rows shown it is the only order that puts the likely answer at the top.
	# shellcheck disable=SC2086  # --hidden is one word or nothing
	"$fd" --search-path "$dir" --type f --max-results "$LIMIT" \
		--exclude .cache --exclude .git --exclude node_modules \
		--exclude '.local/share/containers' \
		$( if [ "$hidden" = yes ]; then printf -- --hidden; fi ) \
		--print0 2>/dev/null |
		xargs -0 -r stat --printf='%s\t%a\t%y\t%n\n' 2>/dev/null |
		awk -F'\t' -v OFS='\t' -v home="$dir" '
		NF != 4 { next }
		{
			path = $4
			if (path == home) next
			if (index(path, home "/") == 1) label = "~" substr(path, length(home) + 1)
			else label = path
			print "f", label, $1, substr($3, 1, 10), $2, "", path
		}' |
		sort -t "$tab" -k4,4r -k2,2 > "$list" || :
else
	find -L "$dir" -mindepth 1 -maxdepth 1 \
		! -name "$(printf '*\t*')" ! -name "$(printf '*\n*')" \
		-printf '%y\t%f\t%s\t%TY-%Tm-%Td\t%m\t%l\t%p\n' 2>/dev/null > "$list" || :
fi

count() {
	if [ "$hidden" = yes ]; then
		awk -F'\t' -v t="$1" '(t == "d") ? ($1 == "d") : ($1 != "d")' "$list"
	else
		awk -F'\t' -v t="$1" 'substr($2, 1, 1) != "." && ((t == "d") ? ($1 == "d") : ($1 != "d"))' "$list"
	fi | wc -l
}
dirs=$(count d)
files=$(count f)

# The name column is padded to the longest name, so sizes and dates line up.
# Names may carry a "/" or an "@" after padding, hence the +2. A search row's
# name is a path and can be long, and padding those would push the metadata off
# the window for no gain, so that mode does not pad at all (w = 0).
if [ "$mode" = search ]; then
	width=0
else
	width=$(awk -F'\t' 'length($2) > m { m = length($2) } END { print m + 3 }' "$list")
fi

# One Pango markup row each, plus the action, the path and the icon. dmenu
# matches the text with the markup stripped (verified: a filter on a tag name
# finds no row), so the metadata can be dim without getting in the way of typing
# a name. There is no leading bullet any more: the icon column already says what
# a row is, and two marks in front of every name read as a mistake.
rows() {
	awk -F'\t' -v w="$width" -v base1="$base1" -v base01="$base01" -v cyan="$cyan" '
	function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); return s }
	function human(b) {
		if (b < 1024) return b " B"
		split("K M G T", u, " ")
		i = 0
		while (b >= 1024 && i < 4) { b /= 1024; i++ }
		return sprintf((b < 10 ? "%.1f" : "%.0f") "%s", b, u[i])
	}
	# The extension of the name, lowercased: "" for a dotfile (.bashrc has no
	# extension) and for a name without a dot. The mode decides the two cases
	# the name cannot: an extensionless executable is a program, an
	# extensionless something else is usually a README.
	function ext(p,   e) {
		e = tolower(p); sub(/^.*\//, "", e)
		if (e ~ /^\.[^.]*$/) return ""
		if (e !~ /\./) return ""
		sub(/^.*\./, "", e)
		return e
	}
	function xbit(m) {
		sub(/^0/, "", m)
		return (substr(m, 1, 1) % 2 || substr(m, 2, 1) % 2 || substr(m, 3, 1) % 2)
	}
	# The icon comes from the extension and the executable bit, both of which
	# the listing already carries: a `file` per row would be one subprocess per
	# entry, which is exactly what this listing avoids. The first line is what
	# lazyos-thumbnail can turn into a picture (ffmpeg for an image or a video
	# frame, poppler for a PDF page), so those ask for a thumbnail and never
	# fall back: a cached one is reused, and a decode that fails leaves the row
	# without a picture instead of with a wrong one. An image format it cannot
	# decode (.svg, .heic, a camera raw) says image-x-generic rather than asking
	# for a thumbnail that would never appear. Anything unrecognised is the
	# generic fallback, application-x-executable.
	function icon(p, m,   e) {
		e = ext(p)
		if (e ~ /^(jpg|jpeg|png|gif|webp|bmp|tif|tiff|avif|mp4|mkv|webm|mov|avi|m4v|mpg|mpeg|ogv|wmv|flv|3gp|pdf)$/)
			return "thumbnail://" p
		# The other formats papers reads: a document is a document, even when
		# lazyos-thumbnail has no decoder for it (ddjvu and an unzip of a comic
		# are not worth a subprocess per row).
		if (e ~ /^(djvu|djv|cbz|cbr|cb7|cbt|ai)$/) return "application-pdf"
		if (e ~ /^(html|htm|xhtml|shtml)$/) return "text-html"
		if (e ~ /^(odt|ods|odp|odg|doc|docx|xls|xlsx|ppt|pptx|rtf|epub)$/) return "x-office-document"
		if (e ~ /^(sh|bash|zsh|fish|py|pl|rb|lua|awk|deb|appimage|run|bin|exe|elf|o|so|a|ko)$/) return "application-x-executable"
		if (e ~ /^(tar|gz|tgz|bz2|tbz2|xz|txz|zst|zstd|zip|7z|rar|lz|lz4|lzma|iso|img)$/) return "package-x-generic"
		if (e ~ /^(mp3|flac|ogg|oga|opus|wav|m4a|aac|wma|aiff|aif|mid|midi)$/) return "audio-x-generic"
		if (e ~ /^(svgz?|heic|heif|jxl|raw|cr2|cr3|nef|arw|dng|psd|xcf|ico|icns)$/) return "image-x-generic"
		# Everything text-shaped is one icon, so it is four lines instead of
		# one: documents and logs, data and configuration, markup and scripts,
		# source code. The longest single expression in the file stays readable.
		if (e ~ /^(txt|text|log|out|err|nfo|md|markdown|rst|csv|tsv)$/) return "text-x-generic"
		if (e ~ /^(json|yml|yaml|toml|ini|cfg|conf|config|env|lock|list)$/) return "text-x-generic"
		if (e ~ /^(xml|rasi|desktop|service|rules|sql|diff|patch)$/) return "text-x-generic"
		if (e ~ /^(c|h|cc|cpp|hpp|go|rs|java|js|mjs|ts|css|scss|less|vim|el|tex|bib)$/) return "text-x-generic"
		if (e == "") return (xbit(m) ? "application-x-executable" : "text-x-generic")
		return "application-x-executable"
	}
	{
		path = $7
		colour = base1; weight = "normal"; tag = $4; kind = "file"
		if ($1 == "d") {
			colour = cyan; weight = "bold"; label = $2 "/"; kind = "dir"
		} else if ($1 == "l") {
			label = $2 "@"; tag = $4 " \302\267 broken link"
		} else if ($1 == "f") {
			label = $2; tag = human($3) " \302\267 " $4
		} else {
			label = $2; tag = $1 " \302\267 " $4
		}
		if (w > 0) label = sprintf("%-" w "s", label)
		ic = ($1 == "d") ? "folder" : ($1 == "l" ? "dialog-warning" : icon(path, $5))
		printf "<span weight=\"%s\" foreground=\"%s\">%s</span>  <span foreground=\"%s\">%s</span>\t%s\t%s\t%s\n",
			weight, colour, esc(label), base01, esc(tag), kind, path, ic
	}'
}

if [ "$mode" = browse ] && [ "$dir" != "/" ]; then
	printf '<span foreground="%s">parent directory</span>\tup\t%s\tgo-up\n' \
		"$base01" "$(dirname -- "$dir")" >> "$table"
fi
if [ "$hidden" = yes ]; then
	awk -F'\t' '$1 == "d"' "$list" | sort -f -t "$tab" -k2 | rows >> "$table"
	awk -F'\t' '$1 != "d"' "$list" | sort -f -t "$tab" -k2 | rows >> "$table"
	printf '<span foreground="%s">hidden files</span>  <span foreground="%s">shown</span>\thidden\tno\tview-hidden\n' \
		"$yellow" "$base01" >> "$table"
else
	awk -F'\t' '$1 == "d" && substr($2, 1, 1) != "."' "$list" | sort -f -t "$tab" -k2 | rows >> "$table"
	awk -F'\t' '$1 != "d" && substr($2, 1, 1) != "."' "$list" | sort -f -t "$tab" -k2 | rows >> "$table"
	printf '<span foreground="%s">hidden files</span>  <span foreground="%s">hidden</span>\thidden\tyes\tview-hidden\n' \
		"$yellow" "$base01" >> "$table"
fi

shown=$dir
case $dir in
	"$HOME") shown="~" ;;
	"$HOME"/*) shown="~${dir#"$HOME"}" ;;
esac
if [ "$mode" = search ]; then
	matches=$(wc -l < "$list")
	if [ "$matches" -ge "$LIMIT" ]; then
		mesg=$(printf '%s  \302\267  the newest %s matches  \302\267  type to narrow it  \302\267  Enter opens  \302\267  Alt+1 acts on it  \302\267  Esc closes' \
			"$shown" "$LIMIT")
	else
		mesg=$(printf '%s  \302\267  %s file%s  \302\267  Enter opens  \302\267  Alt+1 acts on it  \302\267  Esc closes' \
			"$shown" "$matches" "$(if [ "$matches" -eq 1 ]; then :; else printf s; fi)")
	fi
else
	free=$(df -h --output=avail -- "$dir" 2>/dev/null | tail -n 1 | tr -d ' ' || :)
	mesg=$(printf '%s  \302\267  %s dir%s  \302\267  %s file%s  \302\267  %s free  \302\267  Enter opens  \302\267  Alt+1 acts on it  \302\267  type a path' \
		"$shown" \
		"$dirs" "$(if [ "$dirs" -eq 1 ]; then :; else printf s; fi)" \
		"$files" "$(if [ "$files" -eq 1 ]; then :; else printf s; fi)" \
		"${free:-?}")
fi

# The parent row is first, so the selection starts on the first real entry; a
# search has no parent row, and its first row (the newest match) is selected.
first=0
if [ "$mode" = browse ] && [ "$dir" != "/" ]; then first=1; fi

# dmenu rows carry an optional icon after a NUL: `text\0icon\x1f<value>`. For a
# `thumbnail://<path>` value rofi calls lazyos-thumbnail with the cache file it
# wants ({output}), and skips the call when that file already exists. Every row
# carries one, so the 32 px icon column is the same width everywhere and a name
# never starts under a neighbour's icon. awk cannot write a NUL in a string
# constant (mawk truncates the format at \0), so the separator is built with %c:
# 0 and 31, the unit separator rofi expects.
dmenu_rows() {
	awk -F'\t' '
	BEGIN { sep = sprintf("%cicon%c", 0, 31) }
	{ if ($4 == "") print $1; else print $1 sep $4 }' < "$table"
}

if [ "$mode" = search ]; then prompt="Search"; else prompt="Files"; fi
# rofi exits 10 for -kb-custom-1 (Alt+1) and 1 for a dismissal; the row comes
# back on stdout either way, so the status is read after the choice.
rc=0
choice=$(dmenu_rows |
	rofi -dmenu -markup-rows -i -show-icons -theme "$theme" \
		-p "$prompt" -lines 18 -selected-row "$first" \
		-kb-custom-1 Alt+1 \
		-preview-cmd "$HOME/.config/bin/lazyos-thumbnail {input} {output} {size}" \
		-theme-str "window { width: 58%; }
mainbox { children: [ inputbar, message, listview ]; }
element-icon { size: 32px; padding: 0 8px 0 0; }" \
		-mesg "$mesg") || rc=$?
case $rc in
0 | 10) ;;
*) exit 0 ;;
esac

if [ -z "$choice" ]; then exit 0; fi

action=$(awk -F'\t' -v d="$choice" '$1 == d { print $2; exit }' "$table")
payload=$(awk -F'\t' -v d="$choice" '$1 == d { print $3; exit }' "$table")

if [ -z "$action" ]; then
	case $choice in
		"~") choice="$HOME" ;;
		"~/"*) choice="$HOME/${choice#\~/}" ;;
	esac
	if [ -d "$choice" ]; then
		browse "$choice"
	fi
	if [ -f "$choice" ]; then
		action=file
		payload=$(cd -- "$(dirname -- "$choice")" && pwd)/$(basename -- "$choice")
	else
		notify-send -a Files -i dialog-warning "No such path" "$choice"
		exit 0
	fi
fi

# Alt+1 asks what else can be done with the row instead of opening it, and it
# works on the row that was typed as well as on the one that was listed. The
# dotfile switch is the one row with nothing behind it.
if [ "$rc" -eq 10 ]; then
	if [ "$action" = hidden ]; then
		notify-send -a Files -i view-hidden "Hidden files" \
			"Enter switches them · Alt+1 has nothing to act on"
		exit 0
	fi
	exec "$HOME/.config/bin/rofi-file-actions" "$payload"
fi

# The browser is the reader for what the other programs do not take: an EPUB, a
# .deb, anything binary without a better home. It is also the fallback for a
# video when mpv is missing and for a document when papers is, which is why it
# is one function and not a line at the bottom of every branch.
open_browser() {
	if command -v firefox-esr >/dev/null 2>&1; then
		setsid firefox-esr "file://$1" >/dev/null 2>&1 &
	else
		notify-send -a Files -i dialog-error "$2" "Not a text file, and no browser is installed to open it"
	fi
}

case $action in
	dir|up) browse "$payload" ;;
	hidden)
		if [ "$payload" = yes ]; then
			hidden=yes
		else
			hidden=no
		fi
		resume
		;;
	file)
		# bat in foot, paged and solarized (BAT_THEME=ansi is what the shell
		# profile sets; foot runs the command directly, so pass it here).
		# Only text is opened: bat would show a binary as an empty page.
		if [ ! -e "$payload" ]; then
			notify-send -a Files -i dialog-warning "$(basename -- "$payload")" "Broken link, there is nothing there"
			exit 0
		fi
		if [ ! -r "$payload" ]; then
			notify-send -a Files -i dialog-error "$(basename -- "$payload")" "Not readable by this user"
			exit 0
		fi
		# A file was opened: the next Alt+Ctrl+F starts in the folder it lives
		# in, not at the top of the tree. This covers a row of --search too,
		# which is the case where the file is usually furthest from home.
		remember "$(dirname -- "$payload")"
		name=$(basename -- "$payload")
		total=$(head -c 4096 -- "$payload" 2>/dev/null | wc -c)
		text=$(head -c 4096 -- "$payload" 2>/dev/null | tr -d '\000' | wc -c)
		# The two kinds of media, by the same extension table the row's icon
		# came from. A picture goes to imv, which draws it on the GPU with zoom,
		# pan, rotation and a slideshow of the folder; chafa's sixels in one foot
		# window (~16 MB measured) are the fallback for a GPU where imv gets no
		# EGL context. chafa cannot decode a video container - that is the
		# "unknown file format" a video used to produce - so video goes to mpv.
		kind=other
		case $(printf '%s' "$name" | tr 'A-Z' 'a-z') in
			*.jpg|*.jpeg|*.png|*.gif|*.webp|*.bmp|*.tif|*.tiff|*.avif|*.svg)
				kind=image ;;
			*.mp4|*.mkv|*.webm|*.mov|*.avi|*.m4v|*.mpg|*.mpeg|*.ogv|*.wmv|*.flv|*.3gp)
				kind=video ;;
			*.pdf|*.djvu|*.djv|*.cbz|*.cbr|*.cb7|*.cbt|*.ai) kind=doc ;;
		esac
		if [ "$kind" = doc ]; then
			# papers is the reader (search, zoom, print, annotations), and it
			# decides before the text test below: a PDF's first page is often
			# plain ASCII, and that test only looks for NUL bytes, so half the
			# PDFs in the world would pass it and open as garbage in bat.
			if command -v papers >/dev/null 2>&1; then
				setsid papers "$payload" >/dev/null 2>&1 &
			else
				open_browser "$payload" "$name"
			fi
		elif [ "$kind" = image ] && command -v imv >/dev/null 2>&1; then
			# imv draws on the GPU and gives zoom, pan, rotation and a slideshow
			# of the directory; setsid lets it outlive this script, which exits
			# as soon as it is started. The image family is decided before the
			# text test on purpose: an SVG *is* a text file, and with the old
			# order it opened as source in bat and could never be looked at.
			# The hint is asked for before imv starts, because it is the one
			# moment the keys are worth saying; it is a no-op after the first
			# picture of the session.
			"$HOME/.config/bin/lazyos-image-hint" || :
			setsid imv -- "$payload" >/dev/null 2>&1 &
		elif [ "$kind" = image ] && command -v chafa >/dev/null 2>&1; then
			# The fallback for a GPU where imv gets no EGL context: --hold keeps
			# the window up after chafa has drawn once and exited, and the inner
			# sh waits for foot to resize the pty (a terminal starts at 80x24
			# and only then matches the window), so chafa measures the real size
			# instead of painting into a corner.
			setsid foot --hold --app-id=popup --title="$name" \
				-e sh -c 'sleep 0.2; exec chafa -f sixels "$1"' chafa "$payload" \
				>/dev/null 2>&1 &
		elif [ "$text" -eq "$total" ]; then
			setsid foot --app-id=popup --title="$name" \
				env BAT_THEME=ansi bat --paging=always --style=numbers \
				--file-name="$name" -- "$payload" \
				>/dev/null 2>&1 &
		elif [ "$kind" = video ] && command -v mpv >/dev/null 2>&1; then
			# --no-config so nothing in ~/.config/mpv (a GUI driver, a shader,
			# a profile from another machine) can decide what this does: the
			# session is wayland-native and mpv's default vo=gpu picks the
			# wayland context on its own. --force-window makes the window
			# appear immediately instead of after the first decoded frame,
			# --keep-open=no closes it at the end of the file, and setsid lets
			# mpv outlive this script, which exits as soon as it is started.
			# --no-config empties the script directories too, so mpv-mpris (and
			# with it playerctl, the Media menu and the bar) only sees the film
			# when the plugin is passed by path.
			set -- --no-config --no-resume-playback --force-window=yes \
				--keep-open=no --title="$name"
			if [ -r /etc/mpv/scripts/mpris.so ]; then
				set -- "$@" --script=/etc/mpv/scripts/mpris.so
			fi
			setsid mpv "$@" -- "$payload" >/dev/null 2>&1 &
		else
			# Everything else is the browser's job: an EPUB, a .deb is a
			# download prompt, which is still an answer, and it is also the
			# fallback for a video when mpv is missing. setsid keeps it alive
			# after this script exits.
			open_browser "$payload" "$name"
		fi
		;;
esac
