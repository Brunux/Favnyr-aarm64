#!/bin/sh
# Media: what is playing, and the four buttons that matter.
#
# playerctl talks to whatever MPRIS player is running (mpv, Firefox, a music
# player), so this works for all of them without a per-application integration.
# Deboma draws the same controls in its bar; here they are one list, and the
# track line at the top is also the way to copy what is playing.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"


if ! command -v playerctl >/dev/null 2>&1; then
	ui_say Media 'playerctl is not installed' critical
	exit 1
fi

players=$(playerctl -l 2>/dev/null || true)
if [ -z "$players" ]; then
	ui_say Media 'Nothing is playing (no MPRIS player is running)'
	exit 0
fi

artist=$(playerctl metadata artist 2>/dev/null || true)
title=$(playerctl metadata title 2>/dev/null || true)
album=$(playerctl metadata album 2>/dev/null || true)
status=$(playerctl status 2>/dev/null || true)

now=${title:-unknown}
[ -n "$artist" ] && now="$artist — $title"
[ -n "$album" ] && now="$now · $album"

tmp=$(mktemp "${TMPDIR:-/tmp}/media.XXXXXX")
trap 'rm -f "$tmp"' EXIT

{
	ui_row "$UI_I_MUSIC" "$now" "${status:-stopped}" copy
	if [ "$status" = Playing ]; then
		ui_row "$UI_I_STOP" 'Pause' '' pause
	else
		ui_row "$UI_I_PLAY" 'Play' '' play
	fi
	ui_row "$UI_I_NEXT" 'Next track' '' next
	ui_row "$UI_I_PREV" 'Previous track' '' previous
	ui_row "$UI_I_STOP" 'Stop' '' stop
} >"$tmp"

key=$(ui_pick 'Media' 'Enter acts · Escape closes' <"$tmp") || exit 0
case $key in
copy)
	_track=$title
	[ -n "$artist" ] && _track=$artist' - '$title
	ui_copy "$_track" 'Track copied'
	;;
play) playerctl play >/dev/null 2>&1 || true ;;
pause) playerctl pause >/dev/null 2>&1 || true ;;
next) playerctl next >/dev/null 2>&1 || true ;;
previous) playerctl previous >/dev/null 2>&1 || true ;;
stop) playerctl stop >/dev/null 2>&1 || true ;;
esac
