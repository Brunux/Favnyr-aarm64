#!/bin/sh
# The notification history and do-not-disturb, in a list.
#
# mako already keeps what it showed in a buffer (`makoctl history -j`), which is
# exactly Deboma's notification panel content without the panel: the rows are the
# history, Enter copies one to the clipboard, and the two footer rows are the
# switches (dismiss everything, toggle do-not-disturb).  Nothing stays resident,
# and mako keeps being the only notification daemon.
#
# A row shows the summary in bold and the body dim, truncated, because a rofi row
# is a single line.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"


if ! makoctl list >/dev/null 2>&1; then
	ui_say Notifications 'mako is not running, so there is no history' critical
	exit 1
fi

dnd=off
makoctl mode 2>/dev/null | grep -qx do-not-disturb && dnd=on

tmp=$(mktemp -d "${TMPDIR:-/tmp}/notify.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

# One line per notification: id, app, summary, body.  Tabs and newlines in the
# body would break both the table and the row, so they become spaces here.
makoctl history -j 2>/dev/null |
	jq -r '.[]? | [ (.id|tostring), (.app_name // ""), (.summary // ""),
		((.body // "") | gsub("[\\t\\n\\r]+"; " ")) ] | @tsv' >"$tmp/data" || : >"$tmp/data"

count=$(grep -c . "$tmp/data" || true)

{
	if [ "${count:-0}" -eq 0 ]; then
		ui_note 'Nothing in the history yet' 'Notifications land here after they expire'
	else
		while IFS=$(printf '\t') read -r id app summary body; do
			[ -n "$id" ] || continue
			_body=$(printf '%s' "$body" | cut -c1-64)
			[ "$_body" = "$body" ] || _body="$_body…"
			ui_row "$UI_I_BELL" "${summary:-Notification}" "$app · $_body" "id:$id"
		done <"$tmp/data"
	fi
	if [ "$dnd" = on ]; then
		ui_row "$UI_I_BELL_OFF" 'Do not disturb' 'on' dnd "$UI_YELLOW"
	else
		ui_row "$UI_I_BELL" 'Do not disturb' 'off' dnd "$UI_DIM"
	fi
	ui_row "$UI_I_UNDO" 'Restore the last one' 'back on screen' restore "$UI_DIM"
	ui_row "$UI_I_TRASH" 'Dismiss everything' "$count in the history" dismiss "$UI_DIM"
} >"$tmp/rows"

mesg=
if [ "${count:-0}" -gt 0 ]; then
	mesg='Enter copies the notification · Escape closes'
else
	mesg='Escape closes'
fi

key=$(ui_pick 'Notifications' "$mesg" <"$tmp/rows") || exit 0

case $key in
id:*)
	_id=${key#id:}
	_row=$(awk -F'\t' -v i="$_id" '$1 == i { print; exit }' "$tmp/data")
	_summary=$(printf '%s' "$_row" | cut -f3)
	_body=$(printf '%s' "$_row" | cut -f4)
	if [ -n "$_body" ]; then
		ui_copy "$_summary
$_body" 'Notification copied to the clipboard'
	else
		ui_copy "$_summary" 'Notification copied to the clipboard'
	fi
	;;
dnd)
	makoctl mode -t do-not-disturb >/dev/null 2>&1 || true
	;;
restore)
	makoctl restore >/dev/null 2>&1 || ui_say Notifications 'There is nothing to restore'
	;;
dismiss)
	makoctl dismiss -a >/dev/null 2>&1 || true
	ui_say Notifications 'Everything dismissed'
	;;
esac
