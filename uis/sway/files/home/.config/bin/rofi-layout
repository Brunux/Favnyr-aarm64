#!/bin/sh
# Keyboard layouts: the list xkb ships, with the active one marked.
#
# Deboma sets the layout from its settings panel.  Here the list comes from
# /usr/share/X11/xkb/rules/evdev.lst - the same file the compositor reads, so
# there is no hardcoded table to go stale - and the choice is applied to every
# keyboard at once (the internal cros-ec one and a USB one would otherwise keep
# their own), then written to a per-user sway drop-in so it is still there at
# the next login.
#
# bar-key keeps showing the active layout on the bar and cycling it on click;
# this is the other half, for picking a specific one.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

rules=/usr/share/X11/xkb/rules/evdev.lst
[ -r "$rules" ] || {
	ui_say 'Keyboard layout' "$rules is missing (package xkb-data)" critical
	exit 1
}

active=$(swaymsg -t get_inputs -r 2>/dev/null |
	jq -r '[ .[] | select(.type == "keyboard") ][0].xkb_active_layout_name // empty' |
	head -1)

tmp=$(mktemp "${TMPDIR:-/tmp}/layout.XXXXXX")
trap 'rm -f "$tmp"' EXIT

# "! layout" opens the section; its lines are "<code> <English name>".
awk '/^! layout/ { f = 1; next } /^!/ { f = 0 } f && NF > 1 {
	code = $1
	$1 = ""
	sub(/^ +/, "")
	printf "%s\t%s\n", code, $0
}' "$rules" >"$tmp.raw"

{
	while IFS=$(printf '\t') read -r code name; do
		if [ "$name" = "$active" ]; then
			ui_row "$UI_ON" "$name" "$code · current" "$code"
		else
			ui_row "$UI_OFF" "$name" "$code" "$code"
		fi
	done <"$tmp.raw"
} >"$tmp"
rm -f "$tmp.raw"

new=$(ui_pick 'Keyboard layout' "${active:-No layout reported}" <"$tmp") || exit 0
[ -n "$new" ] || exit 0

swaymsg input type:keyboard xkb_layout "$new" >/dev/null 2>&1 || {
	ui_say 'Keyboard layout' "The compositor refused the layout $new" critical
	exit 1
}

# Per-user drop-in, included at the end of ~/.config/sway/config so it wins
# over the system configuration. No reload: the layout is already live, and a
# reload would re-run every `exec` in the session (a second mako, a second
# wlsunset).
mkdir -p "$HOME/.config/sway/config.d"
cat >"$HOME/.config/sway/config.d/90-keyboard-layout.conf" <<EOF
# Written by rofi-layout: the keyboard layout picked in the session.
# Delete this file to go back to whatever the system configuration sets.
input "type:keyboard" xkb_layout "$new"
EOF

ui_say 'Keyboard layout' "Now using $new"
