#!/bin/sh
# Calculator: type an expression, Enter copies the result.
#
# Deboma binds Super+Ctrl+Q to a calculator in its shell, where the result
# follows the keystrokes. rofi 2.0 cannot do that: a script mode is called once
# when it starts and again when an entry is chosen, never while the query
# changes (verified on this image with a script that logged its calls: one call,
# at startup). So this is the honest version: one prompt, Enter evaluates, the
# result goes to the clipboard and to a notification.
#
# awk does the arithmetic, so it costs no new package and no Python start-up.
# The input is filtered to digits, operators, parentheses, a dot and spaces
# before awk sees it; a letter, a quote or `system(...)` is refused instead of
# being run.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

expr=$("$dir/bar-pick" 'Calculate' -free) || exit 0
expr=$(printf '%s' "$expr" | sed -e 's/[[:space:]]*=[[:space:]]*$//' -e 's/^[[:space:]]*//')
[ -n "$expr" ] || exit 0

if [ -n "$(printf '%s' "$expr" | tr -d '0-9.+*/%^() -')" ]; then
	ui_say Calculator 'Only numbers and + - * / % ^ ( )'
	exit 1
fi

result=$(awk "BEGIN { printf \"%.10g\", $expr }" 2>/dev/null) || true
if [ -z "$result" ]; then
	ui_say Calculator "$expr is not an expression"
	exit 1
fi

printf '%s' "$result" | wl-copy 2>/dev/null || true
ui_say Calculator "$expr = $result · copied"
