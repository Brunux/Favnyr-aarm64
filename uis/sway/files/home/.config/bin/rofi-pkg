#!/bin/sh
# Packages: search the archive, install what is chosen, say how it went.
#
# Omarchy's `omarchy-pkg-install` is a pacman/AUR tree of curated choices; there
# is nothing to port line by line, because on Debian the same job is `apt`.  What
# is worth porting is the shape: type a word, get a list, pick one, and see it
# happen.  So this is one prompt (rofi's -free mode), `apt-cache search` over the
# package lists the image was built with, and a row per match.
#
# The install runs with -y and noninteractive dpkg options and reports through
# the `busy` card and the bar spinner: a download on this connection takes
# seconds to minutes, and a menu that vanishes while apt works in the background
# is how a person ends up running it twice.  The last line of apt's own output is
# what the card shows when it fails.
#
# Nothing here is a package manager of its own: `apt-get upgrade` stays a
# terminal command (the bar's updates indicator already opens that), and this
# menu never removes anything.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

if ! command -v apt-cache >/dev/null 2>&1; then
	ui_say Packages 'apt-cache is not installed' critical
	exit 1
fi

query=$("$UI_BIN/bar-pick" 'Packages' -free -mesg 'Search the package names and descriptions') || exit 0
query=$(printf '%s' "$query" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
[ -n "$query" ] || exit 0

tmp=$(mktemp -d "${TMPDIR:-/tmp}/pkg.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

apt-cache search -- "$query" >"$tmp/found" 2>/dev/null || : >"$tmp/found"
total=$(grep -c . "$tmp/found" 2>/dev/null || true)

if [ "${total:-0}" -eq 0 ]; then
	ui_say Packages "No package matches “$query”" \
		'The lists may be old: the last row of the menu runs apt-get update'
	exit 0
fi

# One snapshot of what is installed, so a row can say so before it is chosen.
dpkg-query -W -f='${db:Status-Abbrev}${Package}\n' 2>/dev/null |
	awk '$1 == "ii" { print $2 }' >"$tmp/installed" || : >"$tmp/installed"

{
	head -40 "$tmp/found" | while IFS= read -r line; do
		[ -n "$line" ] || continue
		case $line in
		*' - '*) pkg=${line%% - *} desc=${line#* - } ;;
		*) pkg=$line desc='' ;;
		esac
		desc=$(printf '%s' "$desc" | cut -c1-72)
		if grep -qxF "$pkg" "$tmp/installed"; then
			ui_row "$UI_I_BOX" "$pkg" "$desc · installed" "install:$pkg" "$UI_DIM"
		else
			ui_row "$UI_I_BOX" "$pkg" "$desc" "install:$pkg"
		fi
	done
	[ "${total:-0}" -gt 40 ] && ui_note "… and $((total - 40)) more matches" \
		'type a narrower word to see them'
	ui_heading 'lists'
	ui_row "$UI_I_UNDO" 'Update the package lists' 'apt-get update, then search again' update "$UI_DIM"
} >"$tmp/rows"

if [ "${total:-0}" -gt 40 ]; then
	mesg="40 of $total matches · Enter installs · Escape closes"
else
	mesg="$total matches · Enter installs · Escape closes"
fi
key=$(ui_pick "Packages · $query" "$mesg" <"$tmp/rows") || exit 0
[ -n "${key:-}" ] || exit 0

if [ "$(id -u)" -ne 0 ] && ! sudo -n true 2>/dev/null; then
	ui_say Packages 'Installing needs root and sudo asks for a password here' critical
	exit 1
fi

busy="$dir/busy"
log=$(mktemp "${TMPDIR:-/tmp}/pkg-apt.XXXXXX")
trap 'rm -rf "$tmp" "$log"' EXIT

apt_run() { # LABEL MESSAGE ARGS...
	_label=$1
	_message=$2
	shift 2
	"$busy" start pkg Packages "$_message" box 2>/dev/null || true
	if sudo -n env DEBIAN_FRONTEND=noninteractive apt-get "$@" \
		-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
		>"$log" 2>&1; then
		"$busy" end pkg Packages "$_label" 2>/dev/null || true
		return 0
	fi
	_err=$(grep -m1 -E '^(E|W): ' "$log" 2>/dev/null || true)
	[ -n "$_err" ] || _err=$(tail -2 "$log" 2>/dev/null | tr '\n' ' ')
	"$busy" fail pkg Packages "${_err:-apt-get failed}" 2>/dev/null || true
	return 1
}

case $key in
update)
	apt_run 'Package lists updated' 'Updating the package lists'
	;;
install:*)
	pkg=${key#install:}
	apt_run "Installed $pkg" "Installing $pkg" install -y "$pkg"
	;;
esac
