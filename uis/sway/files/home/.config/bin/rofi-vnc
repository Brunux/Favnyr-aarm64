#!/bin/sh
# Share this screen with another machine: wayvnc, read-only, on the loopback
# address.  The other half of ssh - a shell but not the picture.
#
#   rofi-vnc               the menu (Settings > Share this screen, and the root menu)
#   rofi-vnc start|stop    the two actions, for a terminal or a script
#   rofi-vnc status        one line for the Settings row: "off" or "localhost:5900 · read-only"
#   rofi-vnc status --bar  the waybar module (custom/vnc): JSON, nothing when off
#
# Three decisions hold this together, and each one is the reason for a line
# below rather than a preference.
#
#   * **Read-only.** `wayvnc -d/--disable-input` creates no virtual keyboard and
#     no virtual pointer, so a viewer looks and cannot type.  Remote input would
#     arrive in this session as an unattributable keyboard and pointer, and the
#     one thing "see what is on the screen" never needs is the ability to touch
#     it.
#
#   * **Loopback only.** wayvnc 0.10 authenticates only through
#     ~/.config/wayvnc/config (`enable_auth` wants a certificate, a private key
#     and a password; `enable_pam` would accept the login password).  This image
#     ships no such file, so a server on the network address would be an
#     unauthenticated desktop on every network the machine joins.  127.0.0.1 is
#     reached through the ssh login the image already answers, which makes the
#     tunnel the authentication - the part that is already configured, tested
#     and documented (05-system.md, "Remote login").
#
#   * **Nothing resident.** The server is started from here and stopped from
#     here; its pid and its log live in $XDG_RUNTIME_DIR/lazyos-vnc, so a
#     session that dies takes the state with it and no "on" survives a logout.
#     The bar's eye is a state file being read (waybar polls `status --bar` every
#     ten seconds), not a process.
#
# The pid is checked twice before it is trusted: `kill -0` says something is
# there, and `/proc/PID/comm` says it is wayvnc - a pid can be reused after a
# crash, and killing a stranger would be a worse bug than a stale file.

set -eu

dir=$(dirname "$0")

state=${XDG_RUNTIME_DIR:-/tmp}/lazyos-vnc
pid_file=$state/pid
log=$state/wayvnc.log
port=5900
host=$(hostname 2>/dev/null || echo lazyos)

# running: the pid file names a live wayvnc.  Never a guess about a stale file.
running() {
	[ -s "$pid_file" ] || return 1
	_pid=$(cat "$pid_file" 2>/dev/null || true)
	case ${_pid:-} in '' | *[!0-9]*) return 1 ;; esac
	kill -0 "$_pid" 2>/dev/null || return 1
	[ "$(cat "/proc/$_pid/comm" 2>/dev/null || true)" = wayvnc ]
}

# listening: the kernel says something is bound to the loopback port.  A wayvnc
# that started and then lost its socket is alive and not serving, and that
# difference is what the menu has to report.  Without `ss` (iproute2) there is
# nothing to ask, so the pid stands as the evidence instead of turning a missing
# tool into a false failure.
listening() {
	command -v ss >/dev/null 2>&1 || return 0
	_out=$(ss -ltnH "sport = :$port" 2>/dev/null || true)
	case $_out in
	*"127.0.0.1:$port"*) return 0 ;;
	esac
	return 1
}

sharing() { running && listening; }

tunnel() {
	printf 'ssh -L %s:127.0.0.1:%s %s@%s' "$port" "$port" "${USER:-brunux}" "$host"
}

# The bar re-runs the module on RTMIN+8 (waybar's "signal": 8), so the eye
# appears and disappears when it happens instead of on the next poll.
signal_bar() {
	pkill -RTMIN+8 waybar 2>/dev/null || true
}

start() {
	if running; then
		ui_say 'Share this screen' "Already sharing on localhost:$port"
		return 0
	fi
	if ! command -v wayvnc >/dev/null 2>&1; then
		ui_say 'Share this screen' 'wayvnc is not installed (package wayvnc)' \
			critical "$UI_ICON_ERROR"
		return 1
	fi
	mkdir -p "$state" || return 1
	# nohup, not setsid: `$!` has to be wayvnc's own pid, and `setsid` forks when
	# it is already a process-group leader (an interactive shell with job
	# control), which leaves the pid file naming a process that has exited while
	# the server runs on unowned.  nohup execs in place and ignores SIGHUP, so the
	# pid is right in both cases and a closed terminal cannot take the server
	# with it.  At logout the session's cgroup takes it, which is the intent.
	nohup wayvnc --disable-input 127.0.0.1 "$port" >"$log" 2>&1 &
	_pid=$!
	printf '%s\n' "$_pid" >"$pid_file"
	# wayvnc binds before it draws anything, so a second is generous; the two
	# read-backs below are what turn "we started it" into "it is serving".
	sleep 1
	if ! sharing; then
		_reason=$(tail -n 2 "$log" 2>/dev/null | tr '\n' ' ')
		kill "$_pid" 2>/dev/null || true
		rm -f "$pid_file"
		[ -n "${_reason:-}" ] || _reason='wayvnc exited without a message'
		ui_say 'Share this screen' "It did not start: $_reason" \
			critical "$UI_ICON_ERROR"
		return 1
	fi
	signal_bar
	ui_say 'Share this screen' \
		"Read-only on localhost:$port. From the other machine: $(tunnel)" \
		normal "$UI_ICON_SERVER"
}

stop() {
	if ! running; then
		rm -f "$pid_file"
		signal_bar
		ui_say 'Share this screen' 'Nothing is being shared'
		return 0
	fi
	_pid=$(cat "$pid_file")
	kill -TERM "$_pid" 2>/dev/null || true
	_n=0
	while kill -0 "$_pid" 2>/dev/null && [ "$_n" -lt 30 ]; do
		sleep 0.1
		_n=$((_n + 1))
	done
	if kill -0 "$_pid" 2>/dev/null; then
		kill -KILL "$_pid" 2>/dev/null || true
	fi
	rm -f "$pid_file"
	signal_bar
	ui_say 'Share this screen' 'Stopped. The viewer loses the picture.'
}

# The two status paths run ten seconds apart for the whole session, and they are
# the only reason this script has a fast path: lib-rofi.sh builds sixty glyph
# constants with $(printf …) when it is sourced, which a state read has no use
# for.  The one glyph they draw is the same codepoint lib-rofi.sh calls
# UI_I_EYE (Font Awesome f06e, the eye), written here for that reason alone.
status_bar() {
	const_eye=$(printf '\357\201\256')
	if sharing; then
		printf '{"text":"<span font_desc=%s>%s</span>","class":"on","tooltip":"sharing this screen read-only on localhost:%s\\nclick for the menu, right click to stop"}\n' \
			"'JetBrains Mono 13'" "$const_eye" "$port"
	else
		printf '{"text":"","class":"empty","tooltip":"share this screen"}\n'
	fi
}

case ${1:-menu} in
status)
	if [ "${2:-}" = --bar ]; then
		status_bar
	elif sharing; then
		printf 'localhost:%s · read-only\n' "$port"
	else
		printf 'off\n'
	fi
	exit 0
	;;
menu | start | stop) ;;
*)
	printf 'usage: rofi-vnc [menu|start|stop|status [--bar]]\n' >&2
	exit 2
	;;
esac

. "$dir/lib-rofi.sh"

case ${1:-menu} in
start)
	start
	exit $?
	;;
stop)
	stop
	exit 0
	;;
esac

tmp=$(mktemp "${TMPDIR:-/tmp}/vnc.XXXXXX")
trap 'rm -f "$tmp"' EXIT

while :; do
	# The list re-draws after every action, so what it says is always the state
	# that is true now - a started share must not leave "Share this screen"
	# sitting there, and a stopped one must not leave "Stop sharing" able to
	# answer "Nothing is being shared".
	{
		if sharing; then
			ui_heading 'sharing'
			ui_row "$UI_I_EYE" 'Sharing this screen' \
				"localhost:$port · read-only" none
			ui_row "$UI_I_STOP" 'Stop sharing' 'the viewer loses the picture' stop "$UI_RED"
		else
			# A wayvnc that is alive but not listening is a failure, not a
			# share: say which half is wrong instead of drawing a switch that is
			# neither on nor off.
			if running; then
				ui_row "$UI_I_WARN" 'Not serving' \
					"wayvnc is running but nothing listens on localhost:$port" stop "$UI_RED"
			fi
			ui_row "$UI_I_EYE" 'Share this screen' \
				"read-only · localhost:$port · watched from another machine" start
		fi
		ui_heading 'how to watch it'
		ui_row "$UI_I_LINK" 'Copy the tunnel command' "$(tunnel)" tunnel
		ui_row "$UI_I_INFO" 'What this does' \
			'a viewer looks; it cannot type, and only over ssh' info
	} >"$tmp"

	key=$(ui_pick 'Share this screen' 'Enter acts · Escape closes' <"$tmp") || exit 0

	case $key in
	# A row that only states something re-checks instead of closing, so Enter on
	# it is not a keypress that did nothing.
	none) continue ;;
	start) start || true ;;
	stop) stop ;;
	tunnel)
		ui_copy "$(tunnel)" \
			"Run it on the other machine, then open a VNC viewer on localhost:$port"
		;;
	info)
		ui_say 'Share this screen' \
			"wayvnc serves this session on 127.0.0.1:$port, read-only: the viewer sees the screen and cannot type. It is loopback only because wayvnc 0.10 needs a certificate and a password file to serve a network, which this image does not ship - the ssh login is what authenticates, and the tunnel row has the command. Nothing runs until it is started, and the bar keeps an eye while it is." \
			normal "$UI_ICON_SERVER"
		;;
	*) exit 0 ;;
	esac
done
