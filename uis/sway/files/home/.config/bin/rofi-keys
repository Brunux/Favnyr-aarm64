#!/bin/sh
# All of the session's key bindings, parsed from the configuration itself.
#
# The configuration files are the source of truth: this view cannot drift from
# them, and every binding added anywhere in /etc/sway or ~/.config/sway shows up
# on the next run. The comment above a binding becomes its description, and it
# applies to the bindings that follow it until a blank line or another comment,
# so a group header is written with a blank line after it and a description with
# the bindings right below it. Bindings inside a `mode` block say which mode.
#
# Enter copies the command to the clipboard, Escape closes. $mod is Alt here.
#
# Every row gets a picture: rofi's dmenu can draw one image per row by name
# (`-show-icons -icon-theme LazyOS`, the icon marker appended to the row), and this
# list is scanned rather than read, so the picture is the fastest thing on it.  A row
# without one is not merely text-only - rofi drops the icon column for that row and
# its text starts 34 px to the left of its neighbours, which is what a list with
# pictures only on its section lines looks like (the reported bug).  So a binding
# carries the picture of the tool it runs, of the action it sends, or of its section
# - the last of the three is the one every row is guaranteed, so no row can be left
# without a picture.  Every name is one scripts/make-icons.sh renders into the theme
# (they are the binaries of the second table and the nouns of the fourth); a name it
# does not ship draws nothing and logs nothing, which is why check-system.sh asks
# the theme for each and every name this file can emit.
#
# The icon marker lives *after* the row text and after a NUL (rofi's own format:
# text, NUL, "icon", US, name), and rofi hands back the text only up to that NUL.
# So the table keeps the plain text in its first column - the one the awk lookup
# compares - and the rows handed to rofi are built from the table with the marker
# appended.  Without that the lookup would compare the choice against a row that
# still carries a marker and find nothing, and Enter would copy nothing.
#
# The icon column costs about 34 px of the row, which is four description
# characters, so the window is 68% instead of 64%: the descriptions are as wide as
# they were before the pictures.  (Measured like the numbers in lib-rofi.sh: 11 px
# per bold column, 8 per small one, at the panel's 1280 px.)
set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

theme="$HOME/.config/rofi/solarized.rasi"
table=$(mktemp "${TMPDIR:-/tmp}/keys.XXXXXX")
trap 'rm -f "$table"' EXIT

files="/etc/sway/config $(printf '%s\n' /etc/sway/config.d/*.conf | sort | tr '\n' ' ') $HOME/.config/sway/config"

SWAY_FILES="$files" awk -v out="$table" '
function expand(s,    i, k) {
    for (i = 0; i < 4; i++) for (k in vars) gsub("\\$" k, vars[k], s)
    return s
}
function pretty(k) {
    gsub(/--release|--locked|--no-repeat|--no-warns|--to-code/, "", k)
    gsub(/^[ \t]+|[ \t]+$/, "", k)
    gsub(/\$mod/, "Alt", k)
    gsub(/Mod1/, "Alt", k)
    gsub(/Mod4|Super_L/, "Super", k)
    return k
}
function category(f) {
    if (f ~ /config\.d\/19-launcher/) return "Launcher"
    if (f ~ /config\.d\/24-keys/) return "Menu, panels and session"
    if (f ~ /config\.d\/21-lock-screen/) return "Lock and system"
    if (f ~ /config\.d\/20-brightness/) return "Brightness"
    if (f ~ /config\.d\/21-volume/) return "Volume"
    if (f ~ /config\.d\/2[23]-(sleep|screensaver)/) return "Lock and sleep"
    if (f ~ /config\.d\/22-workspace-gestures|config\.d\/90-touchpad/) return "Touchpad and gestures"
    if (f ~ /config\.d\/90-screenshot/) return "Screenshots"
    if (f ~ /config\.d\/90-solarized/) return "Theme"
    if (f ~ /config\.d\/26-swayfx/) return "Effects"
    if (f ~ /config\.d\/(20-waybar|01-status-bar|25-bar-panels)/) return "Bar"
    if (f ~ /config\.d\/00-logo-key/) return "Keyboard"
    if (f ~ /config\.d\//) return "Session"
    return "Windows and workspaces"
}
# One icon name per category, from the theme scripts/make-icons.sh builds.  The
# names are nouns of the icon set already used by the launcher, so a key section
# and its .desktop entry are drawn with the same picture.
function icon(c) {
    if (c == "Launcher") return "rofi"
    if (c == "Menu, panels and session") return "preferences-system"
    if (c == "Lock and system") return "system-lock-screen"
    if (c == "Brightness") return "display-brightness"
    if (c == "Volume") return "audio-speakers"
    if (c == "Lock and sleep") return "system-suspend"
    if (c == "Touchpad and gestures") return "input-touchpad"
    if (c == "Screenshots") return "applets-screenshooter"
    if (c == "Theme") return "preferences-desktop-theme"
    if (c == "Effects") return "preferences-desktop-effects"
    if (c == "Bar") return "utilities-system-monitor"
    if (c == "Keyboard") return "preferences-desktop-keyboard"
    if (c == "Session") return "utilities-terminal"
    return "preferences-system-windows"
}
# The picture a binding itself earns: the one the theme carries for the tool it
# runs, or for what it does.  A binding is a shell command, so the tool is the
# first word of it that names one - after a directory path has been taken off
# (`~/.config/bin/rofi-power` is `rofi-power`) - and the rest is the sway verb it
# sends: the arrow of a focus or move binding, the cross of a kill, the refresh of
# a reload, the door of an exit.  What neither answers keeps the picture of its
# section, which is the association the row already has; nothing here can leave a
# row without one.
function row_icon(cmd, c,    m, i, t, a) {
    m = split(cmd, tok, /[^A-Za-z0-9._+-]+/)
    for (i = 1; i <= m; i++) {
        t = tok[i]
        sub(/^.*\//, "", t)
        if (t in tools) return t
    }
    a = cmd
    sub(/^exec[ \t]+/, "", a)
    if (a ~ /(^|[^A-Za-z0-9_-])kill([^A-Za-z0-9_-]|$)/) return "window-close"
    if (a ~ /(^|[^A-Za-z0-9_-])reload([^A-Za-z0-9_-]|$)/) return "view-refresh"
    if (a ~ /(^|[^A-Za-z0-9_-])exit([^A-Za-z0-9_-]|$)/) return "application-exit"
    if (a ~ /(^|[ \t])(focus|move)[ \t]+left([ \t]|$)/) return "go-previous"
    if (a ~ /(^|[ \t])(focus|move)[ \t]+right([ \t]|$)/) return "go-next"
    if (a ~ /(^|[ \t])(focus|move)[ \t]+up([ \t]|$)/) return "go-up"
    if (a ~ /(^|[ \t])(focus|move)[ \t]+down([ \t]|$)/) return "go-down"
    return icon(c)
}
BEGIN {
    # The tools this session ships, under the names scripts/make-icons.sh renders
    # them (second table: the binary names the command palette asks for).  A name left
    # out of this list is simply not claimed - that binding keeps the picture of its
    # section - so a tool added tomorrow is a missing picture at worst, never a wrong
    # one.
    m = split("bar-audio bar-bt bar-busy bar-key bar-menu bar-net bar-pick bar-power bar-updates busy dictate dictate-model lazyos-screensaver rofi-about rofi-agents rofi-calc rofi-capture rofi-clean rofi-clip rofi-color rofi-dns rofi-emoji rofi-files rofi-keys rofi-kill rofi-learn rofi-media rofi-notify rofi-pkg rofi-places rofi-power rofi-qr rofi-quick rofi-remind rofi-tz sway-hibernate sway-lock sway-suspend", tl, " ")
    for (i = 1; i <= m; i++) tools[tl[i]] = 1
    n = split(ENVIRON["SWAY_FILES"], files, " ")
    for (i = 1; i <= n; i++) {              # pass 1: set $var value
        while ((getline line < files[i]) > 0) {
            if (line !~ /^[ \t]*set[ \t]+\$/) continue
            sub(/^[ \t]*set[ \t]+\$/, "", line)
            split(line, kv, /[ \t]+/)
            val = line
            sub(/^[^ \t]+[ \t]+/, "", val)
            gsub(/["'"'"']/, "", val)
            vars[kv[1]] = val
        }
        close(files[i])
    }
    for (i = 1; i <= n; i++) {              # pass 2: the bindings
        comment = ""; cat = ""; mode = ""
        while ((getline line < files[i]) > 0) {
            if (line ~ /^[ \t]*#/) { sub(/^[ \t]*#[ \t]?/, "", line); comment = line; continue }
            if (line ~ /^[ \t]*$/) { comment = ""; continue }
            if (line ~ /^[ \t]*mode[ \t]+"/) {
                mode = line
                sub(/^[ \t]*mode[ \t]+"/, "", mode)
                sub(/".*$/, "", mode)
                continue
            }
            if (line ~ /^[ \t]*}[ \t]*$/) { mode = ""; continue }
            if (line !~ /^[ \t]*(bindsym|bindcode|bindswitch|bindgesture)[ \t]/) continue
            rest = line
            sub(/^[ \t]*[a-z]+[ \t]+/, "", rest)
            while (rest ~ /^--/) sub(/^--[a-z-]+[ \t]+/, "", rest)
            keys = rest
            sub(/[ \t].*$/, "", keys)
            cmd = rest
            sub(/^[^ \t]+[ \t]*/, "", cmd)
            if (cmd == "") continue
            keys = pretty(expand(keys))
            cmd = expand(cmd)
            shown = cmd
            sub(/^exec /, "", shown)
            c = category(files[i])
            if (c != cat) {
                printf "<span weight=\"bold\" foreground=\"#2aa198\">%s</span>\t\t%s\n", c, icon(c) >> out
                cat = c
            }
            desc = expand(comment != "" ? comment : shown)
            if (mode != "") desc = mode ": " desc
            gsub(/&/, "\\&amp;", desc); gsub(/</, "\\&lt;", desc); gsub(/>/, "\\&gt;", desc)
            # 17 columns: the longest binding on this keyboard is 16 characters
            # (Alt+Shift+Return), and the icon column takes about four of them off
            # the right edge.  Field two is the command Enter copies and field three
            # is the picture; the row builder below appends the marker from that
            # third field, so a row and its picture cannot get out of step.
            printf "<span weight=\"bold\">%-17s</span> <span size=\"small\" foreground=\"#586e75\">%s</span>\t%s\t%s\n", keys, desc, cmd, row_icon(cmd, c) >> out
        }
        close(files[i])
    }
}'

# The rows rofi draws: the text of the table, then the icon marker when the row
# has one.  printf gets the text as an argument and never as the format string,
# since a binding can contain a % (printf(1), the shell's own %s) and would
# otherwise be read as a conversion.
#
# awk feeds rofi through the pipe and the rows are never captured in a variable:
# a POSIX shell drops NUL bytes from $(...), so `rows=$(awk ...)` would deliver
# every row *without* its marker - the list would look right and draw no icons at
# all, which is the kind of bug this port has hit before with a glyph that did not
# survive its transport.
[ -s "$table" ] || exit 0

choice=$(awk -F'\t' '
    NF == 0 { next }
    $3 == "" { print $1; next }
    { printf "%s%s\n", $1, sprintf("%cicon%c%s", 0, 31, $3) }' "$table" |
	rofi -dmenu -markup-rows -theme "$theme" \
		-show-icons -icon-theme LazyOS \
		-p "Keys" -lines 22 -i \
		-theme-str "window { width: 68%; }
mainbox { children: [ inputbar, message, listview ]; }" \
		-mesg "Enter copies the command · Escape closes · Alt is the modifier") || exit 0

[ -n "$choice" ] || exit 0
cmd=$(awk -F'\t' -v d="$choice" '$1 == d { print $2; exit }' "$table")
[ -n "$cmd" ] || exit 0
printf '%s' "$cmd" | wl-copy
# The whole command, not the part the row had room for: a binding can be long
# (a shell pipeline with quotes in it) and this is where it is readable.
ui_say Copied "$cmd" normal "$UI_ICON_KEYS"
