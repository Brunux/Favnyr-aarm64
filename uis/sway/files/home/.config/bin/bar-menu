#!/bin/sh
# The bar's left-most button: applications and the session in one menu.
#
# Deboma's menu plugin lists the applications and the session actions in a
# Quickshell window.  This is the cheap equivalent: rofi over a fixed list,
# one process per click.  `Terminal` is also on the right-click so the common
# case needs no menu at all (see waybar `custom/menu`).
#
# Wi-Fi, Bluetooth and the audio output are entries here as well as on their
# own indicators: the power-menu habit ("everything is one menu") survives.

set -eu

dir=$(dirname "$0")

choice=$(
	printf '%s\n' \
		Terminal \
		Agents \
		Learn \
		Keybindings \
		'Wi-Fi' \
		Bluetooth \
		'Audio output' \
		Dictation \
		Lock \
		Screensaver \
		Suspend \
		Hibernate \
		'Log out' \
		Reboot \
		'Power off' |
		"$dir/bar-pick" Menu
) || exit 0

case $choice in
	'') exit 0 ;;
	Terminal) exec foot ;;
	# The manual, the key view and the agent launcher: the same scripts the
	# launcher entries call.
	Agents) exec "$dir/rofi-agents" ;;
	Learn) exec "$dir/rofi-learn" ;;
	Keybindings) exec "$dir/rofi-keys" ;;
	'Wi-Fi') exec "$dir/bar-net" ;;
	Bluetooth) exec "$dir/bar-bt" ;;
	'Audio output') exec "$dir/bar-audio" ;;
	# Same commands as the key bindings in etc/sway/config.d, so the locked
	# screen and the suspend path behave identically from the bar.
	Lock) exec swaylock -c 002b36 ;;
	# Deboma's menu has the same entry; it is the idle screen on demand.
	Screensaver) exec "$dir/sway-screensaver" ;;
	# Both of these explain themselves when they cannot run (no microphone, no
	# disk swap with resume=), so the menu can list them unconditionally.
	Dictation) exec "$dir/dictate" ;;
	Hibernate) exec "$dir/sway-hibernate" ;;
	Suspend) exec "$dir/sway-suspend" ;;
	'Log out') exec swaymsg exit ;;
	Reboot) exec systemctl reboot ;;
	'Power off') exec systemctl poweroff ;;
esac
