#!/bin/sh
# Kill a process: the twenty heaviest, with what they cost.
#
# Deboma's "system" menu has this; btop has it too, but finding the culprit
# there means reading a full-screen table.  One rofi list, sorted by resident
# memory, is the two-second version, and it is what answers "what is eating the
# 4 GB".
#
# The list never offers PID 1 or this script's own process, and a process that
# ignores the polite signal is offered a forced one instead of being retried
# silently.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"


tmp=$(mktemp -d "${TMPDIR:-/tmp}/kill.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

# pid, resident KB, name.  comm is truncated to 15 chars by the kernel, which is
# what shows on the bar's tooltips too; the full name is not worth a second call.
ps -eo pid=,rss=,comm= --sort=-rss 2>/dev/null |
	awk -v self="$$" '$1 != 1 && $1 != self && $2 + 0 > 0 { printf "%s\t%s\t%s\n", $1, $2, $3 }' |
	head -n 20 >"$tmp/ps"

while IFS=$(printf '\t') read -r pid rss comm; do
	[ -n "$pid" ] || continue
	ui_row "$UI_I_BUG" "$comm" "$(awk -v k="$rss" 'BEGIN { printf "%.0f MB", k / 1024 }') · pid $pid" "pid:$pid"
done <"$tmp/ps" >"$tmp/rows"

key=$(ui_pick 'End a process' 'Enter sends SIGTERM · Escape closes' <"$tmp/rows") || exit 0
case $key in
pid:*) ;;
*) exit 0 ;;
esac

pid=${key#pid:}
name=$(awk -F'\t' -v p="$pid" '$1 == p { print $3; exit }' "$tmp/ps")
name=${name:-process}

kill -TERM "$pid" 2>/dev/null || {
	ui_say 'End a process' "Cannot signal $name ($pid): it is not yours or it is gone" critical
	exit 1
}

sleep 1
if kill -0 "$pid" 2>/dev/null; then
	printf '%s\n' 'Force it (SIGKILL)' 'Leave it alone' >"$tmp/again"
	again=$(ui_pick "Still running: $name" "SIGKILL cannot be ignored, and the process loses its unsaved data" <"$tmp/again") || exit 0
	case $again in
	'Force it (SIGKILL)')
		kill -KILL "$pid" 2>/dev/null || true
		ui_say 'End a process' "$name ($pid) killed"
		;;
	esac
else
	ui_say 'End a process' "$name ($pid) ended"
fi
