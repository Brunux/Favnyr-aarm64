#!/bin/sh
# Wi-Fi picker behind the bar's network indicator.
#
# Deboma's network plugin lists the access points in a Quickshell popup and
# connects to the one that is clicked.  This reproduces that behaviour with
# nmcli + rofi: everything runs for as long as the popup is open, and nothing
# stays behind.  Left click on the indicator opens this list; right click opens
# nmtui in a floating terminal (etc/sway/config.d/25-bar-panels.conf), which is
# the full editor for saved connections.
#
# The list is what `nmcli device wifi list --rescan yes` returns, strongest
# first, the active network marked with `*`.  Networks in range are shown with
# their security and signal; picking a known one activates the saved profile,
# picking a new secured one asks for the password in a masked rofi prompt.

set -eu

dir=$(dirname "$0")
tab=$(printf '\t')

# One error channel: the same mako card the progress toast used, left behind as
# a critical notification. A scan or a connection attempt takes long enough that
# a click with no visible answer reads as a broken menu, which is what busy
# answers (see busy and bar-busy).
#
# The error icon is named here rather than left to the task's own: the card
# morphs from "Looking for networks…" (network-wireless) into the failure, and
# the glyph changing is what makes it read as a different kind of message at a
# glance.  dialog-error falls back to Adwaita if the LazyOS theme has no match.
fail() { "$dir/busy" fail wifi "$*" dialog-error; }

if [ "$(nmcli radio wifi 2>/dev/null)" != "enabled" ]; then
	choice=$(printf '%s\n' 'Turn Wi-Fi on' | "$dir/bar-pick" 'Wi-Fi is off') || exit 0
	if [ "$choice" = 'Turn Wi-Fi on' ]; then
		# No stop command here, and the card stays so that the answer is on
		# screen: `nmcli radio wifi on` is a D-Bus property set that returns at
		# once, and a button for something already over is worse than none.
		# Clicking the card says it cannot be stopped, which is true.
		"$dir/busy" start wifi Wi-Fi 'Turning the radio on…' network-wireless
		if nmcli radio wifi on >/dev/null 2>&1; then
			"$dir/busy" end wifi 'Wi-Fi on'
		else
			fail 'Wi-Fi: could not turn the radio on'
		fi
	fi
	exit 0
fi

# IN-USE,SSID,SECURITY,SIGNAL, one line per access point.  nmcli escapes a
# literal ':' in an SSID as '\:', which still splits into its own field; the
# loop below joins those fields back into the name.  Duplicate SSIDs (mesh and
# multi-band) collapse to the strongest one, active networks sort first.
# The rescan is the first thing here that can take a couple of seconds; the
# toast says so, and the list replaces it as soon as it is ready.
#
# It is also worth a stop button: a scan in a noisy place (a conference, a
# building with forty access points) takes long enough that the menu looks
# stuck.  Killing the client cancels nothing on the radio - the scan belongs to
# NetworkManager, which finishes or drops it on its own - so there is no half
# state to leave behind, and the card disappearing is the whole outcome.  The
# pattern is bracketed (`[n]mcli`) because the `sh -c` line that runs it carries
# the pattern too, and a pkill that matches its own command line kills the shell
# that is running it.
BUSY_STOP='pkill -f "[n]mcli.*device wifi list"' \
	"$dir/busy" start wifi Wi-Fi 'Looking for networks…' network-wireless
scan=$(
	nmcli --terse --fields IN-USE,SSID,SECURITY,SIGNAL \
		device wifi list --rescan yes 2>/dev/null |
		awk -F: '
			{
				n = NF
				if (n < 4) next
				act = ($1 == "*") ? 0 : 1
				sig = $n + 0
				sec = $(n - 1)
				ssid = $2
				for (i = 3; i <= n - 2; i++) ssid = ssid ":" $i
				gsub(/\\:/, ":", ssid)
				if (ssid == "") next
				if (!(ssid in best) || sig > best[ssid]) {
					best[ssid] = sig
					secs[ssid] = sec
					acts[ssid] = act
				}
			}
			END {
				for (s in best) printf "%d\t%04d\t%d\t%s\t%s\n", acts[s], 999 - best[s], best[s], s, secs[s]
			}' |
		sort -t "$tab" -k1,1n -k2,2n |
		cut -f1,3-
)

# A killed scan leaves awk, sort and cut with whatever arrived first, and
# without pipefail in sh that pipeline still exits 0: this is the one place
# where "the user stopped it" and "three networks are in range" look the same,
# so the card is asked rather than the exit status.  A menu drawn from half a
# scan is how someone concludes that their network is not there.
if "$dir/busy" cancelled wifi; then
	exit 0
fi

# act, signal, ssid, security -> the line the menu shows.  The `*`/`  ` prefix
# and the two spaces around the middle dot are the contract with the parsing
# below; an SSID containing "  ·  " is the one thing that would confuse it.
menu=$(
	printf '%s\n' "$scan" |
		awk -F"$tab" 'NF >= 4 {
			printf "%s%s  ·  %s%%  ·  %s\n", ($1 == 0 ? "* " : "  "), $3, $2, ($4 == "" || $4 == "--" ? "open" : $4)
		}'
)
[ -n "$menu" ] || menu='No networks in range'

"$dir/busy" stop wifi
choice=$(
	printf '%s\n' "$menu" 'Turn Wi-Fi off' 'Show the password as a QR' 'Network settings (nmtui)' |
		"$dir/bar-pick" 'Wi-Fi'
) || exit 0

case $choice in
	'') exit 0 ;;
	'No networks in range') exit 0 ;;
	'Turn Wi-Fi off')
		# A property set like turning it on: nothing to stop, no stop file.
		"$dir/busy" start wifi Wi-Fi 'Turning the radio off…' network-wireless
		if nmcli radio wifi off >/dev/null 2>&1; then
			"$dir/busy" end wifi 'Wi-Fi off'
		else
			fail 'Wi-Fi: could not turn the radio off'
		fi
		exit 0
		;;
	'Network settings (nmtui)') exec foot --app-id=popup nmtui ;;
	'Show the password as a QR') exec "$dir/rofi-qr" --wifi ;;
esac

ssid=${choice#??}
ssid=${ssid%%  ·*}
[ -n "$ssid" ] || exit 0

sec=$(
	printf '%s\n' "$scan" |
		awk -F"$tab" -v want="$ssid" '$3 == want { print $4; exit }'
)

# Joining takes seconds (DHCP, the handshake), which is the longest wait in this
# script; the toast stays until the outcome is known and then becomes it.
#
# It is the other stoppable step here, and what the click means has to be said
# exactly: the kill ends *our* wait, not the activation.  NetworkManager owns the
# activation and carries it to the end or drops it on its own timers, and
# bringing the same profile up twice is idempotent, so nothing is left half
# configured and there is no lock to clean.  That is why the result reads
# "Stopped Wi-Fi" and not "cancelled": the link may well come up a second after
# the click, and a card claiming the join was aborted would be the wrong lie.
# Cancelling a join for real is `nmcli device disconnect`, which would also drop
# whatever the radio was carrying before this attempt - a bigger action than the
# card offers.  Both patterns are bracketed so they cannot match the `sh -c`
# line that runs them.
connect_stop='pkill -f "[n]mcli.*device wifi connect"; pkill -f "[n]mcli.*connection up id"'
BUSY_STOP=$connect_stop "$dir/busy" start wifi Wi-Fi "Connecting to $ssid…" network-wireless

if nmcli --terse --fields NAME connection show 2>/dev/null | grep -Fxq -- "$ssid"; then
	if ! out=$(nmcli device wifi connect "$ssid" 2>&1); then
		"$dir/busy" cancelled wifi && exit 0
		# The saved profile is the fallback and it is a second client, so it gets
		# its own check: a stop during the first attempt must not leave this one
		# waiting for the daemon's full timeout with no card on the bar.
		if ! out=$(nmcli connection up id "$ssid" 2>&1); then
			"$dir/busy" cancelled wifi && exit 0
			fail "Wi-Fi: $out"
			exit 0
		fi
	fi
else
	pw=
	if [ -n "$sec" ] && [ "$sec" != "--" ]; then
		"$dir/busy" stop wifi
		pw=$("$dir/bar-pick" "Password for $ssid" -password) || exit 0
		[ -n "$pw" ] || exit 0
		BUSY_STOP=$connect_stop "$dir/busy" start wifi Wi-Fi "Connecting to $ssid…" network-wireless
		if ! out=$(nmcli device wifi connect "$ssid" password "$pw" 2>&1); then
			"$dir/busy" cancelled wifi && exit 0
			fail "Wi-Fi: $out"
			exit 0
		fi
	else
		if ! out=$(nmcli device wifi connect "$ssid" 2>&1); then
			"$dir/busy" cancelled wifi && exit 0
			fail "Wi-Fi: $out"
			exit 0
		fi
	fi
fi

# A join that was stopped is not a failure to report: the card is already gone
# and the click was the answer.  Without this the empty `$out` of a killed nmcli
# becomes "Wi-Fi: " in a critical toast.
if "$dir/busy" cancelled wifi; then
	exit 0
fi

"$dir/busy" end wifi "Connected to $ssid"
