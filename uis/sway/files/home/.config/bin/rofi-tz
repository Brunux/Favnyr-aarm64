#!/bin/sh
# Time zone: every zone tzdata knows, with the current one marked.
#
# Deboma sets this from its settings panel; timedatectl does the work here.  The
# list is `timedatectl list-timezones` - 400-odd rows that rofi filters as fast
# as anything else - and the network-time switch is the row at the end, because a
# clock that is wrong and a clock that does not sync are the same problem
# (systemd-timesyncd is in packages/base.list for that).
#
# sudo is passwordless on this image, hence -n: if it ever is not, the failure is
# a notification instead of a password prompt with nowhere to appear.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"


current=$(timedatectl show -p Timezone --value 2>/dev/null || true)
ntp=$(timedatectl show -p NTP --value 2>/dev/null || true)

tmp=$(mktemp -d "${TMPDIR:-/tmp}/tz.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

timedatectl list-timezones 2>/dev/null >"$tmp/zones" || : >"$tmp/zones"

{
	while IFS= read -r zone; do
		[ -n "$zone" ] || continue
		if [ "$zone" = "$current" ]; then
			ui_row "$UI_ON" "$zone" 'current' "set:$zone"
		else
			ui_row "$UI_OFF" "$zone" '' "set:$zone"
		fi
	done <"$tmp/zones"

	if [ "$ntp" = yes ]; then
		ui_row "$UI_ON" 'Set the clock from the network' 'on' ntp:on
	else
		ui_row "$UI_OFF" 'Set the clock from the network' 'off' ntp:off
	fi
} >"$tmp/rows"

key=$(ui_pick 'Time zone' "Current: ${current:-unknown}" <"$tmp/rows") || exit 0

case $key in
set:*)
	zone=${key#set:}
	if sudo -n timedatectl set-timezone "$zone" 2>/dev/null; then
		# timedatectl rewrites /etc/localtime, and that is all it does for a
		# running session: glibc caches the zone the first time localtime() is
		# called in a process, so the bar's clock kept showing the old time and
		# the menu looked like it had done nothing.  Restart the bar (it is the
		# one long-lived process in the session that displays the time), and put
		# the new local time in the notification so the change is visible even
		# before the bar is back.
		if pgrep -x waybar >/dev/null 2>&1; then
			pkill -x waybar 2>/dev/null || true
			setsid waybar >/dev/null 2>&1 &
		fi
		ui_say 'Time zone' "Now $zone · $(TZ="$zone" date '+%H:%M')"
	else
		ui_say 'Time zone' "Could not set $zone (timedatectl needs root)" critical
	fi
	;;
ntp:on | ntp:off)
	if [ "$ntp" = yes ]; then
		want=false
	else
		want=true
	fi
	if sudo -n timedatectl set-ntp "$want" 2>/dev/null; then
		ui_say 'Time zone' "Network time ${want}"
	else
		ui_say 'Time zone' 'Could not change network time' critical
	fi
	;;
esac
