#!/bin/sh
# QR codes: the Wi-Fi network this machine is on, or any text.
#
# Deboma has `omarchy.wifiqr` (a QML grid of the current SSID, its password and
# a QR code) and a share menu with "text to QR".  Both are the same two commands
# here: nmcli reads the password out of the saved profile, qrencode draws the
# code with block characters, and foot shows it - no image viewer, no file on
# disk after the window closes.
#
# The payload is the Wi-Fi QR format phones understand:
#
#     WIFI:T:WPA;S:<ssid>;P:<password>;;
#
# with `\`, `;`, `,` and `:` escaped, which is what the ZXing reader expects for
# a name or a password that contains one.  What it exposes is the password, so
# the profile is read with `nmcli -s` through sudo and the temporary file is
# created 0600 and removed when the window closes.
#
# Usage: rofi-qr [--wifi|--text]

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

# The ZXing escaping: a backslash first, then the three separators.
qr_escape() {
	printf '%s' "${1:-}" | sed -e 's/\\/\\\\/g' -e 's/;/\\;/g' -e 's/,/\\,/g' -e 's/:/\\:/g'
}

show() { # PAYLOAD [TITLE]
	[ -n "${1:-}" ] || return 1
	umask 077
	_tmp=$(mktemp "${TMPDIR:-/tmp}/qr.XXXXXX") || return 1
	printf '%s' "$1" >"$_tmp"
	# qrencode with no output file prints the ANSI/UTF-8 rendering to stdout;
	# `-r` makes it read the payload from the file instead of argv, so the
	# password never appears in a process list.
	foot --app-id=popup -T "${2:-QR code}" -e sh -c '
		qrencode -t ANSIUTF8 -r "$1" || printf "qrencode could not draw that\n"
		printf "\nEnter closes\n"
		IFS= read -r _ || true' sh "$_tmp" || true
	rm -f "$_tmp"
}

# The active Wi-Fi device and its connection, by device name: a connection name
# may contain a colon and `nmcli -t` escapes it, a device name cannot.
wifi_connection() {
	_dev=$(nmcli -t -f DEVICE,TYPE device status 2>/dev/null |
		awk -F: '$2 == "wifi" { print $1; exit }') || true
	[ -n "${_dev:-}" ] || return 1
	_con=$(nmcli -g GENERAL.CONNECTION device show "$_dev" 2>/dev/null | head -1) || true
	# nmcli prints `--` for a device with no active connection.
	case ${_con:-} in '' | --) return 1 ;; esac
	printf '%s\n' "$_con"
}

wifi_payload() { # CONNECTION
	_ssid=$(nmcli -g 802-11-wireless.ssid connection show "$1" 2>/dev/null) || true
	[ -n "${_ssid:-}" ] || return 1
	# The password is a secret: nmcli only prints it with -s, which polkit
	# allows for root. sudo -n is passwordless on this image; if it ever is not,
	# the failure is a notification rather than a prompt with nowhere to appear.
	_psk=$(sudo -n nmcli -s -g 802-11-wireless-security.psk connection show "$1" 2>/dev/null) || true
	if [ -z "${_psk:-}" ]; then
		printf 'WIFI:T:nopass;S:%s;;' "$(qr_escape "$_ssid")"
	else
		printf 'WIFI:T:WPA;S:%s;P:%s;;' "$(qr_escape "$_ssid")" "$(qr_escape "$_psk")"
	fi
}

wifi_qr() {
	_con=$(wifi_connection) || {
		ui_say 'Wi-Fi QR' 'This machine is not connected to a Wi-Fi network' critical
		return 1
	}
	_payload=$(wifi_payload "$_con") || {
		ui_say 'Wi-Fi QR' "The saved profile $_con has no SSID" critical
		return 1
	}
	show "$_payload" "Wi-Fi · $_con"
}

text_qr() {
	_text=$("$dir/bar-pick" 'Text for the QR code' -free) || return 0
	[ -n "$_text" ] || return 0
	show "$_text" 'QR code'
}

case ${1:-} in
--wifi) wifi_qr && exit 0 || exit 1 ;;
--text) text_qr && exit 0 || exit 1 ;;
esac

# --- the list --------------------------------------------------------------

_con=$(wifi_connection) || _con=
if [ -n "$_con" ]; then
	_detail=$_con
	_colour=$UI_CYAN
else
	_detail='not connected'
	_colour=$UI_DIM
fi

tmp=$(mktemp "${TMPDIR:-/tmp}/qr-menu.XXXXXX")
trap 'rm -f "$tmp"' EXIT

{
	ui_row "$UI_I_WIFI" 'Wi-Fi network' "$_detail" wifi "$_colour"
	ui_row "$UI_I_QR" 'Any text' 'type it, and it becomes a code' text
} >"$tmp"

key=$(ui_pick 'QR code' 'Enter shows the code · Escape closes' <"$tmp") || exit 0
case $key in
wifi) wifi_qr ;;
text) text_qr ;;
esac
