#!/bin/sh
# Emoji: type a name, and the glyph is inserted at the cursor.
#
# Deboma's emoji panel is a QML grid; this is the same idea as one rofi list over
# the table `scripts/make-emojis.sh` generates from the Unicode database
# (~1300 rows: name, glyph, block, filtered to what the emoji font draws).  Typing
# narrows it - rofi matches the whole row, so "grin", "faces" or "cat" all work -
# and the first column is the glyph itself, so a category can also be browsed by
# scrolling.
#
# Insertion is Omarchy's trick, not wtype's: the glyph goes to the clipboard and
# a virtual Shift+Insert is typed, which every toolkit here (GTK, Qt, foot,
# Firefox) understands as "paste".  wtype -t would have to find a keysym for the
# codepoint, and most emoji have none in the current keymap.  Alt+1 is the same
# clipboard write without the keystroke, for a surface that refuses a virtual
# keyboard.
#
# Nothing stays: the list is rofi, the table is a file, and the clipboard is the
# compositor's.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

data="${XDG_CONFIG_HOME:-$HOME/.config}/emojis.tsv"
if [ ! -r "$data" ]; then
	ui_say Emoji "the emoji table is missing: $data" critical "$UI_ICON_ERROR"
	exit 1
fi

tmp=$(mktemp "${TMPDIR:-/tmp}/emoji.XXXXXX")
trap 'rm -f "$tmp"' EXIT

# One awk pass instead of a ui_row per line: 1300 rows through ui_row would be
# 2600 forks (sed and tr per row) and the menu would open a second late.  The
# columns are ui_row's - glyph, bold name, dim small detail - spelled out here for
# that reason; the block name is a detail like any other, so it is the smaller
# size too.
awk -F'\t' -v cyan="$UI_CYAN" -v strong="$UI_STRONG" -v dim="$UI_DIM" '
	/^#/ || NF < 3 { next }
	{
		printf "<span foreground=\"%s\">%s</span>   <span weight=\"bold\" foreground=\"%s\">%s</span>   <span size=\"small\" foreground=\"%s\">%s</span>\t%s\n",
			cyan, $2, strong, $1, dim, $3, $2
	}' "$data" >"$tmp"

key=$(ui_pick_alt 'Emoji' 'Enter inserts at the cursor · Alt+1 copies only · Escape closes' \
	'Alt+1 copy' <"$tmp") || exit 0
[ -n "$key" ] || exit 0

glyph=${key#alt:}

if ! printf '%s' "$glyph" | wl-copy 2>/dev/null; then
	ui_say Emoji 'wl-copy is not available, so nothing was inserted' critical "$UI_ICON_ERROR"
	exit 1
fi

case $key in
alt:*)
	ui_say Emoji "$glyph copied to the clipboard" normal "$UI_ICON_EMOJI"
	;;
*)
	if command -v wtype >/dev/null 2>&1 &&
		wtype -M shift -k Insert -m shift 2>/dev/null; then
		:
	else
		# The glyph is already on the clipboard, so this is a hint, not a failure.
		ui_say Emoji "$glyph copied · this window takes no virtual keyboard, paste it yourself" \
			normal "$UI_ICON_EMOJI"
	fi
	;;
esac
