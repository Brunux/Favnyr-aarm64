#!/bin/sh
# Colour: the hex of any pixel, and the session's own palette to copy.
#
# Omarchy binds `hyprpicker`, a Hyprland screencopy tool.  There is no such
# binary for wlroots here and none is needed: `slurp -p` picks a point, `grim`
# copies one pixel of it, and ffmpeg - already in the image for yt-dlp - turns
# that 1x1 PNG into three bytes.  No ImageMagick, no Python, no extra package.
#
# The second half of the list is the palette itself: the sixteen solarized
# colours every one of these menus is drawn with, each row a swatch painted in
# that colour, and Enter copies its hex.  That is the answer to "what is this
# base02" while editing a theme, and it costs nothing to have it here.
#
# The pixel is read from the screen, so it works over any application, but
# not over a fullscreen surface the compositor will not capture (the same
# limitation as the screenshot keys).

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

# swatch HEX: two blocks in that colour over a mid grey, so near-black (base03)
# and near-white (base3) both read as a colour instead of as a hole in the row.
# ui_row prints its glyph without escaping, which is what lets a span through.
swatch() {
	printf '<span foreground="%s" background="#93a1a1">██</span>' "$1"
}

tmp=$(mktemp "${TMPDIR:-/tmp}/color.XXXXXX")
trap 'rm -f "$tmp"' EXIT

{
	ui_row "$UI_I_BRUSH" 'Pick a pixel' 'the colour under the pointer, to the clipboard' pick
	ui_heading 'solarized'
	while read -r name hex; do
		[ -n "$name" ] || continue
		ui_row "$(swatch "$hex")" "$name" "$hex" "hex:$hex"
	done <<'PALETTE'
base03 #002b36
base02 #073642
base01 #586e75
base00 #657b83
base0 #839496
base1 #93a1a1
base2 #eee8d5
base3 #fdf6e3
yellow #b58900
orange #cb4b16
red #dc322f
magenta #d33682
violet #6c71c4
blue #268bd2
cyan #2aa198
green #859900
PALETTE
} >"$tmp"

key=$(ui_pick 'Colour' 'Enter copies the hex · Escape closes' <"$tmp") || exit 0
[ -n "${key:-}" ] || exit 0

case $key in
hex:*)
	ui_copy "${key#hex:}" "${key#hex:} copied to the clipboard"
	;;
pick)
	if ! command -v slurp >/dev/null 2>&1 || ! command -v grim >/dev/null 2>&1; then
		ui_say Colour 'slurp and grim are needed to read the screen' critical
		exit 1
	fi
	pos=$(slurp -p -f '%x,%y' 2>/dev/null) || exit 0
	[ -n "${pos:-}" ] || exit 0
	rgb=$(grim -g "$pos 1x1" - 2>/dev/null |
		ffmpeg -v error -i pipe:0 -frames:v 1 -f rawvideo -pix_fmt rgb24 pipe:1 2>/dev/null |
		od -An -tu1) || rgb=
	set -- ${rgb:-}
	if [ $# -lt 3 ]; then
		ui_say Colour 'That pixel could not be read' critical
		exit 1
	fi
	hex=$(printf '#%02x%02x%02x' "$1" "$2" "$3")
	ui_copy "$hex" "$hex copied to the clipboard (${pos%%,*}, ${pos#*,})"
	;;
esac
