#!/bin/bash
# Agents: launch a coding agent CLI, keep several accounts per agent, and pick a
# default. One rofi menu, one foot window, nothing resident.
#
# Omarchy's version of this is a Quickshell panel with usage meters plus a
# subsystem of scripts (omarchy-agent, omarchy-agent-account-*, per-provider
# usage parsers). The parts worth porting here are the two that are local and
# stable:
#
#   * launching: an agent is a terminal program, so foot -e is the whole story;
#   * accounts: Claude Code honours CLAUDE_CONFIG_DIR and Codex honours
#     CODEX_HOME, so an account is a directory and switching is one env var.
#
# Usage meters (Omarchy's bar panel) are deliberately not here: they read
# provider APIs and change shape whenever a provider does. If they come back, the
# right shape is a python3 script (stdlib only, already in the image) printing one
# line for a waybar `custom` module - not a daemon, and not a new language.
#
# Install: the CLIs are npm packages. They are installed with an explicit
# --prefix so npm never needs root and never writes to /usr/local:
#
#   npm install -g --prefix ~/.local <package>
#
# and ~/.local/bin is already on PATH (etc/profile.d/90-cli-tools.sh).
# --allow-scripts names the package being installed because npm 12 blocks
# lifecycle scripts by default: OpenCode's postinstall is the step that picks its
# platform binary, so without it npm leaves a stub that answers "postinstall
# script was not run" and the menu would call that installed.
#
# OpenCode is the one agent the image already ships - tools/opencode/ pins it and
# scripts/rootfs-setup.sh puts it in ~/.opencode/bin - so its row is a launch row
# on a fresh card. The package named below is the V2 one (`opencode-ai` is V1),
# which is the fallback if that directory is gone.
#
#   rofi-agents                 the menu (also Alt+Ctrl+Shift+A)
#   rofi-agents --default       start a session with the default agent
#   rofi-agents --env <a> <acc> print the env assignment for an account
#   rofi-agents --new <agent>   create an account directory
#
# `--default` is what the root menu's AI group calls: the list is the menu, and a
# session is the one action an agent exists for, so that row does not make the
# person open the list and pick again. OpenCode is the default on a fresh card
# because the image ships it (see above); "Set the default agent…" moves it.
#
# Every row carries the session's glyph from lib-rofi.sh - a code sign for an
# agent, two people for its accounts, a download arrow for an install, a gear
# for the default, a terminal for the shell, a bin for removing an account and
# an undo arrow for going back - and a display/key table maps the rendered row
# back to its action, because rofi hands back the row and not a key.
set -eu

. "$(dirname "$0")/lib-rofi.sh"

theme="$HOME/.config/rofi/solarized.rasi"

# sway's own environment has no ~/.local/bin (only login and interactive shells
# get it from /etc/profile.d/90-cli-tools.sh), and that is where npm puts the
# agent CLIs. Without this line the menu would offer to install an agent that is
# already installed. ~/.opencode/bin is not npm's: it is where the image installs
# OpenCode (tools/opencode/), in the layout its own `opencode upgrade` rewrites.
PATH="$HOME/.opencode/bin:$HOME/.local/bin:$PATH"
export PATH
state="${XDG_CONFIG_HOME:-$HOME/.config}/lazyos/agents"
data="${XDG_DATA_HOME:-$HOME/.local/share}/lazyos/agents"
default_file="$state/default"

# name | binary | npm package | config-dir env var (empty = no profiles)
AGENTS=(
	"Claude Code|claude|@anthropic-ai/claude-code|CLAUDE_CONFIG_DIR"
	"Codex|codex|@openai/codex|CODEX_HOME"
	"OpenCode|opencode|@opencode/cli|"
	"Gemini CLI|gemini|@google/gemini-cli|"
	"GitHub Copilot|copilot|@github/copilot|"
)

pick() { # prompt, lines on stdin
	rofi -dmenu -markup-rows -theme "$theme" -p "$1" -lines 12 -i \
		-theme-str 'window { width: 56%; }' "${@:2}"
}

# choose PROMPT TABLE: print the key of the row picked from a display/key TSV.
# The table is what keeps a glyph harmless: rofi hands back the rendered row,
# and the key beside it is the action. Returns 1 when the window is dismissed.
choose() { # prompt, table
	local choice
	choice=$(cut -f1 "$2" | pick "$1") || return 1
	[ -n "$choice" ] || return 1
	awk -F'\t' -v d="$choice" '$1 == d { print $2; exit }' "$2"
}

# The menu's messages are about accounts and installs, so the one icon is the
# account one. It is a name scripts/make-icons.sh renders into the LazyOS theme,
# which mako searches (see lib-rofi.sh); a name that does not resolve draws
# nothing, never an error.
notify() { notify-send -a Agents -i system-users "$@" 2>/dev/null || true; }

installed() { command -v "$1" >/dev/null 2>&1; }

default_agent() { [ -r "$default_file" ] && head -n1 "$default_file" || true; }

# default_entry: the agent a session starts with, as one AGENTS entry. The default
# the menu records comes first; when it names nothing, or names an agent that is
# not installed any more, OpenCode is next - the image ships it, so a fresh card
# has a working default without a trip to the menu - and then the menu's own
# order. Prints nothing when no agent CLI is installed at all, which is the one
# case the caller reports instead of opening a terminal that exits at once.
default_entry() {
	local want=$1 e name bin npm envvar
	for e in "${AGENTS[@]}"; do
		IFS='|' read -r name bin npm envvar <<<"$e"
		if [ "$bin" = "$want" ] && installed "$bin"; then
			printf '%s' "$e"
			return 0
		fi
	done
	for e in "${AGENTS[@]}"; do
		IFS='|' read -r name bin npm envvar <<<"$e"
		[ "$bin" = opencode ] || continue
		if installed "$bin"; then
			printf '%s' "$e"
			return 0
		fi
	done
	for e in "${AGENTS[@]}"; do
		IFS='|' read -r name bin npm envvar <<<"$e"
		if installed "$bin"; then
			printf '%s' "$e"
			return 0
		fi
	done
}

launch() { # name, binary, envvar, account
	local name=$1 bin=$2 envvar=$3 account=${4:-}
	local workdir="$HOME"
	[ -d "$HOME/Work" ] && workdir="$HOME/Work"

	# Agents remember trust per directory, and they refuse $HOME, so a launch from
	# the menu starts in ~/Work when it exists (Omarchy does the same).
	local pre=""
	[ -n "$envvar" ] && [ -n "$account" ] && pre="export $envvar='$data/$bin/$account'; "
	notify "Starting $name" "${account:+account: $account}"
	exec foot -T "$name${account:+ · $account}" \
		-e bash -lc "cd '$workdir' 2>/dev/null || cd ~; ${pre}exec $bin"
}

accounts_menu() { # entry
	local name bin npm envvar
	IFS='|' read -r name bin npm envvar <<<"$1"
	if [ -z "$envvar" ]; then
		notify "$name has no account profiles" "It has no config-directory variable to switch on"
		return
	fi
	local dir="$data/$bin"
	mkdir -p "$dir"
	local table action a
	table=$(mktemp "${TMPDIR:-/tmp}/agents.XXXXXX") || return
	{
		for d in "$dir"/*/; do
			[ -d "$d" ] || continue
			a=$(basename "$d")
			if [ "$a" = "$(cat "$dir/default" 2>/dev/null)" ]; then
				ui_row "$UI_I_USERS" "$a" "(default)" "use:$a"
			else
				ui_row "$UI_I_USERS" "$a" "" "use:$a"
			fi
		done
		ui_row "$UI_I_USERS" "New account…" "" "new"
		ui_row "$UI_I_TRASH" "Remove an account…" "" "remove"
		ui_row "$UI_I_UNDO" "Back" "" "back"
	} >"$table"
	action=$(choose "Accounts · $name" "$table") || { rm -f "$table"; return; }
	rm -f "$table"
	case "$action" in
	"new") new_account "$name" "$bin" ;;
	"remove") remove_account "$name" "$bin" ;;
	"back" | "") return ;;
	"use:"*) use_account "$name" "$bin" "${action#use:}" ;;
	esac
}

new_account() { # name, binary
	local name=$1 dir="$data/$2" label
	mkdir -p "$dir"
	label=$(printf '' | rofi -dmenu -theme "$theme" -p "Account name" -lines 1 \
		-theme-str 'entry { placeholder: "work, personal, …"; }') || return
	label=$(printf '%s' "$label" | tr -c 'A-Za-z0-9._-' '_')
	[ -n "$label" ] || return
	mkdir -p "$dir/$label"
	printf '%s' "$label" >"$dir/default"
	notify "$name: account $label ready" \
		"It is empty: the first sign-in there creates the profile. Launch $name to log in."
}

remove_account() { # name, binary
	local name=$1 dir="$data/$2" table action a
	table=$(mktemp "${TMPDIR:-/tmp}/agents.XXXXXX") || return
	{
		for d in "$dir"/*/; do
			[ -d "$d" ] || continue
			a=$(basename "$d")
			ui_row "$UI_I_USERS" "$a" "" "rm:$a"
		done
	} >"$table"
	if [ ! -s "$table" ]; then
		rm -f "$table"
		notify "No accounts to remove"
		return
	fi
	action=$(choose "Remove account · $name" "$table") || { rm -f "$table"; return; }
	rm -f "$table"
	case "$action" in
	"rm:"*) ;;
	*) return ;;
	esac
	a=${action#rm:}
	rm -rf "${dir:?}/$a"
	notify "$name: removed $a"
}

use_account() { # name, binary, account
	local name=$1 bin=$2 acc=$3
	printf '%s' "$acc" >"$data/$bin/default"
	notify "$name" "default account: $acc"
}

menu() {
	local rows="" entry name bin npm envvar mark table action
	for entry in "${AGENTS[@]}"; do
		IFS='|' read -r name bin npm envvar <<<"$entry"
		if [ "$(default_agent)" = "$bin" ]; then
			mark="● $name"
		else
			mark=$name
		fi
		if installed "$bin"; then
			rows+=$(ui_row "$UI_I_CODE" "$mark" "" "launch:$entry")$'\n'
			if [ -n "$envvar" ]; then
				rows+=$(ui_row "$UI_I_USERS" "$name accounts…" "" "accounts:$entry")$'\n'
			fi
		else
			rows+=$(ui_row "$UI_I_DOWNLOAD" "$name" "install $npm" "install:$entry")$'\n'
		fi
	done
	rows+=$(ui_row "$UI_I_COG" "Set the default agent…" "" "default")$'\n'
	rows+=$(ui_row "$UI_I_TERM" "Open a terminal in ~/Work" "" "shell")$'\n'

	table=$(mktemp "${TMPDIR:-/tmp}/agents.XXXXXX") || return
	printf '%s' "$rows" >"$table"
	action=$(choose "Agents" "$table") || { rm -f "$table"; return; }
	rm -f "$table"
	case "$action" in
	launch:*)
		local entry=${action#launch:}
		IFS='|' read -r name bin npm envvar <<<"$entry"
		local acc=""
		[ -n "$envvar" ] && [ -r "$data/$bin/default" ] && acc=$(head -n1 "$data/$bin/default")
		launch "$name" "$bin" "$envvar" "$acc"
		;;
	accounts:*) accounts_menu "${action#accounts:}" ;;
	install:*)
		local entry=${action#install:}
		IFS='|' read -r name bin npm envvar <<<"$entry"
		notify "Installing $name" "npm install -g --prefix ~/.local $npm"
		exec foot -T "Install $name" -e bash -lc \
			"npm install -g --prefix \"\$HOME/.local\" --allow-scripts='$npm' '$npm' && echo; echo \"$name is in ~/.local/bin; the menu finds it now.\"; read -r _"
		;;
	default)
		local table chosen
		table=$(mktemp "${TMPDIR:-/tmp}/agents.XXXXXX") || return
		{
			for entry in "${AGENTS[@]}"; do
				IFS='|' read -r name bin npm envvar <<<"$entry"
				if installed "$bin"; then
					ui_row "$UI_I_CODE" "$bin" "" "$bin"
				fi
			done
		} >"$table"
		if [ ! -s "$table" ]; then
			rm -f "$table"
			notify "No agent CLI is installed yet"
			return
		fi
		chosen=$(choose "Default agent" "$table") || { rm -f "$table"; return; }
		rm -f "$table"
		[ -n "$chosen" ] || return
		mkdir -p "$state"
		printf '%s' "$chosen" >"$default_file"
		notify "Default agent: $chosen"
		;;
	shell) exec foot -T "Work" -e bash -lc 'cd "$HOME/Work" 2>/dev/null || cd ~; exec bash' ;;
	esac
}

case "${1:-}" in
--default)
	# A session with the default agent: the AI group's own row, so one click
	# starts an agent instead of opening the list to pick the same one again.
	entry=$(default_entry "$(default_agent)")
	if [ -z "$entry" ]; then
		notify "No agent CLI is installed" \
			"The Agents menu installs one with npm"
		exit 1
	fi
	IFS='|' read -r name bin npm envvar <<<"$entry"
	acc=""
	if [ -n "$envvar" ] && [ -r "$data/$bin/default" ]; then
		acc=$(head -n1 "$data/$bin/default")
	fi
	launch "$name" "$bin" "$envvar" "$acc"
	;;
--env)
	# Print the assignment for one account, for use in a shell:
	#   eval "$(rofi-agents --env 'Claude Code' work)"
	# The agent may be named by its display name or by its binary.
	entry=""
	for e in "${AGENTS[@]}"; do
		IFS='|' read -r name bin npm envvar <<<"$e"
		[ "$name" = "${2:-}" ] || [ "$bin" = "${2:-}" ] && entry=$e
	done
	[ -n "$entry" ] || { printf 'unknown agent: %s\n' "${2:-}" >&2; exit 2; }
	IFS='|' read -r name bin npm envvar <<<"$entry"
	[ -n "$envvar" ] || { printf 'no account support for %s\n' "$name" >&2; exit 2; }
	[ -n "${3:-}" ] || { printf 'usage: rofi-agents --env <agent> <account>\n' >&2; exit 2; }
	printf 'export %s=%q\n' "$envvar" "$data/$bin/$3"
	;;
--new)
	for e in "${AGENTS[@]}"; do
		IFS='|' read -r name bin npm envvar <<<"$e"
		[ "$name" = "${2:-}" ] || [ "$bin" = "${2:-}" ] || continue
		[ -n "$envvar" ] || { printf 'no account support for %s\n' "$name" >&2; exit 2; }
		new_account "$name" "$bin"
		exit 0
	done
	printf 'usage: rofi-agents --new "Claude Code"\n' >&2
	exit 2
	;;
"") menu ;;
*)
	printf 'usage: rofi-agents [--default | --env <agent> <account> | --new <agent>]\n' >&2
	exit 2
	;;
esac
