#!/bin/sh
# Auxiliary swap: an SD card or a USB stick used as more memory, every boot.
#
# The machine already swaps to zram, which is compressed RAM: fast, but capped at
# half of RAM and it is still RAM, so it cannot give memory back the way a card
# can.  A card is much slower, which is why its priority is 10 and zram keeps 100:
# the kernel spills to the card only once the compressed pool is full.  That is
# also what makes it worth having on a 4 GB machine.
#
# What is safe about this menu is the same list rofi-format draws, and it is one
# function (ui_disks in lib-rofi.sh): nothing mounted, no ChromeOS kernel
# partition, no zram/loop/optical device, and never a disk that is built into the
# machine or is the one this system runs from (ui_disk_system).  The eMMC and the
# card this system boots from are never candidates, whatever their names are - even
# after a wiped partition table - and the guard is asked again after the pick,
# because setup rewrites the whole disk.  Setup then:
#
#   * writes a fresh GPT and one Linux-swap partition, wiped and labelled
#     lazyos_swap - the same label `resume=LABEL=lazyos_swap` resolves for
#     hibernate, so the two features name one card, not two;
#   * mkswap -f, because the partition starts where a previous filesystem may
#     have started and mkswap refuses a partition that still carries a signature;
#   * adds one marked block to /etc/fstab
#
#       # LazyOS auxiliary swap
#       LABEL=lazyos_swap none swap sw,nofail,x-systemd.device-timeout=15s,pri=10 0 0
#       # end LazyOS auxiliary swap
#
#     `nofail` is what keeps a boot without the card from failing, and the
#     device timeout is what keeps it from waiting the default 90 s for it.  The
#     block is replaced, not appended, so running setup twice cannot leave two
#     entries for one label;
#   * activates it now with `swapon -p 10`, then reads the kernel's swap list back
#     instead of claiming success (joined onto one line: `swapon --show` prints
#     one device per line and zram is always first).  If activation fails the
#     fstab block is removed again and the partition turned off if it did come
#     on: a card that is not doing anything should not be configured at boot
#     either, and a swap with no fstab entry is a state nothing explains.
#
# The mount is not the point: this is a swap partition, not a filesystem.  It
# never appears in Places as a Mount row, and pulling the card while it is active
# is unsafe.  "Turn it off" is the undo path: swapoff first (which can fail if the
# swap is in use; then the fstab entry stays, because that is the state that was
# there), then the fstab block, then daemon-reload.  The partition itself is left
# in place, labelled, so it can be erased from Format a disk.
#
#   rofi-swap            what a card would add, or what is already set up
#
# Reached from Places (below Format a disk, where the disks are) and the root
# menu.  Not stoppable: a killed parted/mkswap leaves half a card, and a killed
# swapoff is not a swap that is off.
set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

tmp=$(mktemp -d "${TMPDIR:-/tmp}/swap.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

have() { command -v "$1" >/dev/null 2>&1; }

missing=""
for _c in parted mkswap swapon swapoff blkid lsblk; do
	have "$_c" || missing="$missing $_c"
done
if [ -n "$missing" ]; then
	ui_say 'Auxiliary swap' "Missing:$missing (parted, util-linux)" \
		critical "$UI_ICON_ERROR"
	exit 1
fi

# Both the setup and the undo rewrite /etc/fstab, so a system without one cannot be
# served by this menu at all - and saying that is better than the `set -e` death the
# first read would otherwise cause.
if [ ! -r /etc/fstab ]; then
	ui_say 'Auxiliary swap' '/etc/fstab is missing or unreadable: nothing can be configured' \
		critical "$UI_ICON_ERROR"
	exit 1
fi

# One source for the priority: it is in the fstab line and in the swapon call, and
# it has to stay below zram's 100 (scripts/rootfs-setup.sh writes that one).
PRIO=10

FSTAB_START='# LazyOS auxiliary swap'
FSTAB_END='# end LazyOS auxiliary swap'

# fstab_configured: 0 when /etc/fstab asks for the auxiliary swap, however the
# line got there (this menu, or the manual commands in sway-hibernate's comment).
fstab_configured() {
	awk '$1 == "LABEL=lazyos_swap" && $3 == "swap" { found = 1 } END { exit !found }' \
		/etc/fstab 2>/dev/null
}

# fstab_strip: /etc/fstab without the marked block and without any other line that
# activates LABEL=lazyos_swap.  The broader rule is deliberate: the manual path
# documented in sway-hibernate writes the same line, and undo has to be true for
# that line as well, not only for the block this menu wrote.
fstab_strip() {
	awk -v start="$FSTAB_START" -v end="$FSTAB_END" '
		$0 == start { inblock = 1; next }
		$0 == end { inblock = 0; next }
		inblock { next }
		$1 == "LABEL=lazyos_swap" && $3 == "swap" { next }
		{ print }
	' /etc/fstab
}

# fstab_write FILE: atomically put FILE in place of /etc/fstab.  install writes the
# copy beside it and mv renames over the original, so a crash in the middle leaves
# the old file whole; `cat >` would truncate it first.
fstab_write() {
	sudo -n install -o root -g root -m 0644 "$1" /etc/.fstab.lazyos-swap &&
		sudo -n mv /etc/.fstab.lazyos-swap /etc/fstab
}

# The card that carries the label, if it is inserted.  blkid reads the device, so
# it needs the privileged read even though the label itself is not sensitive.
part=$(sudo -n blkid -L lazyos_swap 2>/dev/null || true)
# One line per swap device, and zram is always the first one, so the list has to
# become one space-separated string before `case` can find the card on any line.
swaps=$(swapon --show=NAME --noheadings 2>/dev/null | tr '\n' ' ' || true)
active=no
if [ -n "$part" ]; then
	case " $swaps " in
	*" $part "*) active=yes ;;
	esac
fi

# Already set up: status and undo, because the only other useful action (replacing
# the card) has to turn the old one off first anyway.
if fstab_configured || [ "$active" = yes ]; then
	{
		if [ -n "$part" ]; then
			size=$(lsblk -dno SIZE "$part" 2>/dev/null || true)
			if [ "$active" = yes ]; then
				prio=$(swapon --show=NAME,PRIO --noheadings 2>/dev/null |
					awk -v d="$part" '$1 == d { print $2; exit }')
				ui_row "$UI_I_CHIP" 'Auxiliary swap is on' \
					"$part · ${size:-?} · priority ${prio:-?}, after the compressed RAM" \
					state "$UI_GREEN"
			else
				ui_row "$UI_I_CHIP" 'Auxiliary swap is set up' \
					"$part · ${size:-?} · not active now" state
			fi
		else
			ui_row "$UI_I_CHIP" 'Auxiliary swap is set up' \
				'the lazyos_swap card is not inserted · a boot without it waits 15 s at most' \
				state "$UI_YELLOW"
		fi
		ui_row "$UI_I_UNDO" 'Turn it off' \
			'swapoff, and no swap from that card at the next boot' undo "$UI_YELLOW"
	} >"$tmp/rows"

	key=$(ui_pick 'Auxiliary swap' \
		'Enter acts · Escape closes · the card is not touched' <"$tmp/rows") || exit 0

	case $key in
	undo) ;;
	*) exit 0 ;;
	esac

	{
		ui_row "$UI_I_UNDO" 'Cancel' 'nothing changes' cancel "$UI_GREEN"
		ui_row "$UI_I_WARN" 'Turn it off' \
			"${part:-the lazyos_swap card} · files on it are not erased" go "$UI_YELLOW"
	} >"$tmp/yes"
	answer=$(ui_pick 'Turn off the auxiliary swap?' \
		'a card that is in use can take a while · Escape leaves it as it is' <"$tmp/yes") ||
		exit 0
	[ "$answer" = go ] || exit 0

	"$dir/busy" start swap 'Auxiliary swap' "Turning off ${part:-the swap}…" "$UI_ICON_DISK"
	step=swapoff
	rc=0
	if [ "$active" = yes ]; then
		out=$(sudo -n swapoff "$part" 2>&1) || rc=$?
	fi
	if [ "$rc" -eq 0 ] && fstab_configured; then
		step=fstab
		fstab_strip >"$tmp/fstab"
		out=$(fstab_write "$tmp/fstab" 2>&1) || rc=$?
	fi
	if [ "$rc" -eq 0 ]; then
		step=systemd
		out=$(sudo -n systemctl daemon-reload 2>&1) || rc=$?
	fi

	if [ "$rc" -ne 0 ]; then
		"$dir/busy" fail swap \
			"the $step step failed: $(printf '%s' "${out:-no message}" | tail -n 2 | tr '\n' ' ')" \
			"$UI_ICON_ERROR"
		exit 1
	fi

	"$dir/busy" end swap 'Auxiliary swap is off'
	if [ -n "$part" ]; then
		ui_say 'Auxiliary swap' \
			"$part is no longer used; the partition is still there (Format a disk erases it)" \
			normal "$UI_ICON_DISK"
	else
		ui_say 'Auxiliary swap' \
			'the /etc/fstab entry is gone; the card is no longer needed at boot' \
			normal "$UI_ICON_DISK"
	fi
	exit 0
fi

# Nothing is set up yet: the card, then how much of it, then one confirmation.
ui_disks swap >"$tmp/rows"
if [ ! -s "$tmp/rows" ]; then
	# The fourth reason is the one a person actually hits: the card that
	# installed the eMMC is removable, unmounted and therefore a candidate on
	# every other count, and only its kernel partition says it is bootable.
	# Leaving that out made the guard read as "the menu is broken".
	ui_say 'Auxiliary swap' \
		'Nothing to offer: every disk here is mounted, built into the machine, carries a bootable kernel partition (the card that installed this system), or is the one this system runs from' \
		normal "$UI_ICON_DISK"
	exit 0
fi

key=$(ui_pick 'Auxiliary swap' \
	'Enter picks a card · the card is erased · Escape closes' <"$tmp/rows") || exit 0
case $key in
swap:*) name=${key#swap:} ;;
*) exit 0 ;;
esac
dev=/dev/$name

# The same last gate as Format a disk: this rewrites the whole disk with parted,
# so a disk that ui_disk_system refuses is refused again after the pick, whatever
# the list said.
if ui_disk_system "$name"; then
	ui_say 'Auxiliary swap' \
		"$dev is built into this machine or is the disk this system runs from: never repartitioned here" \
		critical "$UI_ICON_ERROR"
	exit 1
fi

info=$(lsblk -dnro SIZE,MODEL "$dev" 2>/dev/null |
	sed -e 's/\\x20/ /g' -e 's/  */ /g' || true)
size=$(lsblk -dnro SIZE "$dev" 2>/dev/null || true)
bytes=$(lsblk -bdno SIZE "$dev" 2>/dev/null || true)
case ${bytes:-0} in
*[!0-9]*) bytes=0 ;;
esac
mib=$((bytes / 1048576))

# One label has to mean one card: fstab's LABEL= and resume= both resolve to
# whichever device carries it, so a second card with the label would make the
# entry ambiguous.  The card already set up may be reused (that is the state undo
# leaves), but a different disk is refused until it is turned off.
existing=$(sudo -n blkid -L lazyos_swap 2>/dev/null || true)
if [ -n "$existing" ]; then
	parent=$(lsblk -no PKNAME "$existing" 2>/dev/null | tr -d '[:space:]' | head -n1 || true)
	if [ "$existing" != "$dev" ] && [ "$parent" != "$name" ]; then
		ui_say 'Auxiliary swap' \
			"$existing already carries the lazyos_swap label: turn that swap off first" \
			critical "$UI_ICON_ERROR"
		exit 1
	fi
fi

# The whole card first, because a dedicated swap card is the point; the smaller
# sizes are there for a card that has to keep room.  64 MiB of margin covers the
# GPT and alignment, and a size that does not fit is not offered at all.
{
	ui_row "$UI_I_DISK" 'The whole card' "$size · one swap partition, nothing beside it" size:all
	for _gib in 2 4 8; do
		[ "$mib" -ge $((_gib * 1024 + 64)) ] || continue
		ui_row "$UI_I_DISK" "$_gib GiB" 'the rest of the card stays unpartitioned' "size:$_gib"
	done
} >"$tmp/sizes"
how=$(ui_pick 'How much swap?' "$dev · ${info:-} · more swap is slower than RAM" \
	<"$tmp/sizes") || exit 0
case $how in
size:all)
	# mkpart takes the end; 1MiB of start is the alignment parted wants.
	end=100%
	alloc=$size
	;;
size:*)
	gib=${how#size:}
	end="$((gib * 1024 + 1))MiB"
	alloc="$gib GiB"
	;;
*) exit 0 ;;
esac

# The destructive row is the second one on purpose: rofi selects the first row,
# so Enter on the confirmation cancels instead of erasing a card.
{
	ui_row "$UI_I_UNDO" 'Cancel' 'nothing is written' cancel "$UI_GREEN"
	ui_row "$UI_I_WARN" "Erase $dev" "${info:-} · $alloc of swap, label lazyos_swap" go "$UI_RED"
} >"$tmp/yes"
answer=$(ui_pick 'Use this card for swap?' \
	"$dev · ${info:-} · every file on it is lost · Escape cancels" <"$tmp/yes") || exit 0
[ "$answer" = go ] || exit 0

# Not stoppable, like Format a disk: a kill between the table and mkswap leaves a
# card that is neither a filesystem nor swap, which is worse than a wait.
"$dir/busy" start swap 'Auxiliary swap' "Preparing $dev…" "$UI_ICON_DISK"

# Every step asks for its own status instead of nesting inside the previous `if`:
# with `set -e`, a failing command in an `if` *body* ends the script before the
# card can become the reason, and the bar would spin on a disk that is broken.
step=partition-table
rc=0
out=$(sudo -n parted -s "$dev" mktable gpt 2>&1) || rc=$?

if [ "$rc" -eq 0 ]; then
	step=partition
	out=$(sudo -n parted -s "$dev" mkpart primary linux-swap 1MiB "$end" 2>&1) || rc=$?
fi

if [ "$rc" -eq 0 ]; then
	# sda1 but mmcblk1p1: the kernel inserts a `p` when the device name already
	# ends in a digit.
	case $dev in
	*[0-9]) part="${dev}p1" ;;
	*) part="${dev}1" ;;
	esac
	# The node appears when udev has processed the new table; waiting for it is
	# cheaper than failing on a race.
	_n=0
	while [ ! -b "$part" ] && [ "$_n" -lt 50 ]; do
		sleep 0.1
		_n=$((_n + 1))
	done
	if [ ! -b "$part" ]; then
		rc=1
		out="$part did not appear: the kernel still has the old table"
	fi
fi

if [ "$rc" -eq 0 ]; then
	step=swap-area
	# -f: the new partition starts where an old filesystem may have started, and
	# mkswap refuses to touch a device that still carries a signature.
	out=$(sudo -n mkswap -f -L lazyos_swap "$part" 2>&1) || rc=$?
fi

fstab_written=no
if [ "$rc" -eq 0 ]; then
	step=fstab
	{
		fstab_strip
		printf '%s\n' "$FSTAB_START"
		printf 'LABEL=lazyos_swap none swap sw,nofail,x-systemd.device-timeout=15s,pri=%s 0 0\n' "$PRIO"
		printf '%s\n' "$FSTAB_END"
	} >"$tmp/fstab"
	out=$(fstab_write "$tmp/fstab" 2>&1) || rc=$?
	[ "$rc" -eq 0 ] && fstab_written=yes
fi

if [ "$rc" -eq 0 ]; then
	step=systemd
	out=$(sudo -n systemctl daemon-reload 2>&1) || rc=$?
fi

if [ "$rc" -eq 0 ]; then
	step=activation
	# The priority is passed here as well as written to fstab, so the card is
	# active now with the same order it will have at the next boot.
	out=$(sudo -n swapon -p "$PRIO" "$part" 2>&1) || rc=$?
	# swapon's exit status is not the whole answer (another fstab entry can make
	# -a fail); what matters is whether this partition is in the kernel's list.
	# The list is one line per device and zram is always first, so join it before
	# `case` looks for the card: a newline is not the space the pattern needs.
	swaps=$(swapon --show=NAME --noheadings 2>/dev/null | tr '\n' ' ' || true)
	case " $swaps " in
	*" $part "*) rc=0 ;;
	*)
		[ -n "$out" ] || out="swapon did not report $part as active"
		rc=1
		;;
	esac
fi

if [ "$rc" -ne 0 ]; then
	# A card that could not be activated should not be configured for the next
	# boot either: remove the block we just wrote, and say so if even that failed.
	# If activation did happen but the read-back could not see it, turn it off as
	# well: a swap that is on with no fstab entry is a state nothing explains.
	if [ "$step" = activation ]; then
		sudo -n swapoff "$part" >/dev/null 2>&1 || true
	fi
	rollback_note=
	if [ "$fstab_written" = yes ]; then
		fstab_strip >"$tmp/fstab-rollback"
		_rb=0
		_rb_out=$(fstab_write "$tmp/fstab-rollback" 2>&1) || _rb=$?
		[ "$_rb" -eq 0 ] ||
			rollback_note=" · the fstab block could not be removed: ${_rb_out:-no message}"
	fi
	"$dir/busy" fail swap \
		"the $step step failed: $(printf '%s' "${out:-no message}" | tail -n 2 | tr '\n' ' ')$rollback_note" \
		"$UI_ICON_ERROR"
	exit 1
fi

"$dir/busy" end swap "$dev is $alloc of swap (label lazyos_swap)"
ui_say 'Auxiliary swap' \
	"$part · $alloc · priority $PRIO, after the compressed RAM · active now and on every boot with the card in" \
	normal "$UI_ICON_DISK"
