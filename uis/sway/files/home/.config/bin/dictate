#!/bin/sh
# Dictation: press the shortcut, speak, press it again, and the text is typed
# into whatever window has the focus.
#
# Omarchy runs voxtype, a Rust daemon that holds the microphone and a state file.
# This is the same idea without the daemon: one parecord while recording, one
# ffmpeg to normalise the level, one whisper-cli to transcribe, one wtype to type
# the result, and nothing left afterwards.  The model is fetched on first use
# (dictate-model, 78 MB for tiny.en) and kept in ~/.local/share/whisper.
#
# Three things were learned on hardware and are the reason for the flags below:
#
#   * the recording is quiet.  The internal DMIC arrives at a low level, and
#     whisper is very sensitive to it, so the wav is normalised with
#     dynaudnorm before transcription instead of a constant gain that would
#     clip the loud parts.
#   * it has to say what it is doing.  Recording and transcription are both
#     silent for seconds, so both go through `busy`: the mako card stays up and
#     the bar shows the spinner until the text is typed (or the attempt fails).
#   * it has to be stoppable without remembering the shortcut.  Pressing the key
#     again stops it, the bar's spinner is the second button for the same thing
#     (BUSY_STOP below runs this very script, so there is one way to stop a
#     recording and not two that can drift), and "Stop dictation" is a row in
#     the root menu (bar-menu), which is where the states are visible.
#
# Safety: recording stops itself after 60 seconds, and the working files live in
# the runtime directory so a crash cannot leave a growing wav behind.
set -eu

dir="${XDG_RUNTIME_DIR:-/tmp}/dictate"
wav="$dir/rec.wav"
norm="$dir/norm.wav"
state="$dir/pid"
model="${DICTATE_MODEL:-${XDG_DATA_HOME:-$HOME/.local/share}/whisper/ggml-tiny.en.bin}"
self=$(readlink -f "$0")
busy="$(dirname "$self")/busy"

# notify ICON TITLE [BODY]: the icon names are the ones the LazyOS icon theme
# draws (audio-input-microphone for the recording, dialog-error for a failure,
# dialog-information for a note); an unknown name falls back through hicolor and
# Adwaita, so a missing one costs a generic glyph and nothing else.
notify() { notify-send -a Dictation -i "$1" "$2" "${3:-}" 2>/dev/null || true; }
mkdir -p "$dir"

# One card per attempt: it appears when recording starts and turns into the
# result, so there is never a toast that says "working" and then nothing.
#
# `start` rather than `update`, for two sides of the same reason: it rewrites the
# whole card, including its stop registration.  The stop belongs to the
# recording - bar-busy stop runs this script, i.e. exactly what the shortcut
# does - and it must not survive into transcription, where the only cancel is
# throwing the text away and a click would start a second recording instead.
# `start` is also what makes the bar-stopped path work: bar-busy removed the card
# before it ran this script, so there is nothing left to update and this draws a
# fresh one.  Same mako tag either way, so the toast is replaced, not stacked.
progress() {
	"$busy" start dictate 'Dictation' "$1" audio-input-microphone 2>/dev/null || true
}

if [ -f "$state" ]; then
	# --- stop and transcribe -------------------------------------------------
	pid=$(cat "$state")
	rm -f "$state"
	# SIGINT is what makes parecord write the final wav header; a recorder that
	# ignores it is terminated after two seconds so the menu never hangs.
	kill -INT "$pid" 2>/dev/null || true
	_n=0
	while kill -0 "$pid" 2>/dev/null && [ "$_n" -lt 20 ]; do
		sleep 0.1
		_n=$((_n + 1))
	done
	kill -0 "$pid" 2>/dev/null && kill -TERM "$pid" 2>/dev/null || true

	if [ ! -s "$wav" ]; then
		"$busy" fail dictate 'Nothing was recorded' dialog-error 2>/dev/null ||
			notify dialog-error "Nothing was recorded"
		exit 1
	fi
	progress 'Transcribing…'

	# Level first, then text.  dynaudnorm lifts the quiet passages and leaves the
	# loud ones alone; the resample keeps whisper on the 16 kHz mono it wants.
	_audio=$wav
	if command -v ffmpeg >/dev/null 2>&1 &&
		ffmpeg -nostdin -loglevel error -y -i "$wav" \
			-af dynaudnorm=f=150:g=15 -ar 16000 -ac 1 "$norm" >/dev/null 2>&1 &&
		[ -s "$norm" ]; then
		_audio=$norm
	fi

	text=$(whisper-cli -m "$model" -f "$_audio" -l en -t "$(nproc)" -nt -np 2>/dev/null |
		tr '\n' ' ' | tr -s ' ' | sed -e 's/^ //' -e 's/ $//' -e 's/\[[^]]*\]//g')
	rm -f "$wav" "$norm"

	if [ -z "$text" ]; then
		"$busy" fail dictate 'Nothing was recognised' dialog-error 2>/dev/null ||
			notify dialog-error "Nothing was recognised"
		exit 1
	fi

	# Paste into the focused window, and keep it on the clipboard as well: wtype
	# fails when the focused surface refuses the virtual keyboard (rofi, a
	# fullscreen game), and then the clipboard is the way out.
	printf '%s' "$text" | wl-copy 2>/dev/null || true
	if command -v wtype >/dev/null 2>&1; then
		if wtype "$text" 2>/dev/null; then
			"$busy" end dictate "Typed · $(printf '%s' "$text" | cut -c1-60)" 2>/dev/null ||
				notify audio-input-microphone "Typed" "$(printf '%s' "$text" | cut -c1-80)"
		else
			"$busy" end dictate "Copied to the clipboard · typing failed" 2>/dev/null ||
				notify audio-input-microphone "Copied to the clipboard" "Typing into the focused window failed"
		fi
	else
		"$busy" end dictate 'Copied to the clipboard · wtype is missing' 2>/dev/null ||
			notify audio-input-microphone "Copied to the clipboard" "wtype is not installed, so nothing was typed"
	fi
	exit 0
fi

# --- start recording --------------------------------------------------------
[ -r "$model" ] || {
	notify dialog-information "Fetching the speech model (78 MB, once)" \
		"Press the shortcut again when it finishes"
	exec foot -T "Dictation · fetching model" -e "$(dirname "$self")/dictate-model"
}

command -v parecord >/dev/null 2>&1 ||
	{ notify dialog-error "parecord is missing" "It ships in pulseaudio-utils"; exit 1; }

playerctl -a pause >/dev/null 2>&1 || true
rm -f "$wav"
parecord --rate=16000 --channels=1 --format=s16le --file-format=wav "$wav" \
	>/dev/null 2>&1 &
printf '%s\n' "$!" >"$state"

# The card is the signal that it is recording, and the bar spins while it lasts.
# BUSY_STOP is this script with its own path, quoted for `sh -c`, so the bar's
# stop does exactly what the shortcut does: stop the recorder (SIGINT, so the
# wav header is written), transcribe and type.  That is the useful answer to
# "stop dictating" - a stop that threw the recording away would be a second
# behaviour to explain - and it keeps one code path for both buttons.
BUSY_STOP="\"$self\"" "$busy" start dictate 'Dictation' \
	'Recording · the bar spinner or Alt+Ctrl+X stops it' audio-input-microphone 2>/dev/null ||
	notify audio-input-microphone "Recording…" "Press the shortcut again to stop (60 s maximum)"

# The safety stop is a single short-lived process, not a watcher.
( sleep 60; [ -f "$state" ] && "$self" >/dev/null 2>&1 ) &
