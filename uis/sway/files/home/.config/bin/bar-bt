#!/bin/sh
# Bluetooth indicator and picker behind the bar.
#
#   bar-bt          left click: scan briefly, then list the devices found;
#                   picking one connects it (or disconnects it, when it is
#                   already connected)
#   bar-bt status   what waybar polls: a JSON icon, dimmed while the radio is
#                   off, with the connected devices in the tooltip
#
# Deboma's bluetooth plugin keeps a panel process alive to draw this list.  One
# short-lived rofi + bluetoothctl pair per click gives the same interaction
# for the duration of the click only.  Right click on the indicator opens
# bluetoothctl in a floating terminal for what a list cannot do (pairing keys,
# trust, remove, agent).
#
# The scan is the 3 s version bluetoothd offers (`--timeout`); `timeout` is
# only a guard in case that option ever goes away, so the menu cannot hang.

set -eu

dir=$(dirname "$0")
tab=$(printf '\t')
icon="<span font_desc='JetBrains Mono 13'></span>"

# One error channel: the mako card the progress toast used, left behind as a
# critical notification (see busy).  The icon names the failure rather than the
# action the card was showing, because the glyph changing is what says "this is
# not progress any more".
fail() { "$dir/busy" fail bt "$*" dialog-error; }

# "Powered: yes" is the only line of `bluetoothctl show` this needs; the
# controller does not have to be the default one (there is only one here).
powered() {
	bluetoothctl show 2>/dev/null | sed -n 's/^[[:space:]]*Powered:[[:space:]]*//p' | head -1
}

# MAC<TAB>name, one per connected device.
connected_devices() {
	bluetoothctl devices Connected 2>/dev/null |
		sed -n 's/^Device \([0-9A-Fa-f:]*\)[[:space:]]\{1,\}\(.*\)$/\1	\2/p'
}

status() {
	conn=$(connected_devices)
	if [ "$(powered)" = yes ]; then
		names=$(printf '%s\n' "$conn" | cut -f2)
		n=$(printf '%s\n' "$names" | grep -c . || true)
		tooltip='Bluetooth on'
		while IFS= read -r name; do
			[ -n "$name" ] || continue
			tooltip="$tooltip\n  $name"
		done <<EOF
$names
EOF
		text=$icon
		[ "${n:-0}" -gt 0 ] && text="$text $n"
		printf '{"text":"%s","class":"on","tooltip":"%s"}\n' "$text" "$tooltip"
	else
		printf '{"text":"%s","class":"off","tooltip":"Bluetooth off - click to turn it on"}\n' "$icon"
	fi
}

if [ "${1:-pick}" = status ]; then
	status
	exit 0
fi

if [ "$(powered)" != yes ]; then
	choice=$(printf '%s\n' 'Turn Bluetooth on' | "$dir/bar-pick" 'Bluetooth is off') || exit 0
	if [ "$choice" = 'Turn Bluetooth on' ]; then
		# No stop command: `bluetoothctl power on` is a request to bluetoothd
		# that returns as soon as the controller answers, and a button for
		# something already over is worse than none.
		"$dir/busy" start bt Bluetooth 'Powering the controller on…' bluetooth
		if bluetoothctl power on >/dev/null 2>&1; then
			"$dir/busy" end bt 'Bluetooth on'
		else
			fail 'Bluetooth: could not power the controller on'
		fi
	fi
	exit 0
fi

# Three seconds of scan is the longest wait in the bar: without the toast the
# click looks lost. The list replaces it as soon as it is ready.
#
# The scan is worth a stop button, and it is the one Bluetooth step that has
# nothing to clean up afterwards: `scan on` is a discovery filter the client
# registers with bluetoothd, and it disappears with the client, so the adapter
# stops discovering instead of being left in a scan nobody is listening to.
# The bracketed pattern keeps the `sh -c` line that runs this from matching
# itself.
BUSY_STOP='pkill -f "[b]luetoothctl.*scan on"' \
	"$dir/busy" start bt Bluetooth 'Scanning for devices…' bluetooth
timeout 6 bluetoothctl --timeout 3 scan on >/dev/null 2>&1 || true

# `timeout` has `|| true` for the guard, so a killed scan looks exactly like a
# finished one: ask the card, and close the menu rather than offering the two
# devices the three seconds happened to reach.
if "$dir/busy" cancelled bt; then
	exit 0
fi

known=$(bluetoothctl devices 2>/dev/null |
	sed -n 's/^Device \([0-9A-Fa-f:]*\)[[:space:]]\{1,\}\(.*\)$/\1	\2/p')

# Connected devices first (flag 0), then everything else, one row per MAC.
devices=$(
	{
		printf '%s\n' "$(connected_devices)" | sed "s/^/c$tab/"
		printf '%s\n' "$known" | sed "s/^/k$tab/"
	} |
		awk -F"$tab" '
			NF < 3 { next }
			{ if ($2 in seen) next; seen[$2] = 1; printf "%d\t%s\t%s\n", ($1 == "c" ? 0 : 1), $2, $3 }' |
		sort -t "$tab" -k1,1n
)

menu=$(
	printf '%s\n' "$devices" |
		awk -F"$tab" 'NF >= 3 { printf "%s%s  ·  %s\n", ($1 == 0 ? "* " : "  "), $3, $2 }'
)
[ -n "$menu" ] || menu='No devices found'

"$dir/busy" stop bt
choice=$(
	printf '%s\n' "$menu" 'Turn Bluetooth off' 'Open bluetoothctl' |
		"$dir/bar-pick" 'Bluetooth'
) || exit 0

case $choice in
	'') exit 0 ;;
	'No devices found') exit 0 ;;
	'Turn Bluetooth off')
		# Same as turning it on: a request that returns at once, no stop file.
		"$dir/busy" start bt Bluetooth 'Powering the controller off…' bluetooth
		if bluetoothctl power off >/dev/null 2>&1; then
			"$dir/busy" end bt 'Bluetooth off'
		else
			fail 'Bluetooth: could not power the controller off'
		fi
		exit 0
		;;
	'Open bluetoothctl') exec foot --app-id=popup bluetoothctl ;;
esac

mac=${choice##* }
name=${choice#??}
name=${name%%  ·  *}

# Connecting and disconnecting register no stop command, deliberately.  Both
# waits are bounded by bluetoothd (a cached link key is one or two seconds, and
# the controller gives up on its own), and the only honest cancel is
# `bluetoothctl disconnect <mac>` - the opposite action, which would drop a link
# that may already be up by the time the click lands.  Killing the client, the
# way the Wi-Fi join does it, would leave the bar saying "Stopped Bluetooth"
# over a device that finishes pairing anyway: a few seconds of spinner is the
# lesser evil, and clicking the card says it cannot be stopped.
case $(printf '%s\n' "$(connected_devices)" | cut -f1) in
	*"$mac"*)
		"$dir/busy" start bt Bluetooth "Disconnecting ${name:-$mac}…" bluetooth
		out=$(bluetoothctl disconnect "$mac" 2>&1 || true)
		case $out in
			*'Successful disconnected'*) "$dir/busy" end bt "Disconnected ${name:-$mac}" ;;
			*'not connected'*) "$dir/busy" end bt "${name:-$mac} was not connected" ;;
			*) fail "Bluetooth: $out" ;;
		esac
		;;
	*)
		"$dir/busy" start bt Bluetooth "Connecting to ${name:-$mac}…" bluetooth
		out=$(bluetoothctl connect "$mac" 2>&1 || true)
		case $out in
			*'Connection successful'*) "$dir/busy" end bt "Connected to ${name:-$mac}" ;;
			*) fail "Bluetooth: $out" ;;
		esac
		;;
esac
