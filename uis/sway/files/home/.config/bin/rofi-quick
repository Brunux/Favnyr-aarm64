#!/bin/sh
# Quick settings: the switches and panels of the session in one list.
#
# Deboma has a Quickshell control-centre panel (Wi-Fi, Bluetooth, night light,
# do-not-disturb, media and the battery drawn as tiles).  This is the same set
# of controls as a rofi list: every row states what is on and what pressing it
# does, and it is one process for as long as the list is open.
#
# It re-draws itself after a switch, so the state in the list is never stale,
# and it leaves for the pickers and panels that already exist (bar-net,
# bar-bt, bar-audio, bar-power) instead of duplicating them.  The two radio
# switches live here as well because that is the one thing the pickers do not
# answer at a glance.
#
# Tablet mode has a second row while it is on: "Calibrate rotation" stores which
# way the accelerometer says is up, for a screen that turns the wrong way on the
# hardware (see ~/.config/bin/tablet-mode).  Both of those rows' actions notify
# with an icon from the LazyOS theme - preferences-desktop-keyboard for the mode
# and preferences-desktop-display for the rotation - so the answer to a click on
# the bar's list looks like the rest of the session's.
#
# Nothing here is a daemon: every draw reads the state from nmcli,
# bluetoothctl, swaymsg, makoctl, the night-light helper and sysfs.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

# Font Awesome 4.7 (fonts-font-awesome-legacy), the same set the bar uses; the
# codepoint is in the comment so a missing glyph is easy to trace.

# --- state -----------------------------------------------------------------

wifi_on() { [ "$(nmcli radio wifi 2>/dev/null || true)" = enabled ]; }

# The interface name, not `nmcli device wifi`: listing access points blocks
# until a scan NetworkManager had already started finishes, which is seconds,
# and this panel only needs the network it is on.  `iw dev link` is a netlink
# query with no scan behind it.
wifi_if() {
	nmcli -t -f DEVICE,TYPE device status 2>/dev/null |
		awk -F: '$2 == "wifi" { print $1; exit }'
}

ssid() {
	_if=$(wifi_if)
	[ -n "$_if" ] || return 0
	iw dev "$_if" link 2>/dev/null |
		sed -n 's/^[[:space:]]*SSID:[[:space:]]*//p' | head -1
}

wifi_detail() {
	if ! wifi_on; then
		printf 'off'
		return 0
	fi
	_s=$(ssid)
	if [ -n "$_s" ]; then
		printf '%s' "$_s"
	else
		printf 'not connected'
	fi
}

bt_on() {
	# busctl is one property read; bluetoothctl connects a whole D-Bus client
	# and asks bluez for everything, which is the slow half of this panel.
	_powered=$(busctl --system get-property org.bluez /org/bluez/hci0 \
		org.bluez.Adapter1 Powered 2>/dev/null |
		sed -n 's/^b \(true\|false\)$/\1/p')
	if [ -n "$_powered" ]; then
		[ "$_powered" = true ]
		return
	fi
	[ "$(bluetoothctl show 2>/dev/null |
		sed -n 's/^[[:space:]]*Powered:[[:space:]]*//p' | head -1)" = yes ]
}

bt_detail() {
	if ! bt_on; then
		printf 'off'
		return 0
	fi
	_n=$(bluetoothctl devices Connected 2>/dev/null | grep -c . || true)
	case ${_n:-0} in
	0) printf 'on, nothing connected' ;;
	1) printf '1 device connected' ;;
	*) printf '%s devices connected' "$_n" ;;
	esac
}

night_on() {
	case $("$dir/night-light" status 2>/dev/null || true) in
	on\ *) return 0 ;;
	*) return 1 ;;
	esac
}

dnd_on() { makoctl mode 2>/dev/null | grep -qx do-not-disturb; }

touchpad_on() {
	_v=$(swaymsg -t get_inputs -r 2>/dev/null |
		jq -r '[ .[] | select(.type == "touchpad") | .libinput.send_events ] | unique | join(" ")' 2>/dev/null || true)
	case $_v in
	*disabled*) return 1 ;;
	*) return 0 ;;
	esac
}

layout_name() {
	swaymsg -t get_inputs -r 2>/dev/null |
		jq -r '[ .[] | select(.type == "keyboard") ][0].xkb_active_layout_name // empty' 2>/dev/null |
		head -1
}

rotation_name() {
	swaymsg -t get_outputs -r 2>/dev/null |
		jq -r '[ .[] | select(.focused) ][0].transform // "normal"' 2>/dev/null |
		head -1
}

tablet_mode_detail() {
	_t=$("$dir/tablet-mode" status 2>/dev/null || true)
	printf '%s' "${_t:-off}"
}

# Auto-mount is one line in ~/.config/lazyos/automount.conf that
# /usr/local/sbin/lazyos-automount reads when a USB drive is plugged in (see
# 90-lazyos-automount.rules).  The parsing below is that helper's, on purpose: a
# row that said "on" while the helper read "no" would be a switch that lies.
# A missing file means on, which is the state a fresh card ships in.
automount_conf() {
	printf '%s/lazyos/automount.conf' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

automount_on() {
	[ "$(sed -n 's/^enabled=//p' "$(automount_conf)" 2>/dev/null | tail -1)" != no ]
}

audio_detail() {
	# One call (wireplumber's own client) instead of pactl's three.
	_v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)
	if [ -z "$_v" ]; then
		printf 'unknown'
		return 0
	fi
	case $_v in
	*MUTED*) printf 'muted' ;;
	*)
		printf '%s%%' "$(printf '%s' "$_v" |
			sed -n 's/^Volume: //p' | awk '{ printf "%d", ($1 * 100) + 0.5 }')"
		;;
	esac
}

media_detail() {
	_t=$(playerctl metadata --format '{{artist}} — {{title}}' 2>/dev/null || true)
	if [ -n "$_t" ]; then printf '%s' "$_t"; else printf 'nothing playing'; fi
}

battery_detail() {
	_c=$(cat /sys/class/power_supply/sbs-8-000b/capacity 2>/dev/null || true)
	[ -n "$_c" ] || return 0
	_s=$(cat /sys/class/power_supply/sbs-8-000b/status 2>/dev/null || true)
	printf '%s%% · %s' "$_c" "$(printf '%s' "${_s:-unknown}" | tr 'A-Z' 'a-z')"
}

# The night light is whatever the login line starts (night-light login), so
# turning it back on asks the same helper instead of keeping a second copy of
# the coordinates - with one deliberate change: the toggle forces the warm end
# of the range (-T = -t).  Reusing the sunset schedule unchanged did nothing
# when the switch was tried at 17:00, when wlsunset still has the screen at
# daylight colour, and a switch that visibly does nothing reads as a broken
# switch.
#
# The helper owns the command line and the mode, shared with the after-resume
# hook: the switch, the login line and the resume all have to agree about what
# is running, and three copies of the coordinates cannot.

# --- rotation --------------------------------------------------------------

if [ "${1:-}" = "--rotation-menu" ]; then
	_out=$(swaymsg -t get_outputs -r 2>/dev/null |
		jq -r '[ .[] | select(.focused) ][0].name // empty' 2>/dev/null | head -1)
	[ -n "$_out" ] || exit 0
	_now=$(rotation_name)
	tmp=$(mktemp "${TMPDIR:-/tmp}/rotation.XXXXXX")
	trap 'rm -f "$tmp"' EXIT
	{
		for _t in normal 90 180 270; do
			if [ "$_t" = "$_now" ]; then
				ui_row "$UI_ON" "Rotation $_t" "current · applies to $_out" "rot:$_t"
			else
				ui_row "$UI_OFF" "Rotation $_t" "applies to $_out" "rot:$_t"
			fi
		done
	} >"$tmp"
	_cmd=$(ui_pick 'Rotation' "Turn the screen: $_out" <"$tmp") || exit 0
	case $_cmd in
	rot:*)
		_t=${_cmd#rot:}
		swaymsg output "$_out" transform "$_t" >/dev/null 2>&1 || true
		# The list is gone by now, so this is the only sign that the screen
		# was asked to turn (and tablet mode's poller would turn it back on
		# the next second if the accelerometer says so - hence the wording).
		notify-send -a LazyOS -i preferences-desktop-display 'Rotation' \
			"$_out: $_t" 2>/dev/null || true
		;;
	esac
	exit 0
fi

# --- the list --------------------------------------------------------------

render() { # OUTFILE
	_s=$(mktemp -d "${TMPDIR:-/tmp}/quick.XXXXXX") || return 1

	# Six probes, six processes, joined in list order.  They used to run one
	# after another, and the panel was reported as "very slow to load": the cost
	# was the sum of a bluetoothctl (a whole D-Bus client), two nmcli calls and
	# three swaymsg round trips.  In parallel it is the slowest of them.
	(
		if wifi_on; then
			ui_row "$UI_I_WIFI" 'Wi-Fi radio' on wifi-radio "$UI_CYAN"
			ui_row "$UI_I_GLOBE" 'Wi-Fi networks' "$(wifi_detail)" wifi
		else
			ui_row "$UI_I_WIFI" 'Wi-Fi radio' off wifi-radio "$UI_DIM"
			ui_row "$UI_I_GLOBE" 'Wi-Fi networks' "$(wifi_detail)" wifi "$UI_DIM"
		fi
	) >"$_s/1" &
	(
		if bt_on; then
			ui_row "$UI_I_BT" 'Bluetooth radio' on bt-radio "$UI_BLUE"
			ui_row "$UI_I_LINK" 'Bluetooth devices' "$(bt_detail)" bt
		else
			ui_row "$UI_I_BT" 'Bluetooth radio' off bt-radio "$UI_DIM"
			ui_row "$UI_I_LINK" 'Bluetooth devices' "$(bt_detail)" bt "$UI_DIM"
		fi
	) >"$_s/2" &
	(
		if night_on; then
			ui_row "$UI_I_MOON" 'Night light' on night "$UI_YELLOW"
		else
			ui_row "$UI_I_MOON" 'Night light' off night "$UI_DIM"
		fi
		if dnd_on; then
			ui_row "$UI_I_BELL_OFF" 'Notifications' 'do not disturb' notify "$UI_YELLOW"
			ui_row "$UI_I_BELL_OFF" 'Do not disturb' on dnd "$UI_YELLOW"
		else
			ui_row "$UI_I_BELL" 'Notifications' allowed notify
			ui_row "$UI_I_BELL" 'Do not disturb' off dnd "$UI_DIM"
		fi
		# Screen sharing is a state like the radios: the row says where this
		# session is being served, and opening it is where the tunnel command
		# lives.  The probe is one file read and a `kill -0`, so it does not
		# belong to a slow group.
		_vnc=$("$dir/rofi-vnc" status 2>/dev/null || echo off)
		if [ "$_vnc" = off ]; then
			ui_row "$UI_I_EYE" 'Share this screen' "$_vnc" vnc "$UI_DIM"
		else
			ui_row "$UI_I_EYE" 'Share this screen' "$_vnc" vnc "$UI_YELLOW"
		fi
	) >"$_s/3" &
	(
		if touchpad_on; then
			_tp=enabled
			_tpc=$UI_CYAN
		else
			_tp=disabled
			_tpc=$UI_DIM
		fi
		ui_row "$UI_I_MOUSE" 'Touchpad' "$_tp" touchpad "$_tpc"
		ui_row "$UI_I_ROTATE" 'Rotation' "$(rotation_name)" rotation
		# Where the external monitor sits.  The detail is the arrangement in
		# words, answered by the menu's own --status, so the row and the menu
		# cannot disagree about it; with no monitor plugged in it says so.
		ui_row "$UI_I_DESKTOP" 'Display arrangement' \
			"$("$dir/rofi-display" --status 2>/dev/null || echo unknown)" display
		# Whether a plugged stick mounts itself.  The switch is what makes the
		# udev helper do nothing, so a card can be made quiet without editing
		# /etc/udev; the detail says which behaviour is in effect, because "off"
		# on its own reads as broken.
		if automount_on; then
			ui_row "$UI_I_DISK" 'Auto-mount USB drives' \
				'a plugged stick mounts itself' automount
		else
			ui_row "$UI_I_DISK" 'Auto-mount USB drives' \
				'off · Places mounts a stick when you pick it' automount "$UI_DIM"
		fi
		# Tablet mode is the on-screen keyboard, both physical inputs off (the
		# touchpad is on the back of the screen, and the folded keys are on the
		# table) and the accelerometer turning the screen; the row is also the
		# way in for a keyboard that is already detached and did not trigger
		# the switch.
		_tm=$(tablet_mode_detail)
		if [ "$_tm" = off ]; then
			ui_row "$UI_I_KEYBOARD" 'Tablet mode' "$_tm" tablet "$UI_DIM"
		else
			ui_row "$UI_I_KEYBOARD" 'Tablet mode' "$_tm" tablet
			# Only while it is on: calibrating reads the accelerometer in the
			# pose the person is holding, which only means something in tablet
			# mode, and the row says which mapping is in use so an upside-down
			# screen has a diagnosis as well as a fix.
			ui_row "$UI_I_ROTATE" 'Calibrate rotation' \
				"$("$dir/tablet-mode" calibration 2>/dev/null || echo unknown)" \
				tablet-calibrate "$UI_YELLOW"
		fi
		ui_row "$UI_I_KEYBOARD" 'Keyboard layout' "$(layout_name)" layout
		# The one setting this panel does not switch: what Alt+Ctrl+T
		# translates into.  The row says the current language, so the answer is
		# on screen without opening the menu, and the menu is where the how-to
		# lives (a key with no row is a key nobody finds).
		ui_row "$UI_I_GLOBE" 'Translate' \
			"into $("$dir/translate" --target-name 2>/dev/null || echo English)" \
			translate
	) >"$_s/4" &
	(
		ui_row "$UI_I_VOLUME" 'Audio output' "$(audio_detail)" audio
		# The bar's panel picks the output; this is the other question (which
		# application is making the sound, and where does it go), which is
		# pavucontrol's window and nothing this menu can draw.
		ui_row "$UI_I_MIXER" 'Volume per application' 'pavucontrol' mixer
		ui_row "$UI_I_MUSIC" 'Media' "$(media_detail)" media
	) >"$_s/5" &
	(
		ui_row "$UI_I_BATTERY" 'Battery' "$(battery_detail)" power
	) >"$_s/6" &

	wait || true
	cat "$_s/1" "$_s/2" "$_s/3" "$_s/4" "$_s/5" "$_s/6" >"$1"
	rm -rf "$_s"
}

tmp=$(mktemp "${TMPDIR:-/tmp}/quick.XXXXXX")
trap 'rm -f "$tmp"' EXIT

while :; do
	render "$tmp"
	key=$(ui_pick 'Settings' 'Enter switches or opens · Escape closes' <"$tmp") || exit 0
	case $key in
	wifi-radio)
		if wifi_on; then
			"$dir/busy" start wifi Wi-Fi 'Turning the radio off…' network-wireless
			if nmcli radio wifi off >/dev/null 2>&1; then
				"$dir/busy" end wifi 'Wi-Fi off'
			else
				"$dir/busy" fail wifi 'Could not turn the radio off'
			fi
		else
			"$dir/busy" start wifi Wi-Fi 'Turning the radio on…' network-wireless
			if nmcli radio wifi on >/dev/null 2>&1; then
				"$dir/busy" end wifi 'Wi-Fi on'
			else
				"$dir/busy" fail wifi 'Could not turn the radio on'
			fi
		fi
		;;
	bt-radio)
		if bt_on; then
			"$dir/busy" start bt Bluetooth 'Powering the controller off…' bluetooth
			if bluetoothctl power off >/dev/null 2>&1; then
				"$dir/busy" end bt 'Bluetooth off'
			else
				"$dir/busy" fail bt 'Could not power the controller off'
			fi
		else
			"$dir/busy" start bt Bluetooth 'Powering the controller on…' bluetooth
			if bluetoothctl power on >/dev/null 2>&1; then
				"$dir/busy" end bt 'Bluetooth on'
			else
				"$dir/busy" fail bt 'Could not power the controller on'
			fi
		fi
		;;
	wifi) exec "$dir/bar-net" ;;
	bt) exec "$dir/bar-bt" ;;
	night)
		if night_on; then
			"$dir/night-light" stop
		else
			"$dir/night-light" start
		fi
		;;
	dnd) makoctl mode -t do-not-disturb >/dev/null 2>&1 || true ;;
	notify) exec "$dir/rofi-notify" ;;
	vnc) exec "$dir/rofi-vnc" ;;
	touchpad) swaymsg input type:touchpad events toggle >/dev/null 2>&1 || true ;;
	rotation) exec "$dir/rofi-quick" --rotation-menu ;;
	display) exec "$dir/rofi-display" ;;
	automount)
		_conf=$(automount_conf)
		if automount_on; then
			_value=no
			_word='off · Places mounts a stick when you pick it'
		else
			_value=yes
			_word='on · a plugged USB drive mounts itself'
		fi
		# Write to a temporary file beside it and rename: the root helper reads
		# this file from a udev event, and a half-written line would read as
		# "enabled=" (which is not "no", so it would mean on).
		if mkdir -p "$(dirname -- "$_conf")" 2>/dev/null &&
			printf 'enabled=%s\n' "$_value" >"$_conf.part" 2>/dev/null &&
			mv -f "$_conf.part" "$_conf" 2>/dev/null; then
			ui_say 'Auto-mount' "USB drives: $_word" normal drive-harddisk
		else
			rm -f "$_conf.part" 2>/dev/null || true
			ui_say 'Auto-mount' "Could not write $_conf" critical dialog-error
		fi
		;;
	tablet) "$dir/tablet-mode" toggle ;;
	tablet-calibrate) "$dir/tablet-mode" calibrate || true ;;
	layout) exec "$dir/rofi-layout" ;;
	translate) "$dir/translate" config ;;
	audio) exec "$dir/bar-audio" ;;
	mixer) exec pavucontrol ;;
	media) exec "$dir/rofi-media" ;;
	power) exec "$dir/bar-power" ;;
	*) exit 0 ;;
	esac
done
