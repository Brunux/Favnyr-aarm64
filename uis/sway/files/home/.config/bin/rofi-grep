#!/bin/sh
# Search inside files: ripgrep over $HOME, and the match opens where it is.
#
# The Search key (rofi-files --search) finds a file by its *name*; this finds the
# line inside it, which is the other half of the same question.  One free-text
# prompt, one rg run over $HOME, one row per match - and the row shows the text,
# because the text is what tells the matches apart, with the file and the line
# number as the dim detail.
#
# The search is bounded on purpose, because a home directory is not a repository:
# three matches per file (`--max-count 3` - a file that says "error" forty times
# is one row of context and thirty-nine of noise), the same four trees the other
# searches skip (.cache alone is 330k of the 350k files in this home), binary
# files dropped by rg itself, and the rows capped at 400.
#
# Enter opens the file in bat, scrolled to the match.  bat colours the line
# (`--highlight-line N`) but its own pager always starts at the top, so bat
# writes the page to a real file and `less -R +N` opens *that file* at the
# line: less cannot seek a pipe, and piping bat into it answered "Cannot seek
# to line number N" and left the match below the screen.  -R keeps the colours
# bat wrote, and the file is removed when less exits.  The window is a `popup`
# foot, the same one rofi-files reads a text file in.
#
# The walk is a `busy` card with a stop button, like the dictation and the Wi-Fi
# scan: on this machine the unfiltered tree costs 1.6 s of walk, and on a home
# with a build directory in it, much more.
set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

MAX_ROWS=400
tmp=$(mktemp -d "${TMPDIR:-/tmp}/grep.XXXXXX")
# The page less reads lives outside $tmp: this trap removes $tmp when the
# script exits, which happens before foot's child has read the page. The child
# removes its own file, and this trap only covers a foot that never started.
trap 'rm -rf "$tmp"; rm -f "${view:-}"' EXIT

have() { command -v "$1" >/dev/null 2>&1; }

have rg || {
	ui_say 'Search inside files' \
		'ripgrep is not installed (package ripgrep)' critical "$UI_ICON_ERROR"
	exit 1
}

query=$("$dir/bar-pick" 'Search inside files' -free) || exit 0
query=$(printf '%s' "${query:-}" | tr -d '\r\n' |
	sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
[ -n "$query" ] || exit 0

# The stop line names the one rg run this menu starts, and the bracketed pattern
# cannot match the `sh -c` line that runs it.
BUSY_STOP='pkill -f "[r]g --line-number"' \
	"$dir/busy" start grep 'Search inside files' \
	"Looking for $(ui_trim "$query" 48)…" "$UI_ICON_SEARCH"

rc=0
rg --line-number --no-heading --color never --max-count 3 --max-columns 200 \
	--glob '!.cache' --glob '!.git' --glob '!node_modules' \
	--glob '!.local/share/containers' \
	-- "$query" "$HOME" >"$tmp/hits" 2>"$tmp/err" || rc=$?

# rg's status is 1 for "no match", which is an answer; the card is asked first
# so a killed walk never reads as "nothing matches".
if "$dir/busy" cancelled grep; then
	exit 0
fi
"$dir/busy" stop grep

case $rc in
0) ;;
1)
	ui_say 'Search inside files' "Nothing matches \"$query\"" normal "$UI_ICON_SEARCH"
	exit 0
	;;
*)
	ui_say 'Search inside files' \
		"$(head -n 2 "$tmp/err" 2>/dev/null | tr '\n' ' ')" critical "$UI_ICON_ERROR"
	exit 1
	;;
esac

total=$(wc -l <"$tmp/hits")
: >"$tmp/rows"
head -n "$MAX_ROWS" "$tmp/hits" | while IFS=: read -r path line text; do
	case ${line:-} in '' | *[!0-9]*) continue ;; esac
	[ -n "${path:-}" ] || continue
	_shown=${path#"$HOME"/}
	ui_row "$UI_I_SEARCH" "$(ui_trim "${text:-}" 58)" "$_shown:$line" \
		"open:$path:$line" >>"$tmp/rows"
done

if [ "$total" -gt "$MAX_ROWS" ]; then
	mesg="$total matches · the first $MAX_ROWS are listed · type to narrow it · Enter opens the file at the line"
else
	mesg="$total match$(if [ "$total" -eq 1 ]; then :; else printf es; fi) · Enter opens the file at the line · Escape closes"
fi

choice=$(ui_pick "Matches for $query" "$mesg" <"$tmp/rows") || exit 0

case $choice in
open:*)
	# The line is after the last colon and the path is everything before it.
	# A path that itself contains a colon is not expected in a home directory.
	rest=${choice#open:}
	line=${rest##*:}
	path=${rest%:*}
	name=$(basename -- "$path")
	# bat writes the page to a real file because less cannot seek a pipe: the
	# old `bat | less +N` answered "Cannot seek to line number N" and showed
	# the top of the file instead of the match. mktemp is asked for a path
	# outside the menu's temp directory, because the EXIT trap removes that
	# one as soon as this script is replaced by foot, while less reads the page
	# afterwards; less' own shell removes this file when the window closes.
	view=$(mktemp "${TMPDIR:-/tmp}/lazyos-grep.XXXXXX") || {
		ui_say 'Search inside files' 'Could not create a temporary file' \
			critical "$UI_ICON_ERROR"
		exit 1
	}
	BAT_THEME=ansi bat --color=always --style=numbers --paging=never \
		--highlight-line "$line" --file-name "$name" -- "$path" >"$view" || {
		rm -f "$view"
		ui_say 'Search inside files' "Could not read $name" \
			critical "$UI_ICON_ERROR"
		exit 1
	}
	# $1 is the line, $2 the file less reads (and removes).
	exec foot --app-id=popup --title="$name:$line" -e sh -c '
		less -R "+$1" "$2"; rm -f "$2"' sh "$line" "$view"
	;;
esac
