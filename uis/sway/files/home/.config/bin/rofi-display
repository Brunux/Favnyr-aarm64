#!/bin/sh
# Arrange the external monitor: where it sits in the desktop, and the manual
# escape hatch (wdisplays).
#
# sway's own command is the whole engine - `output <name> position <x> <y>` -
# and the panel is never moved: the monitor is placed relative to it.  That is
# why "on the left" is a negative x (measured: DP-1 at -1920,0 with eDP-1 at
# 0,0 renders both correctly, and the panel keeps its own workspace when the
# monitor is unplugged).  A negative coordinate needs `swaymsg --`, or swaymsg's
# option parser eats it ("invalid option -- '1'"), which is why every position
# below goes through that form.
#
# The bridge's connector is DP-*; the internal panel is the DSI one (eDP-*).
#
# A runtime position does not survive a logout, so every arrangement is also
# written to ~/.config/sway/config.d/40-display.conf, which the session's
# ~/.config/sway/config includes.  Only the monitor's lines are written - it is
# the output that can be absent, so a boot without it is untouched - and
# disabling a screen is deliberately *not* written: a "monitor only" in the
# config would boot a card with no display at all.
#
# wdisplays is the manual half: a GTK3 window with the outputs as rectangles to
# drag, over the same wlr-output-management protocol swayfx advertises
# (verified: wlr-randr speaks it here).  It is a package (188 kB, every
# dependency already in the image) and a row in this menu, not a second
# mechanism.  The two rectangles are the point and they need the width, so it
# opens on a workspace of its own (11 - the session's keys stop at 10) instead
# of being tiled into whatever is on screen.
set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

file="$HOME/.config/sway/config.d/40-display.conf"

# The panel's and the monitor's rectangle, scale and mode, read once into
# globals.  A here-document instead of a pipe: dash runs a pipeline's left side
# in a subshell and the variables would be gone when it ends.
read_outputs() {
	mon= panel=
	monx=0 mony=0 monw=0 monh=0 mons=1 monmode= monrate=0 monact=false
	px=0 py=0 pw=0 ph=0 pact=false
	while read -r _n _x _y _w _h _s _mw _mh _mr _act; do
		case $_n in
		DP-*)
			mon=$_n monx=$_x mony=$_y monw=$_w monh=$_h
			mons=$_s monmode="${_mw}x${_mh}" monrate=$_mr monact=$_act
			;;
		eDP-*)
			panel=$_n px=$_x py=$_y pw=$_w ph=$_h pact=$_act
			;;
		esac
	done <<EOF
$(swaymsg -t get_outputs -r 2>/dev/null |
	jq -r '.[] | "\(.name) \(.rect.x) \(.rect.y) \(.rect.width) \(.rect.height) \(.scale) \(.current_mode.width // 0) \(.current_mode.height // 0) \(.current_mode.refresh // 0) \(.active)"' 2>/dev/null)
EOF
}

# A refresh is reported in mHz; sway wants Hz and %g drops the trailing 0 of
# "60.00" while keeping 59.94 as it is.
hz() { awk -v r="${1:-0}" 'BEGIN { printf "%g", r / 1000 }'; }

# Which of the rows is the current one.  Empty when there is nothing to compare
# (no monitor, or one of the two screens is off).
arrangement() {
	[ -n "$mon" ] && [ "$monact" = true ] && [ "$pact" = true ] || return 0
	if [ "$mony" -eq "$py" ] && [ "$monx" -eq "$px" ]; then
		printf mirror
	elif [ "$mony" -eq "$py" ] && [ "$monx" -eq $((px + pw)) ]; then
		printf right
	elif [ "$mony" -eq "$py" ] && [ $((monx + monw)) -eq "$px" ]; then
		printf left
	elif [ "$monx" -eq "$px" ] && [ $((mony + monh)) -eq "$py" ]; then
		printf above
	elif [ "$monx" -eq "$px" ] && [ "$mony" -eq $((py + ph)) ]; then
		printf below
	else
		printf custom
	fi
}

apply_arrangement() {
	case ${1:-} in
	right) _x=$((px + pw)); _y=$py ;;
	left) _x=$((px - monw)); _y=$py ;;
	above) _x=$px; _y=$((py - monh)) ;;
	below) _x=$px; _y=$((py + ph)) ;;
	mirror) _x=$px; _y=$py ;;
	*) return 1 ;;
	esac
	swaymsg -- output "$mon" position "$_x" "$_y" >/dev/null 2>&1
}

# The arrangement the next login starts with: the monitor's mode, scale and
# position, read back from the live state so a change to one of them never
# leaves the other two stale in the file.
save() {
	[ -n "$mon" ] && [ "$monact" = true ] || return 0
	read_outputs
	mkdir -p "${file%/*}"
	_tmp="$file.tmp.$$"
	{
		printf '# Written by ~/.config/bin/rofi-display (Settings -> Display arrangement).\n'
		printf '# The monitor is the output that can be absent, so a boot without it is\n'
		printf '# untouched.  Delete this file to go back to sway default (on the right).\n'
		printf 'output %s resolution %sx%s@%sHz\n' \
			"$mon" "${monmode%x*}" "${monmode#*x}" "$(hz "$monrate")"
		printf 'output %s scale %s\n' "$mon" "$mons"
		printf 'output %s position %s %s\n' "$mon" "$monx" "$mony"
	} >"$_tmp" && mv "$_tmp" "$file"
}

read_outputs

# --- the single copy of the state, for whoever asks ------------------------
if [ "${1:-}" = "--status" ]; then
	if [ -z "$mon" ]; then
		printf 'no external monitor\n'
	elif [ "$monact" != true ]; then
		printf 'monitor disabled\n'
	elif [ "$pact" != true ]; then
		printf 'monitor only\n'
	else
		case $(arrangement) in
		right) printf 'right of the panel\n' ;;
		left) printf 'left of the panel\n' ;;
		above) printf 'above the panel\n' ;;
		below) printf 'below the panel\n' ;;
		mirror) printf 'mirrored\n' ;;
		*) printf 'custom position\n' ;;
		esac
	fi
	exit 0
fi

# --- resolution -----------------------------------------------------------
# Every mode the monitor reports, deduplicated (the EDID repeats 1920x1080 for
# each variant it offers), the current one marked.  Changing it changes the
# monitor's logical size, so the arrangement is re-applied afterwards or a
# "monitor on the left" would leave a gap.
if [ "${1:-}" = "--resolution-menu" ]; then
	[ -n "$mon" ] && [ "$monact" = true ] || exit 0
	_now="${monmode}@$(hz "$monrate")"
	tmp=$(mktemp "${TMPDIR:-/tmp}/display-res.XXXXXX")
	trap 'rm -f "$tmp"' EXIT
	{
		swaymsg -t get_outputs -r 2>/dev/null |
			jq -r --arg o "$mon" '.[] | select(.name==$o) |
				.modes[] | "\(.width)x\(.height)@\(.refresh / 1000)"' 2>/dev/null |
			awk '!seen[$0]++' |
			while IFS= read -r _m; do
				[ -n "$_m" ] || continue
				if [ "$_m" = "$_now" ]; then
					ui_row "$UI_ON" "${_m%@*}" "@${_m#*@} Hz · current" "res:$_m"
				else
					ui_row "$UI_OFF" "${_m%@*}" "@${_m#*@} Hz" "res:$_m" "$UI_DIM"
				fi
			done
	} >"$tmp"
	_key=$(ui_pick 'Resolution' "$mon · Enter applies · Escape closes" <"$tmp") || exit 0
	case $_key in
	res:*)
		_m=${_key#res:}
		_was=$(arrangement)
		swaymsg output "$mon" resolution "${_m%@*}@${_m#*@}Hz" >/dev/null 2>&1 || true
		read_outputs
		case $_was in right | left | above | below | mirror) apply_arrangement "$_was" || true ;; esac
		save
		;;
	esac
	exit 0
fi

# --- scale ----------------------------------------------------------------
# Integer scaling is crisp, fractional is not (sway says so itself), so the
# list offers both and the row says which is in use.
if [ "${1:-}" = "--scale-menu" ]; then
	[ -n "$mon" ] && [ "$monact" = true ] || exit 0
	_now=$(awk -v s="$mons" 'BEGIN { printf "%g", s }')
	tmp=$(mktemp "${TMPDIR:-/tmp}/display-scale.XXXXXX")
	trap 'rm -f "$tmp"' EXIT
	{
		for _s in 1 1.25 1.5 1.75 2; do
			if [ "$_s" = "$_now" ]; then
				ui_row "$UI_ON" "Scale $_s" 'current' "scale:$_s"
			else
				case $_s in
				1 | 2) _d='integer · crisp' ;;
				*) _d='fractional · slightly blurred' ;;
				esac
				ui_row "$UI_OFF" "Scale $_s" "$_d" "scale:$_s" "$UI_DIM"
			fi
		done
	} >"$tmp"
	_key=$(ui_pick 'Scale' "$mon · Enter applies · Escape closes" <"$tmp") || exit 0
	case $_key in
	scale:*)
		_s=${_key#scale:}
		_was=$(arrangement)
		swaymsg output "$mon" scale "$_s" >/dev/null 2>&1 || true
		read_outputs
		case $_was in right | left | above | below | mirror) apply_arrangement "$_was" || true ;; esac
		save
		;;
	esac
	exit 0
fi

# --- the manual window ----------------------------------------------------
# A workspace of its own, then the window: a second copy would show the same two
# rectangles, so an open one is focused instead of starting another.
if [ "${1:-}" = "--wdisplays" ]; then
	if ! command -v wdisplays >/dev/null 2>&1; then
		ui_say 'Display' 'wdisplays is not installed (apt install wdisplays)' \
			critical "$UI_ICON_ERROR"
		exit 1
	fi
	if pgrep -x wdisplays >/dev/null 2>&1; then
		swaymsg '[app_id="wdisplays"] focus' >/dev/null 2>&1 || true
		exit 0
	fi
	swaymsg workspace number 11 >/dev/null 2>&1 || true
	exec wdisplays
fi

# --- the menu -------------------------------------------------------------
tmp=$(mktemp "${TMPDIR:-/tmp}/display.XXXXXX")
trap 'rm -f "$tmp"' EXIT

if [ -z "$mon" ]; then
	{
		ui_note 'No external monitor' 'plug one into a USB-C port'
		ui_heading 'Manual'
		ui_row "$UI_I_MOUSE" 'Open wdisplays' 'arrange by dragging' wd
	} >"$tmp"
else
	cur=$(arrangement)
	{
		if [ "$monact" = true ] && [ "$pact" = true ]; then
			ui_heading 'Arrangement'
			for _a in right left above below mirror; do
				case $_a in
				right) _n='Monitor on the right'; _h='panel | monitor' ;;
				left) _n='Monitor on the left'; _h='monitor | panel' ;;
				above) _n='Monitor above'; _h='monitor over the panel' ;;
				below) _n='Monitor below'; _h='monitor under the panel' ;;
				mirror) _n='Mirrored'; _h='both show the same picture' ;;
				esac
				if [ "$cur" = "$_a" ]; then
					ui_row "$UI_ON" "$_n" 'current' "pos:$_a"
				else
					ui_row "$UI_OFF" "$_n" "$_h" "pos:$_a" "$UI_DIM"
				fi
			done
		fi
		ui_heading 'One screen'
		# Deliberately not saved: see the header.  The row says how to come
		# back, because the notification is the only place that can.
		if [ "$pact" = true ]; then
			ui_row "$UI_I_DESKTOP" 'Only the monitor' 'internal panel off · not remembered' mono:monitor "$UI_DIM"
		else
			ui_row "$UI_I_DESKTOP" 'Bring the internal panel back' "$panel enable" enable:panel "$UI_YELLOW"
		fi
		if [ "$monact" = true ]; then
			ui_row "$UI_I_DESKTOP" 'Only the internal panel' "$mon off · not remembered" mono:panel "$UI_DIM"
		else
			ui_row "$UI_I_DESKTOP" 'Bring the monitor back' "$mon enable" enable:monitor "$UI_YELLOW"
		fi
		if [ "$monact" = true ]; then
			ui_heading 'The monitor'
			ui_row "$UI_I_WINDOW" 'Resolution' "${monmode} @ $(hz "$monrate") Hz" res
			ui_row "$UI_I_SEARCH" 'Scale' "$mons" scale
		fi
		ui_heading 'Manual'
		ui_row "$UI_I_MOUSE" 'Open wdisplays' 'drag the rectangles' wd
		ui_note 'Saved for the next login' "${file#"$HOME"/}"
	} >"$tmp"
fi

key=$(ui_pick 'Display' 'Enter applies · Escape closes' <"$tmp") || exit 0

case $key in
pos:*)
	if apply_arrangement "${key#pos:}"; then
		save
	else
		ui_say 'Display' "Could not place $mon" critical "$UI_ICON_ERROR"
	fi
	;;
mono:monitor)
	swaymsg output "$panel" disable >/dev/null 2>&1 ||
		ui_say 'Display' "Could not turn $panel off" critical "$UI_ICON_ERROR"
	ui_say 'Display' "Only $mon. Bring the panel back with: swaymsg output $panel enable" \
		normal "$UI_ICON_INFO"
	;;
mono:panel)
	swaymsg output "$mon" disable >/dev/null 2>&1 ||
		ui_say 'Display' "Could not turn $mon off" critical "$UI_ICON_ERROR"
	ui_say 'Display' "Only $panel. Bring the monitor back with: swaymsg output $mon enable" \
		normal "$UI_ICON_INFO"
	;;
enable:panel)
	swaymsg output "$panel" enable >/dev/null 2>&1 || true
	;;
enable:monitor)
	swaymsg output "$mon" enable >/dev/null 2>&1 || true
	;;
wd) exec "$dir/rofi-display" --wdisplays ;;
res) exec "$dir/rofi-display" --resolution-menu ;;
scale) exec "$dir/rofi-display" --scale-menu ;;
esac
