#!/bin/sh
# Audio output picker behind the bar's volume indicator.
#
# Deboma's audio plugin lists the sinks (speakers, headphones, a Bluetooth
# headset) and switches the default one on click; volume and mute live on the
# indicator itself.  Here the indicator is waybar's own `pulseaudio` module
# (scroll = volume, left click = mute), and this script is its right click:
# the sink list, plus the two mutes.  One rofi + one pactl per click, nothing
# resident.
#
# Switching the default sink also moves the streams that are already playing,
# which is what makes a Bluetooth headset take over mid-song.

set -eu

dir=$(dirname "$0")
tab=$(printf '\t')

fail() { swaynag -t warning -m "$*" -b Close >/dev/null 2>&1 & }

default=$(pactl get-default-sink 2>/dev/null || true)

# default-flag <TAB> sink-name <TAB> description
sinks=$(
	pactl list sinks 2>/dev/null | awk -v def="$default" -v tab="$tab" '
		/^[[:space:]]*Name: /{ name = $2; next }
		/^[[:space:]]*Description: /{
			sub(/^[[:space:]]*Description:[[:space:]]*/, "")
			if (name != "") printf "%d%s%s%s%s\n", (name == def ? 1 : 0), tab, name, tab, $0
			name = ""
		}' |
		sort -t "$tab" -k1,1nr
)

menu=$(
	printf '%s\n' "$sinks" |
		awk -F"$tab" 'NF >= 3 { printf "%s%s\n", ($1 == 1 ? "* " : "  "), $3 }'
)
[ -n "$menu" ] || menu='No audio outputs'

choice=$(
	printf '%s\n' "$menu" 'Mute / unmute output' 'Mute / unmute microphone' |
		"$dir/bar-pick" 'Audio output'
) || exit 0

case $choice in
	'') exit 0 ;;
	'No audio outputs') exit 0 ;;
	'Mute / unmute output')
		pactl set-sink-mute @DEFAULT_SINK@ toggle || fail 'Audio: could not toggle the sink mute'
		;;
	'Mute / unmute microphone')
		pactl set-source-mute @DEFAULT_SOURCE@ toggle || fail 'Audio: could not toggle the source mute'
		;;
	*)
		desc=${choice#??}
		name=$(
			printf '%s\n' "$sinks" |
				awk -F"$tab" -v want="$desc" '$3 == want { print $2; exit }'
		)
		[ -n "$name" ] || exit 0
		pactl set-default-sink "$name" || { fail "Audio: could not switch to $desc"; exit 0; }
		for id in $(pactl list short sink-inputs | cut -f1); do
			pactl move-sink-input "$id" "$name" >/dev/null 2>&1 || true
		done
		;;
esac

pkill -RTMIN+8 waybar 2>/dev/null || true
