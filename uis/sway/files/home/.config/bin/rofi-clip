#!/bin/sh
# Clipboard history: what was copied, back on the clipboard in one pick.
#
# `cliphist` keeps the history that `wl-paste --watch cliphist store` feeds it
# (`/etc/sway/config.d/27-clipboard.conf` starts it once per session), and this is
# the list over it: Enter copies an entry back, Alt+1 deletes that entry, and the
# footer rows wipe the history or save the newest image to ~/Pictures/clipboard.
#
# It is Omarchy's clipboard panel (`omarchy.clipboard`) without the QML grid: the
# rows are one line each, because a rofi row cannot be a thumbnail.  Images are
# listed by cliphist as `[[ binary data 1234 png 640x480 ]]`, and the pixels are
# not in the preview - decoding one is what "save the newest image" does.
#
# A row is one line and rofi does not scroll it sideways, so an entry longer than
# the list is cut there with an ellipsis; the notification that confirms the copy
# prints the whole entry, because this list is the index of the history and not
# the text itself.
#
# cliphist is the one resident process this session has apart from the
# compositor's own daemons: about 2 MB, and it is what makes a history possible
# at all (wl-clipboard alone only knows the current selection).

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

if ! command -v cliphist >/dev/null 2>&1; then
	ui_say Clipboard 'cliphist is not installed, so there is no history' critical
	exit 1
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/clip.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

# The raw list is both what the rows are drawn from and what `cliphist delete`
# wants back on stdin, so it is saved once and never re-queried (the history can
# change under a menu that is open).
cliphist list >"$tmp/data" 2>/dev/null || : >"$tmp/data"
count=$(grep -c . "$tmp/data" 2>/dev/null || true)
image_line=$(awk -F'\t' '$2 ~ /^\[\[ binary data/ { print; exit }' "$tmp/data")

{
	if [ "${count:-0}" -eq 0 ]; then
		ui_note 'Nothing has been copied yet' 'The history fills as you copy things'
	else
		while IFS=$(printf '\t') read -r id preview; do
			[ -n "$id" ] || continue
			case $preview in
			"[[ binary data"*)
				glyph=$UI_I_IMAGE
				kind=image
				;;
			http://* | https://*)
				glyph=$UI_I_LINK
				kind=link
				;;
			*)
				glyph=$UI_I_CLIPBOARD
				kind=text
				;;
			esac
			# The row is one line: a long entry is cut here, at the width the
			# wide window holds (this is the name column, which ui_row does not
			# shorten), and the ellipsis says so.  58 characters is what a bold
			# column holds next to the four-column kind in the 62% window (see
			# UI_DETAIL_MAX in lib-rofi.sh for the measurement).  The whole entry
			# is what the notification on selection prints, so nothing is lost -
			# this list is the index, not the text.
			shown=$(printf '%s' "$preview" | cut -c1-58)
			[ "$shown" = "$preview" ] || shown="$shown…"
			ui_row "$glyph" "${shown:-empty}" "$kind" "id:$id"
		done <"$tmp/data"
	fi
	ui_heading 'history'
	[ -n "$image_line" ] && ui_row "$UI_I_IMAGE" 'Save the newest image' \
		'to ~/Pictures/clipboard and open it' save "$UI_DIM"
	ui_row "$UI_I_TRASH" 'Clear the history' 'every entry' wipe "$UI_DIM"
} >"$tmp/rows"

key=$(ui_pick_alt 'Clipboard' 'Enter copies back · Alt+1 deletes that entry · Escape closes' \
	'Alt+1 delete' <"$tmp/rows") || exit 0
[ -n "$key" ] || exit 0

case $key in
alt:id:*)
	id=${key#alt:id:}
	if awk -F'\t' -v i="$id" '$1 == i { print; exit }' "$tmp/data" |
		cliphist delete >/dev/null 2>&1; then
		ui_say Clipboard 'Entry deleted from the history' normal "$UI_ICON_TRASH"
	else
		ui_say Clipboard 'Could not delete that entry' critical "$UI_ICON_ERROR"
	fi
	;;
id:*)
	id=${key#id:}
	preview=$(awk -F'\t' -v i="$id" '$1 == i { print $2; exit }' "$tmp/data")
	# The row showed the entry cut to one line; this is where all of it is
	# printed, so the notification is the way to read an entry without pasting it
	# somewhere first.  Newlines and tabs become spaces (the card is 140 px high,
	# and a notification body is one paragraph), the text itself is not shortened:
	# mako clips what does not fit on screen, and its history keeps the whole
	# thing for rofi-notify.
	shown=$(printf '%s' "$preview" | tr '\n\t' '  ')
	if cliphist decode "$id" 2>/dev/null | wl-copy 2>/dev/null; then
		case $preview in
		"[[ binary data"*)
			ui_say Clipboard 'Image copied back to the clipboard' normal "$UI_ICON_IMAGE"
			;;
		*) ui_say Clipboard "Copied: ${shown:-entry}" normal "$UI_ICON_CLIP" ;;
		esac
	else
		ui_say Clipboard 'Could not copy that entry back' critical "$UI_ICON_ERROR"
	fi
	;;
save)
	id=$(printf '%s' "$image_line" | cut -f1)
	cliphist decode "$id" >"$tmp/image" 2>/dev/null || : >"$tmp/image"
	if [ ! -s "$tmp/image" ]; then
		ui_say Clipboard 'That image could not be decoded' critical "$UI_ICON_ERROR"
		exit 1
	fi
	ext=$(file --brief --mime-type "$tmp/image" 2>/dev/null | sed 's|.*/||; s|jpeg|jpg|; s|[^a-z0-9]||g')
	[ -n "$ext" ] || ext=bin
	mkdir -p "$HOME/Pictures/clipboard"
	dest="$HOME/Pictures/clipboard/clip-$(date +%Y%m%d-%H%M%S).$ext"
	mv -f "$tmp/image" "$dest"
	setsid xdg-open "$dest" >/dev/null 2>&1 &
	ui_say Clipboard "Saved to ${dest#"$HOME"/}" normal "$UI_ICON_FOLDER"
	;;
wipe)
	cliphist wipe >/dev/null 2>&1 || true
	ui_say Clipboard "History cleared ($count entries)" normal "$UI_ICON_TRASH"
	;;
esac
