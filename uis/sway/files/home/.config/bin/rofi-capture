#!/bin/sh
# Capture: screenshots, the text or the QR code inside one, and recording.
#
# Deboma's capture menu is a Quickshell panel; here it is a rofi list over tools
# the image already has.  Every row is one command that ends before the list is
# closed again: grimshot takes the picture (screen, area or window, saved under
# ~/Pictures and named in a notification), swappy annotates one, tesseract reads
# the text out of a region and zbarimg reads a QR or barcode out of one.  Both
# of those copy the result to the clipboard and say so.
#
# Recording is the exception on purpose: wf-recorder keeps running after the
# menu closes, so it is started here, announced on the bar and in a mako card,
# and stopped by opening this same menu again.  Its pid and file name live in
# $XDG_RUNTIME_DIR, so a session that dies takes the state with it and a killed
# recorder is not remembered; the file it was writing stays, because that is the
# point of recording.
#
# There is no audio track: that needs a PipeWire monitor source, and nothing in
# this image wires one.  `wf-recorder -a` would record the microphone instead.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

state=${XDG_RUNTIME_DIR:-/tmp}/nureb-capture
mkdir -p "$state" 2>/dev/null || true

rec_pid=$state/recording.pid
rec_file=$state/recording.file

recording() {
	[ -s "$rec_pid" ] || return 1
	kill -0 "$(cat "$rec_pid")" 2>/dev/null
}

# --- screenshots -----------------------------------------------------------

# grimshot writes the file itself and prints its path; `-n` makes it announce
# where it went, which is also how a screenshot is found again (the
# notification carries the image).
screenshot() { # ACTION TARGET
	grimshot -n "$1" "$2" || ui_say Capture 'Nothing was captured' critical
}

# Annotate: grimshot saves the region, swappy opens it in a window and writes
# the edits back over the same file.  It exits only when that window closes, so
# the notification that follows is the confirmation.
annotate() {
	_path=$(grimshot save area) || exit 0
	[ -n "$_path" ] || exit 0
	swappy -f "$_path" || true
	if [ -s "$_path" ]; then
		ui_say Capture "Saved $(basename "$_path")"
	else
		ui_say Capture 'The annotation was not saved' critical
	fi
}

# One region, read by tesseract or by zbarimg.  Both take a file, so the image
# goes to a temporary directory that the trap removes on every exit path.
region_image() { # OUTFILE
	_geom=$(slurp -d) || return 1
	[ -n "$_geom" ] || return 1
	grim -g "$_geom" "$1" 2>/dev/null
}

ocr() {
	_tmp=$(mktemp -d "${TMPDIR:-/tmp}/capture.XXXXXX") || exit 1
	if ! region_image "$_tmp/shot.png"; then
		rm -rf "$_tmp"
		exit 0
	fi
	_text=$(tesseract "$_tmp/shot.png" stdout -l eng 2>/dev/null |
		sed -e 's/[[:space:]]*$//' -e '/^$/d') || true
	rm -rf "$_tmp"
	if [ -z "$_text" ]; then
		ui_say 'Text from the screen' 'No text was found in that region'
		exit 0
	fi
	ui_copy "$_text" "Text copied · $(printf '%s' "$_text" | head -1 | cut -c1-60)"
}

scan_qr() {
	_tmp=$(mktemp -d "${TMPDIR:-/tmp}/capture.XXXXXX") || exit 1
	if ! region_image "$_tmp/shot.png"; then
		rm -rf "$_tmp"
		exit 0
	fi
	_code=$(zbarimg -q --raw "$_tmp/shot.png" 2>/dev/null) || true
	rm -rf "$_tmp"
	if [ -z "$_code" ]; then
		ui_say 'QR code from the screen' 'No code was found in that region'
		exit 0
	fi
	ui_copy "$_code" "Copied · $(printf '%s' "$_code" | head -1 | cut -c1-60)"
}

# --- recording -------------------------------------------------------------

# x264 on the CPU: this SoC has no hardware encoder, so the encoder flags matter.
# veryfast at crf 28 and half the panel's refresh rate is where a full-screen
# recording stays usable on four cores; anything slower steals the frame budget
# from the compositor.
start_recording() { # [GEOMETRY]
	if recording; then
		ui_say Capture 'A recording is already running'
		return 0
	fi
	_geom=${1:-}
	mkdir -p "$HOME/Videos" || exit 1
	_file=$HOME/Videos/nureb-$(date +%Y%m%d-%H%M%S).mp4
	if [ -n "$_geom" ]; then
		setsid wf-recorder -c libx264 -p preset=veryfast -p crf=28 -r 30 \
			-g "$_geom" -f "$_file" >"$state/recorder.log" 2>&1 &
	else
		setsid wf-recorder -c libx264 -p preset=veryfast -p crf=28 -r 30 \
			-f "$_file" >"$state/recorder.log" 2>&1 &
	fi
	_pid=$!
	printf '%s\n' "$_pid" >"$rec_pid"
	printf '%s\n' "$_file" >"$rec_file"

	# wf-recorder gives up immediately when the encoder or the capture format is
	# wrong, and a notification that says nothing would look like a start.
	sleep 1
	if ! kill -0 "$_pid" 2>/dev/null; then
		rm -f "$rec_pid" "$rec_file"
		ui_say Capture "Recording did not start: $(tail -n 2 "$state/recorder.log" 2>/dev/null | tr '\n' ' ')" critical
		return 1
	fi
	"$dir/busy" start record Recording \
		"Capturing to $(basename "$_file") · Alt+Ctrl+C stops it" media-record
}

stop_recording() {
	if ! recording; then
		ui_say Capture 'Nothing is being recorded'
		rm -f "$rec_pid" "$rec_file"
		return 0
	fi
	_pid=$(cat "$rec_pid")
	_file=$(cat "$rec_file")
	# SIGINT is how wf-recorder finalises the container; a recorder that ignores
	# it is terminated, and the file is then very likely unplayable - which the
	# size test below reports instead of claiming success.
	kill -INT "$_pid" 2>/dev/null || true
	_n=0
	while kill -0 "$_pid" 2>/dev/null && [ "$_n" -lt 50 ]; do
		sleep 0.1
		_n=$((_n + 1))
	done
	if kill -0 "$_pid" 2>/dev/null; then
		kill -TERM "$_pid" 2>/dev/null || true
	fi
	rm -f "$rec_pid" "$rec_file"
	if [ -s "$_file" ]; then
		"$dir/busy" end record "Recording saved · $(basename "$_file")"
	else
		"$dir/busy" fail record "Recording failed · $(basename "$_file") is empty"
	fi
}

# --- the list --------------------------------------------------------------

tmp=$(mktemp "${TMPDIR:-/tmp}/capture.XXXXXX")
trap 'rm -f "$tmp"' EXIT

{
	if recording; then
		ui_heading 'recording'
		ui_row "$UI_I_STOP" 'Stop recording' "$(basename "$(cat "$rec_file" 2>/dev/null || echo recording)")" stop "$UI_RED"
	else
		ui_row "$UI_I_CAMERA" 'Screenshot · the whole screen' "$HOME/Pictures" 'shot:save:screen'
		ui_row "$UI_I_CROP" 'Screenshot · an area' 'saved to ~/Pictures' 'shot:save:area'
		ui_row "$UI_I_CROP" 'Screenshot · an area, to the clipboard' 'paste it anywhere' 'shot:copy:area'
		ui_row "$UI_I_IMAGE" 'Screenshot · a window' 'pick one with the pointer' 'shot:save:window'
		ui_row "$UI_I_CAMERA" 'Annotate an area' 'arrows, text, crop (swappy)' annotate
		ui_row "$UI_I_VIDEO" 'Record · the whole screen' 'until you stop it' 'rec:none'
		ui_row "$UI_I_VIDEO" 'Record · an area' 'pick it with the pointer' 'rec:area'
	fi
	ui_heading 'read the screen'
	ui_row "$UI_I_FILE" 'Text from an area' 'OCR (tesseract) → clipboard' ocr
	ui_row "$UI_I_QR" 'QR code from an area' 'zbarimg → clipboard' qr
	ui_row "$UI_I_QR" 'Make a QR code' 'the Wi-Fi password, or any text' make-qr "$UI_DIM"
	ui_row "$UI_I_FILES" 'Open the pictures folder' "$HOME/Pictures" folder "$UI_DIM"
} >"$tmp"

key=$(ui_pick 'Capture' 'Enter runs · Escape closes' <"$tmp") || exit 0

case $key in
shot:*)
	_action=${key#shot:}
	_target=${_action#*:}
	screenshot "${_action%%:*}" "$_target"
	;;
annotate) annotate ;;
ocr) ocr ;;
qr) scan_qr ;;
rec:none) start_recording ;;
rec:area)
	_geom=$(slurp -d) || exit 0
	[ -n "$_geom" ] || exit 0
	start_recording "$_geom"
	;;
stop) stop_recording ;;
make-qr) exec "$dir/rofi-qr" ;;
folder) exec "$dir/rofi-files" "$HOME/Pictures" ;;
esac
