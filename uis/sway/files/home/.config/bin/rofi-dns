#!/bin/sh
# DNS: point the active connection at a resolver, or back at DHCP.
#
# Omarchy ships `omarchy-dns` (a list of DoH/DoT providers that edits
# systemd-resolved).  This port has no systemd-resolved: NetworkManager keeps
# /etc/resolv.conf, so the switch is two nmcli properties on the connection that
# is up - `ipv4.dns` and `ipv4.ignore-auto-dns` - followed by bringing that
# connection up again so the change is applied at once.
#
# That re-activation is why this says something before it acts: a Wi-Fi
# connection that comes back up costs a second or two, and a menu that is
# already closed while the network blinks is indistinguishable from a bug.  The
# `busy` card stays until the connection answers again and then becomes the
# read-back from NetworkManager, not the value that was asked for.
#
# DNS is not the same as a VPN: the addresses below are public resolvers reached
# in the clear unless the network itself is encrypted.  Nothing here touches
# IPv6 DNS (`ipv6.dns`), which the same nmcli line could set.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

if ! command -v nmcli >/dev/null 2>&1; then
	ui_say DNS 'nmcli is not installed' critical
	exit 1
fi

dev=$(nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null |
	awk -F: '$3 == "connected" && $2 != "loopback" { print $1; exit }') || true
if [ -z "${dev:-}" ]; then
	ui_say DNS 'No connection is up, so there is nothing to change' critical
	exit 1
fi

con=$(nmcli -g GENERAL.CONNECTION device show "$dev" 2>/dev/null | head -1) || true
case ${con:-} in
'' | --)
	ui_say DNS "$dev has no active connection" critical
	exit 1
	;;
esac

# What is in use right now, and how it got there.  `ignore-auto-dns=no` with no
# static servers means "whatever the network hands out", which is the default.
current=$(nmcli -g IP4.DNS device show "$dev" 2>/dev/null | paste -sd, - | tr ',' ' ') || true
auto=$(nmcli -g ipv4.ignore-auto-dns connection show "$con" 2>/dev/null) || true
[ "$auto" = no ] || auto=yes

tmp=$(mktemp "${TMPDIR:-/tmp}/dns.XXXXXX")
trap 'rm -f "$tmp"' EXIT

# ui_choice ICON NAME SERVERS: a resolver row, marked when it is the one in use.
ui_choice() {
	_detail="$3"
	_key="dns:$3"
	if [ "$auto" = no ] && [ "${current:-}" = "$(printf '%s' "$3" | tr ',' ' ')" ]; then
		ui_row "$1" "$2" "$_detail · in use" "$_key" "$UI_GREEN"
	else
		ui_row "$1" "$2" "$_detail" "$_key" "$UI_DIM"
	fi
}

{
	if [ "$auto" = yes ] || [ -z "${current:-}" ]; then
		ui_row "$UI_I_CLOUD" 'Automatic (the network)' \
			"${current:-no static servers} · in use" automatic "$UI_GREEN"
	else
		ui_row "$UI_I_CLOUD" 'Automatic (the network)' 'what DHCP hands out' automatic "$UI_DIM"
	fi
	ui_choice "$UI_I_CLOUD" 'Cloudflare' '1.1.1.1,1.0.0.1'
	ui_choice "$UI_I_CLOUD" 'Google' '8.8.8.8,8.8.4.4'
	ui_choice "$UI_I_CLOUD" 'Quad9' '9.9.9.9,149.112.112.112'
	ui_choice "$UI_I_CLOUD" 'AdGuard' '94.140.14.14,94.140.15.15'
	ui_heading 'other'
	ui_row "$UI_I_SEARCH" 'Type the servers' 'comma or space separated' custom "$UI_DIM"
} >"$tmp"

mesg="On $con ($dev) · now: ${current:-automatic}"
key=$(ui_pick 'DNS' "$mesg" <"$tmp") || exit 0
[ -n "${key:-}" ] || exit 0

servers=
case $key in
automatic) servers= ;;
dns:*) servers=${key#dns:} ;;
custom)
	servers=$("$UI_BIN/bar-pick" 'DNS servers' -free -mesg 'IPv4 addresses, comma or space separated') || exit 0
	servers=$(printf '%s' "$servers" | tr ' ,' '\n\n' | sed '/^$/d' | paste -sd, -)
	[ -n "$servers" ] || exit 0
	;;
*) exit 0 ;;
esac

if [ "$(id -u)" -ne 0 ] && ! sudo -n true 2>/dev/null; then
	ui_say DNS 'Changing a connection needs root and sudo asks for a password here' critical
	exit 1
fi

busy="$dir/busy"
label='Automatic (DHCP)'
[ -n "$servers" ] && label=$(printf '%s' "$servers" | tr ',' ' ')
"$busy" start dns DNS "Applying $label" cloud 2>/dev/null || true

if [ -n "$servers" ]; then
	out=$(sudo -n nmcli connection modify "$con" ipv4.dns "$servers" ipv4.ignore-auto-dns yes 2>&1) &&
		out=$(sudo -n nmcli connection up "$con" 2>&1)
else
	out=$(sudo -n nmcli connection modify "$con" ipv4.ignore-auto-dns no ipv4.dns "" 2>&1) &&
		out=$(sudo -n nmcli connection up "$con" 2>&1)
fi || {
	"$busy" fail dns DNS "$(printf '%s' "$out" | tail -2 | tr '\n' ' ')" 2>/dev/null || true
	exit 1
}

# Read back what NetworkManager is using now, which is the only honest answer.
sleep 1
now=$(nmcli -g IP4.DNS device show "$dev" 2>/dev/null | paste -sd, - | tr ',' ' ') || true
if [ -z "${now:-}" ]; then
	"$busy" end dns DNS "Back on the network's servers" 2>/dev/null || true
else
	"$busy" end dns DNS "DNS is now $now" 2>/dev/null || true
fi
