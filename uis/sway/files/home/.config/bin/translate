#!/bin/sh
# Translate the selected text: Alt+Ctrl+T.
#
# The question is "what does this say", asked from wherever the text is, so the
# text is the *primary selection* - what the mouse last highlighted, in foot or
# in any other window - then the clipboard when nothing is selected, then a
# prompt when both are empty.  The source language is always detected; the
# target is one line in ~/.config/lazyos/translate.conf (`target=en` when the
# file does not exist, so an image that was never configured translates into
# English), and `translate config` is the menu Settings opens to change it.
#
# Two network facts decide the engine, both measured on this machine: Google's
# translate_a/single endpoint (the one translate-shell uses) answers with a
# captcha page here, while clients5.google.com/translate_a/t with
# client=dict-chrome-ex answers with plain JSON, auto-detects the source and
# echoes the code it detected.  That endpoint only takes GET (a POST redirects
# to /sorry), which is why the query travels in the URL and the selection is
# capped at 3000 characters.  MyMemory is the fallback - no key, but 500
# characters per request, so it is asked one folded chunk at a time - and when
# neither answers the card says so instead of showing half a translation.
# translate-shell (contrib, 277 kB) would have been one package; its engine is
# the endpoint that is blocked here, so it would have been a package that never
# works on this card.
#
# Nothing is resident and nothing is stored: one curl and one jq per request,
# one notification, and for a long translation one foot reading window whose
# file lives in $XDG_RUNTIME_DIR and is removed when the window closes.
#
#   translate              translate the selection (the shortcut)
#   translate config       the language menu (Settings > Translate)
#   translate --languages  "code<TAB>English name", one per line
#   translate --target-name  the name of the configured target language

set -eu

dir=$(dirname "$0")

config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/lazyos
config=$config_dir/translate.conf

# The languages offered by the menu.  Two letters is what both engines take;
# the regional variants of Chinese are the one pair that needs the longer form.
languages() {
	cat <<'EOF'
en	English
es	Spanish
fr	French
de	German
pt	Portuguese
it	Italian
nl	Dutch
ru	Russian
uk	Ukrainian
pl	Polish
tr	Turkish
ar	Arabic
he	Hebrew
hi	Hindi
ja	Japanese
ko	Korean
zh-CN	Chinese (simplified)
zh-TW	Chinese (traditional)
vi	Vietnamese
th	Thai
id	Indonesian
sv	Swedish
cs	Czech
el	Greek
ro	Romanian
fa	Persian
EOF
}

known_code() { # CODE
	languages | cut -f1 | grep -qx -- "$1"
}

name_of() { # CODE
	languages | awk -F'\t' -v c="$1" '$1 == c { print $2; exit }'
}

# --- the configuration file -------------------------------------------------
#
# One `key=value` per line, written by the menu below and readable by hand:
# `target` is the language everything goes into, `fallback_source` is what
# MyMemory is told the source is when Google is unreachable (MyMemory cannot
# detect it).  Unknown keys are kept: the writer drops only the key it replaces.

conf_get() { # KEY
	[ -r "$config" ] || return 0
	sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$config" 2>/dev/null |
		tail -n 1
}

conf_set() { # KEY VALUE
	[ -d "$config_dir" ] || mkdir -p "$config_dir" 2>/dev/null || return 1
	_tmp=$config_dir/.translate.conf.$$
	if [ -r "$config" ]; then
		grep -v "^[[:space:]]*$1[[:space:]]*=" "$config" >"$_tmp" 2>/dev/null || :
	else
		: >"$_tmp"
	fi
	printf '%s=%s\n' "$1" "$2" >>"$_tmp" &&
		mv -f "$_tmp" "$config" && return 0
	rm -f "$_tmp"
	return 1
}

target_code() {
	_t=$(conf_get target)
	known_code "$_t" || _t=en
	printf '%s' "$_t"
}

# --- the engines ------------------------------------------------------------

# Google: GET only, and the response is a list of `[text, detected]` segments.
# The detected code is what lets the card say "Spanish → English" and lets an
# English selection answer "already English" instead of handing it back.
google() { # TEXT TARGET OUTFILE -> detected code on stdout
	_json=$(curl -sS --max-time 8 -G 'https://clients5.google.com/translate_a/t' \
		--data-urlencode 'client=dict-chrome-ex' \
		--data-urlencode 'sl=auto' \
		--data-urlencode "tl=$2" \
		--data-urlencode "q=$1" 2>/dev/null) || return 1
	printf '%s' "$_json" | jq -e 'type == "array"' >/dev/null 2>&1 || return 1
	printf '%s' "$_json" | jq -r '[.[][0] | strings] | join("")' >"$3" 2>/dev/null ||
		return 1
	[ -n "$(tr -d '[:space:]' <"$3" 2>/dev/null || true)" ] || return 1
	printf '%s' "$_json" | jq -r '[.[][1] | strings] | first // ""' 2>/dev/null ||
		true
}

# MyMemory: no key, 500 characters per request (a longer query answers 403 with
# that exact message), and no auto-detect - the source is the configured guess.
mymemory() { # TEXT SOURCE TARGET OUTFILE
	_json=$(curl -sS --max-time 8 -G 'https://api.mymemory.translated.net/get' \
		--data-urlencode "q=$1" \
		--data-urlencode "langpair=$2|$3" 2>/dev/null) || return 1
	_status=$(printf '%s' "$_json" | jq -r '.responseStatus // empty' 2>/dev/null ||
		true)
	[ "$_status" = 200 ] || return 1
	_text=$(printf '%s' "$_json" |
		jq -r '.responseData.translatedText // empty' 2>/dev/null || true)
	case $_text in
	'' | *'MYMEMORY WARNING'* | *'QUERY LENGTH LIMIT'* | *'INVALID'*) return 1 ;;
	esac
	printf '%s' "$_text" >"$4"
}

# The fallback walks the selection in 450-character pieces (fold breaks at
# spaces, so a piece is a phrase and not half a word) and joins the answers with
# one line each.  FALLBACK_SOURCE is what the failure card names as the source.
FALLBACK_SOURCE=
fallback_translate() { # TEXT TARGET OUTFILE
	FALLBACK_SOURCE=$(conf_get fallback_source)
	if ! known_code "$FALLBACK_SOURCE"; then
		if [ "$2" = es ]; then FALLBACK_SOURCE=en; else FALLBACK_SOURCE=es; fi
	fi
	_chunks=$(mktemp "${TMPDIR:-/tmp}/translate-chunks.XXXXXX") || return 1
	_part=$(mktemp "${TMPDIR:-/tmp}/translate-part.XXXXXX") || {
		rm -f "$_chunks"
		return 1
	}
	printf '%s\n' "$1" | fold -s -w 450 >"$_chunks" 2>/dev/null || {
		rm -f "$_chunks" "$_part"
		return 1
	}
	: >"$3"
	_any=0
	while IFS= read -r _chunk; do
		[ -n "$(printf '%s' "$_chunk" | tr -d '[:space:]')" ] || continue
		if ! mymemory "$_chunk" "$FALLBACK_SOURCE" "$2" "$_part"; then
			rm -f "$_chunks" "$_part"
			return 1
		fi
		cat "$_part" >>"$3"
		printf '\n' >>"$3"
		_any=1
	done <"$_chunks"
	rm -f "$_chunks" "$_part"
	[ "$_any" = 1 ]
}

# --- the reading window -----------------------------------------------------

# A translation longer than a toast is something to read, not to glance at: the
# same floated foot the bar's panels and the file browser's text rows use, with
# bat paging the file so the window stays up until it is closed.  The file is
# removed by the window's own shell when the pager exits; one left behind by a
# window that was killed is in $XDG_RUNTIME_DIR and goes away with the session.
open_window() { # TITLE SOURCE TRANSLATION
	_doc=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/lazyos-translate.$$.txt
	{
		printf '%s\n\n' "$1"
		printf '%s\n' "$3"
		printf '\n%s\n' '── what was selected ──'
		printf '%s\n' "$2"
	} >"$_doc" 2>/dev/null || return 0
	setsid foot --app-id=popup --title="$1" -e sh -c '
		env BAT_THEME=ansi bat --paging=always --style=plain --file-name="$1" -- "$2"
		rm -f "$2"' _ "$1" "$_doc" >/dev/null 2>&1 &
}

# --- the shortcut -----------------------------------------------------------

do_translate() {
	. "$dir/lib-rofi.sh"
	_target=$(target_code)
	_target_name=$(name_of "$_target")
	[ -n "$_target_name" ] || _target_name=$_target

	if ! command -v curl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
		ui_say Translate 'curl and jq are what asks the translator, and one is missing' critical dialog-error
		exit 1
	fi

	# The selection first: nowhere in this session does a text cursor come with
	# a "translate" button, but the mouse selection is the gesture that says
	# "this text".  The clipboard is the second answer because a paragraph
	# copied in a browser is the other way the same question is asked.
	text=
	if command -v wl-paste >/dev/null 2>&1; then
		text=$(wl-paste -p -n 2>/dev/null || true)
		case $text in
		'') text=$(wl-paste -n 2>/dev/null || true) ;;
		esac
	fi
	text=$(printf '%s' "$text" | sed -e 's/[[:space:]]*$//')
	if [ -z "$(printf '%s' "$text" | tr -d '[:space:]')" ]; then
		text=$("$dir/bar-pick" "Translate into $_target_name" -free 2>/dev/null ||
			true)
		text=$(printf '%s' "$text" |
			sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
		[ -n "$text" ] || exit 0
	fi

	# 3000 characters is the GET the endpoint accepts without truncating, and a
	# longer selection is cut where a reading window is the answer anyway.  cut
	# counts characters (not bytes) in a UTF-8 locale, so an accent is not half
	# of one.
	_cut=0
	if [ "$(printf '%s' "$text" | wc -m)" -gt 3000 ]; then
		text=$(printf '%s' "$text" | cut -c1-3000)
		_cut=1
	fi

	_out=$(mktemp "${TMPDIR:-/tmp}/translate.XXXXXX") || exit 1
	trap 'rm -f "$_out"' EXIT
	# Both requests are one curl each, and stopping the one that is running is
	# what the bar's spinner offers: the card appears, and a click on it ends a
	# translation that is waiting on a network that is not going to answer.
	BUSY_STOP='pkill -f "[c]lients5.google.com"; pkill -f "[a]pi.mymemory.translated.net"' \
		"$dir/busy" start translate Translate 'Translating…' globe

	_detected=
	_engine=google
	if ! _detected=$(google "$text" "$_target" "$_out"); then
		_detected=
		_engine=mymemory
		if fallback_translate "$text" "$_target" "$_out"; then
			_detected=$FALLBACK_SOURCE
		else
			"$dir/busy" fail translate \
				'No answer from the translator: is the network up?' dialog-error
			exit 1
		fi
	fi
	# The click on the spinner is the stop button; a stopped translation has
	# nothing to report and must not turn into a result.
	if "$dir/busy" cancelled translate; then
		exit 0
	fi
	"$dir/busy" stop translate

	_translation=$(cat "$_out")
	if [ -z "$(printf '%s' "$_translation" | tr -d '[:space:]')" ]; then
		ui_say Translate 'The translator answered with nothing' critical dialog-error
		exit 1
	fi

	# English into English is the one direction that says something the person
	# already knows; saying so is more useful than echoing the text.
	if [ "$_engine" = google ] && [ "$_detected" = "$_target" ]; then
		ui_say "Already $_target_name" \
			"This is already in $_target_name. Settings → Translate picks another language." \
			normal globe
		exit 0
	fi

	_src_name=$(name_of "$_detected")
	[ -n "$_src_name" ] || _src_name=$_detected
	if [ -n "$_src_name" ]; then
		_title="$_src_name → $_target_name"
	else
		_title="Translate into $_target_name"
	fi
	if [ "$_engine" = mymemory ]; then
		_title="$_title (MyMemory)"
	fi

	_body=$_translation
	if [ "$_cut" = 1 ]; then
		_body="$_body

(the selection was cut at 3000 characters)"
	fi

	ui_copy "$_translation"
	ui_say "$_title" "$_body" normal globe

	# Past a few lines the card is a preview of the window, not the answer.
	if [ "$(printf '%s' "$_translation" | wc -c)" -gt 400 ] ||
		[ "$(printf '%s\n' "$_translation" | wc -l)" -gt 3 ]; then
		open_window "$_title" "$text" "$_translation"
	fi
}

# --- the menu ---------------------------------------------------------------

do_config() {
	. "$dir/lib-rofi.sh"
	while :; do
		_current=$(target_code)
		_current_name=$(name_of "$_current")
		[ -n "$_current_name" ] || _current_name=$_current
		tmp=$(mktemp "${TMPDIR:-/tmp}/translate-menu.XXXXXX") || exit 1
		{
			languages | while IFS='	' read -r _code _name; do
				if [ "$_code" = "$_current" ]; then
					ui_row "$UI_ON" "$_name" "$_code · current" "lang:$_code"
				else
					ui_row "$UI_OFF" "$_name" "$_code" "lang:$_code" "$UI_DIM"
				fi
			done
			ui_heading 'how it is used'
			ui_note 'Select text with the mouse, then press Alt+Ctrl+T' ''
			ui_note 'The result is copied to the clipboard' \
				'long ones also open in a read window'
			ui_note 'Already in that language?' \
				'the card says so instead of translating'
			ui_note 'Engine' 'Google, then MyMemory; no network means no answer'
		} >"$tmp"
		key=$(ui_pick 'Translate' \
			"Everything goes into $_current_name · Enter sets the language" \
			<"$tmp") || {
			rm -f "$tmp"
			exit 0
		}
		rm -f "$tmp"
		case $key in
		lang:*)
			_code=${key#lang:}
			known_code "$_code" || continue
			if ! conf_set target "$_code"; then
				ui_say Translate 'Could not write ~/.config/lazyos/translate.conf' \
					critical dialog-error
			fi
			;;
		esac
	done
}

case ${1:-} in
--languages)
	languages
	exit 0
	;;
--target-name)
	name_of "$(target_code)"
	exit 0
	;;
config)
	do_config
	;;
'')
	do_translate
	;;
*)
	printf 'usage: translate [config|--languages|--target-name]\n' >&2
	exit 2
	;;
esac
