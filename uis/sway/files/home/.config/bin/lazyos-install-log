#!/bin/sh
# The install log, in a window: what Install LazyOS wrote, live or after the fact.
#
#   lazyos-install-log [FILE]
#
# rofi-install calls this for its "Show the install log" row, and with no
# argument it opens what the last run left behind.  A running install follows
# its log (less's forward mode), because a copy of the system takes minutes and
# what a person wants is the step it is on; a finished one opens at the end,
# where the answer is.
#
# The window is foot with app-id lazyos-install, floated and centred by
# config.d/31-install.conf: the menu that calls this has no terminal of its own,
# so without foot there is nowhere to show anything - and the notification then
# says the path instead of pretending.  Nothing is edited here: the log is the
# record of a write and exists to be read.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

state=${XDG_RUNTIME_DIR:-/tmp}/lazyos-install
logdir=${XDG_STATE_HOME:-$HOME/.local/state}/lazyos

# The file: the one named, else the one the last run announced, else the newest
# on disk.  That last step matters because the state directory lives in
# $XDG_RUNTIME_DIR and dies with the session, while the logs live in
# $XDG_STATE_HOME and outlive it - "show the last log" a day later still works.
file=${1:-}
if [ -z "$file" ] && [ -r "$state/log" ]; then
	file=$(cat "$state/log")
fi
if [ -z "$file" ] || [ ! -r "$file" ]; then
	file=$(ls -1t "$logdir"/install-*.log 2>/dev/null | head -n 1 || :)
fi
if [ -z "$file" ] || [ ! -r "$file" ]; then
	ui_say 'Install LazyOS' 'There is no install log on this machine yet' \
		normal "$UI_ICON_INFO"
	exit 1
fi

# The same test rofi-install makes: the pid file is written by the run itself and
# a pid that is gone means the run was killed (the log then ends mid-sentence).
running=no
if [ -s "$state/run.pid" ]; then
	pid=$(cat "$state/run.pid" 2>/dev/null || :)
	case ${pid:-} in
	'' | *[!0-9]*) ;;
	*) kill -0 "$pid" 2>/dev/null && running=yes ;;
	esac
fi

for _tool in foot less; do
	if ! command -v "$_tool" >/dev/null 2>&1; then
		ui_say 'Install LazyOS' "The log is $file ($_tool is not installed, so it cannot be shown)" \
			normal "$UI_ICON_INFO"
		exit 1
	fi
done

# -R keeps the colours the installer paints its steps in, +F follows the end of
# a log that is still growing, +G opens at the end of one that is not.
if [ "$running" = yes ]; then
	exec foot --app-id=lazyos-install --title='Install LazyOS · log' -e less -R +F "$file"
fi
exec foot --app-id=lazyos-install --title='Install LazyOS · log' -e less -R +G "$file"
