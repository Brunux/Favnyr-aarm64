#!/bin/sh
# The manual: this image's documentation, rendered and searchable.
#
# The pages are markdown in /usr/share/doc/nureb, and they are the same text the
# repository carries (uis/sway/files/usr/share/doc/nureb).  They are opened with
# glow, which renders the markdown instead of showing it (headings, code blocks,
# tables, links), using ~/.config/glow/solarized.json so the page has the same
# palette as everything else.  One foot window for as long as a page is open.
#
# The first row searches: ripgrep over the same pages, one row per match, and the
# page containing it opens where the match is.
set -eu

docs=/usr/share/doc/nureb
theme="$HOME/.config/rofi/solarized.rasi"
dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

table=$(mktemp "${TMPDIR:-/tmp}/learn.XXXXXX")
trap 'rm -f "$table" "$table.matches"' EXIT

[ -d "$docs" ] || {
	ui_say Learn "The documentation is not installed" "$docs is missing"
	exit 1
}


open_page() { # FILE
	exec foot -T "Nureb · $(basename "$1" .md)" -e glow -p "$1"
}

# --- search ----------------------------------------------------------------

search() {
	q=$("$dir/bar-pick" 'Search the manual' -free) || exit 0
	[ -n "$q" ] || exit 0
	rg -n -i --no-heading --with-filename --max-count 5 -- "$q" "$docs"/*.md \
		>"$table.matches" 2>/dev/null || true
	if [ ! -s "$table.matches" ]; then
		ui_say Learn "Nothing matches \"$q\""
		exit 0
	fi
	: >"$table"
	while IFS=: read -r page line text; do
		[ -n "$page" ] || continue
		_pages=$(basename "$page" .md)
		_text=$(printf '%s' "$text" | sed -e 's/^[[:space:]]*//' -e 's/[*_`#]//g' | cut -c1-70)
		ui_row "$UI_I_SEARCH" "$_text" "$_pages · line $line" "open:$page"
	done <"$table.matches"
	_choice=$(ui_pick "Matches for $q" 'Enter opens the page · Escape closes' <"$table") || exit 0
	case $_choice in
	open:*) open_page "${_choice#open:}" ;;
	esac
	exit 0
}

if [ "${1:-}" = "--search" ]; then
	search
fi

# --- the list --------------------------------------------------------------

ui_row "$UI_I_SEARCH" 'Search the manual' 'ripgrep over every page' search >"$table"

for f in "$docs"/*.md; do
	[ -r "$f" ] || continue
	title=$(sed -n '1s/^# *//p' "$f")
	[ -n "$title" ] || title=$(basename "$f" .md)
	summary=$(awk 'NR > 1 && /^[A-Za-z]/ { print; exit }' "$f" |
		sed -e 's/[*_`]//g' -e 's/^[[:space:]]*//' | cut -c1-64)
	ui_row "$UI_I_BOOK" "$title" "$summary" "open:$f" >>"$table"
done

choice=$(ui_pick 'Learn' 'Enter opens the page in a terminal · Escape closes' <"$table") || exit 0

case $choice in
search) search ;;
open:*) open_page "${choice#open:}" ;;
esac
