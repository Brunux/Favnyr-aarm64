#!/bin/sh
# Reminders: write it now, be told later.
#
# Omarchy's `omarchy-reminder` writes a line to a file and starts a
# `systemd-run --user --on-active=` timer; this is the same mechanism, and it is
# not a service in the sense the rest of this port avoids: a transient timer is
# one unit that fires, notifies and is collected (`--collect`).  It lives as long
# as the session's user manager, which is the right lifetime for "remind me in 15
# minutes" and for "every Monday at 07:00".
#
# The list is those timers, read from systemd itself, so there is no second store
# to drift: choosing one cancels it.  Nothing is written to disk.
#
# The shape of the flow, and why:
#
#   * the title is one free prompt, and the note is a second one that may be left
#     empty.  Escape on the note means *no note*, not "forget the reminder":
#     the timing menu two steps later is where the flow is abandoned, because a
#     person who has just started typing a note should not lose the title to one
#     keystroke;
#   * "when" keeps the five delays this menu always had, then adds the calendar
#     ones: a date, every day, every weekday, every week on a day, every month on
#     a day.  A repeating reminder is a *calendar expression* handed to the timer
#     itself (`Mon-Fri 08:30:00`), so systemd repeats it while the session lives -
#     no cron, no watcher, no file;
#   * every expression is first put through `systemd-analyze calendar`, which is
#     the parser the timer is going to use anyway.  Its own error text is what a
#     rejection shows, and its "Next elapse:" line is what the confirmation shows
#     before anything is created;
#   * a calendar timer built from a fully specified date (`2026-11-05 18:30:00`)
#     fires once; one built from an expression with a wildcard (`*-*-* 09:00:00`)
#     repeats.  That is the whole difference, and `systemd-analyze calendar`
#     shows it: iterations for the second, none for the first.
#
# The timer's Description carries the title, a tab, then the note.  It is the only
# per-unit string that survives a repeating timer's firings (the transient
# service is unloaded once it has run, and a reminder that repeats must keep its
# note for the list), and both fields are stripped of tabs before they are stored
# here, so the split is exact.  `systemctl list-timers` shows the note one column
# to the right, which is the price of having no second store.
#
# notify-send runs as the transient unit's own process, in the user manager's
# environment - the same session bus mako listens on.  It carries an icon name
# from the Nureb theme (which inherits Adwaita and hicolor), so a reminder is a
# clock in the notification history instead of a grey square.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

prefix=lazyos-reminder-
tab=$(printf '\t')

# The notification icon is a name the icon theme resolves (the Nureb theme
# inherits Adwaita and hicolor).  It is ui_say's fourth argument: on an image
# whose lib-rofi.sh predates that argument the extra one is ignored, and the
# notification is then simply iconless.
icon=preferences-system-time

have() { command -v "$1" >/dev/null 2>&1; }

# A reminder is only worth typing if something will fire it, and the only thing
# that can is this session's user manager.  Saying so beats a menu that accepts a
# reminder and never rings.
if ! have systemd-run || ! systemctl --user show-environment >/dev/null 2>&1; then
	ui_say Reminders 'The user systemd manager is not reachable, so a timer cannot be started' critical "$icon"
	exit 1
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/remind.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

# ---- reading systemd -------------------------------------------------------

# Unit and the epoch second it fires, from systemd's own JSON (the plain columns
# of list-timers move with the locale, and a date with a space in it cannot be
# parsed by field position).  `select(.next != null)` drops the timers that have
# already fired and the stopped ones: `--all` lists those too, and a reminder
# whose moment has passed is not something to offer for cancelling.
systemctl --user list-timers --all --output=json "${prefix}*" 2>/dev/null |
	jq -r '.[]? | select(.next != null) | [.unit, ((.next / 1000000) | floor)] | @tsv' >"$tmp/pending" 2>/dev/null ||
	: >"$tmp/pending"
pending=$(grep -c . "$tmp/pending" 2>/dev/null || true)

# The two fields of a Description: title, a tab, the note (empty when absent).
desc_title() {
	printf '%s' "${1%%"$tab"*}"
}
desc_note() {
	case ${1:-} in
	*"$tab"*) printf '%s' "${1#*"$tab"}" ;;
	*) : ;;
	esac
}

# left SECONDS: "in 4 min", "in 2 h 10 min", for a reminder with no calendar
# expression behind it.
left() {
	_s=$1
	if [ "$_s" -lt 60 ]; then
		printf 'in less than a minute'
	elif [ "$_s" -lt 3600 ]; then
		printf 'in %d min' "$((_s / 60))"
	elif [ "$_s" -lt 86400 ]; then
		_h=$((_s / 3600))
		_m=$(((_s % 3600) / 60))
		if [ "$_m" -gt 0 ]; then printf 'in %d h %d min' "$_h" "$_m"; else printf 'in %d h' "$_h"; fi
	else
		printf 'in %d days' "$((_s / 86400))"
	fi
}

# weekday Mon -> Monday.  A table and not `date -d Mon`: this must not move with
# the session's locale, and it is one less fork for every row of the list.
weekday() {
	case ${1:-} in
	Mon) printf Monday ;;
	Tue) printf Tuesday ;;
	Wed) printf Wednesday ;;
	Thu) printf Thursday ;;
	Fri) printf Friday ;;
	Sat) printf Saturday ;;
	Sun) printf Sunday ;;
	esac
}

# ord DAY -> st, nd, rd, th (only ever asked for 1..28).
ord() {
	case ${1:-} in
	1 | 21) printf st ;;
	2 | 22) printf nd ;;
	3 | 23) printf rd ;;
	*) printf th ;;
	esac
}

# repeat_words EXPR: a calendar expression in words, or nothing when it is not
# one.  The expressions this script creates come back from TimersCalendar in
# systemd's *normalized* form, which is not the form that was written - `Mon-Fri`
# becomes `Mon..Fri` and the date part is filled in - so the patterns below match
# the normalized spellings:
#
#   *-*-* 09:00:00            every day at 09:00
#   Mon..Fri *-*-* 08:30:00   every weekday at 08:30
#   Mon *-*-* 07:00:00        every Monday at 07:00
#   *-*-05 09:00:00           every month on day 5 at 09:00
#   2026-11-05 18:30:00       once, on Thu 05 Nov 18:30
repeat_words() {
	_e=${1:-}
	[ -n "$_e" ] || return 0
	_t=${_e##* }
	_d=${_e% "$_t"}
	_hm=${_t%:*}
	case $_t in
	[0-9][0-9]:[0-9][0-9]:[0-9][0-9]) ;;
	*) return 0 ;;
	esac
	# The day part is one token for the daily, monthly and one-shot forms and two
	# for the weekday and weekly ones (`Mon..Fri *-*-*`, `Mon *-*-*`), so its
	# first token is what tells them apart.
	_f=${_d%% *}
	case $_f in
	'*-*-*') printf 'every day at %s' "$_hm" ;;
	'Mon..Fri' | 'Mon-Fri') printf 'every weekday at %s' "$_hm" ;;
	Mon | Tue | Wed | Thu | Fri | Sat | Sun) printf 'every %s at %s' "$(weekday "$_f")" "$_hm" ;;
	'*-*-'[0-9][0-9])
		_day=${_f#\*-\*-}
		_day=${_day#0}
		[ -n "$_day" ] || _day=0
		printf 'every month on day %s at %s' "$_day" "$_hm"
		;;
	[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9])
		printf 'once, on %s' "$(date -d "$_f $_hm" '+%a %d %b %H:%M' 2>/dev/null || printf '%s %s' "$_f" "$_hm")"
		;;
	*) printf 'repeating' ;;
	esac
}

# trim TEXT [MAX]: the one-line, tab-free form of a title or a note, with an
# ellipsis when it does not fit.  Only what is *drawn* is cut: a row's key lives
# in the second column of the table, so a long title cannot disturb the mapping
# between the row and the action behind it (ui_row drops tabs and newlines for
# the same reason).  sed counts characters in a UTF-8 locale, so a title ending
# in an emoji is cut between characters instead of inside one.
trim() {
	_n=${2:-72}
	printf '%s' "${1:-}" | tr -d '\n\t' | sed 's/^\(.\{'"$_n"'\}\).\+$/\1…/'
}

# ---- the list --------------------------------------------------------------

now=$(date +%s)
{
	if [ "${pending:-0}" -eq 0 ]; then
		ui_note 'No reminders waiting' 'The row below starts one'
	else
		while IFS=$tab read -r unit when; do
			[ -n "$unit" ] || continue
			# One call for both properties: the timer's Description is the
			# title (and the note), its TimersCalendar says whether it repeats.
			props=$(systemctl --user show -p Description -p TimersCalendar "$unit" 2>/dev/null) || props=
			raw=$(printf '%s\n' "$props" | sed -n 's/^Description=//p')
			cal=$(printf '%s\n' "$props" | sed -n 's/^TimersCalendar={ *OnCalendar=//p' |
				sed -e 's/ *; .*//' -e 's/ *}$//')
			title=$(desc_title "$raw")
			[ -n "$title" ] || title='(untitled reminder)'
			note=$(desc_note "$raw")
			if [ -n "$cal" ]; then
				words=$(repeat_words "$cal")
			else
				words=$(left "$((when - now))")
			fi
			[ -n "$words" ] || words='repeating'
			detail=$words
			if [ "${when:-0}" -gt 0 ]; then
				detail="$detail · $(date -d "@$when" '+%a %d %b %H:%M')"
			fi
			detail="$detail · Enter cancels"
			if [ -n "$note" ]; then
				detail="$(trim "$note" 40) · $detail"
			fi
			ui_row "$UI_I_CLOCK" "$(trim "$title" 72)" "$detail" "cancel:$unit" "$UI_YELLOW"
		done <"$tmp/pending"
	fi
	ui_heading 'new'
	ui_row "$UI_I_BELL" 'New reminder' 'say what, when, and whether it repeats' new
} >"$tmp/rows"

if [ "${pending:-0}" -eq 0 ]; then
	mesg='Enter starts a reminder · Escape closes'
else
	mesg="$pending waiting · Enter cancels one · Escape closes"
fi
key=$(ui_pick 'Reminders' "$mesg" <"$tmp/rows") || exit 0
[ -n "${key:-}" ] || exit 0

case $key in
cancel:*)
	unit=${key#cancel:}
	# Read the description *before* stopping: a collected unit has nothing left
	# to name, and `show` then answers with the unit name - which is exactly the
	# `lazyos-reminder-33747` the cancel notification used to read out.
	props=$(systemctl --user show -p LoadState -p Description -p TimersCalendar "$unit" 2>/dev/null) || props=
	load=$(printf '%s\n' "$props" | sed -n 's/^LoadState=//p')
	if [ "${load:-}" = loaded ]; then
		raw=$(printf '%s\n' "$props" | sed -n 's/^Description=//p')
		cal=$(printf '%s\n' "$props" | sed -n 's/^TimersCalendar={ *OnCalendar=//p' |
			sed -e 's/ *; .*//' -e 's/ *}$//')
	else
		raw= cal=
	fi
	when2=$(awk -F'\t' -v u="$unit" '$1 == u { print $2; exit }' "$tmp/pending")
	name=$(desc_title "$raw")
	words=$(repeat_words "$cal")
	if [ -n "$name" ]; then
		said="“$name”"
	else
		said='The reminder'
	fi
	if systemctl --user stop "$unit" >/dev/null 2>&1; then
		case ${when2:-} in
		'' | 0) said2='It will not fire.' ;;
		*)
			if [ -n "$words" ]; then
				said2="It would have fired $words, next $(date -d "@$when2" '+%a %d %b %H:%M')."
			else
				said2="It would have fired at $(date -d "@$when2" '+%a %d %b %H:%M')."
			fi
			;;
		esac
		# Two lines: what was cancelled, then when it would have gone off.  The
		# body is one argument, since ui_say takes title, body, urgency and icon.
		ui_say Cancelled "$said
$said2" normal "$icon"
	else
		ui_say 'Already gone' "$said was already gone." critical "$icon"
	fi
	exit 0
	;;
new) ;;
*) exit 0 ;;
esac

# ---- what it should say ----------------------------------------------------

text=$("$UI_BIN/bar-pick" 'Reminder' -free -mesg 'What should it say?') || exit 0
text=$(printf '%s' "$text" | tr '\n\t' '  ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
[ -n "$text" ] || exit 0

# The note is optional, and Escape here is one of the two ways of saying "none"
# (an empty Enter is the other).  That is deliberate: the timing menu that
# follows is the place where the reminder is abandoned, so this prompt can be
# dismissed without losing the title that was just typed.
note=$("$UI_BIN/bar-pick" 'Note' -free \
	-mesg 'Optional detail · Enter or Escape leaves it empty') || note=
note=$(printf '%s' "$note" | tr '\n\t' '  ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

# ---- when ------------------------------------------------------------------

{
	ui_heading 'in a while'
	ui_row "$UI_I_CLOCK" 'In 5 minutes' '' 5min
	ui_row "$UI_I_CLOCK" 'In 15 minutes' '' 15min
	ui_row "$UI_I_CLOCK" 'In 30 minutes' '' 30min
	ui_row "$UI_I_CLOCK" 'In 1 hour' '' 1h
	ui_row "$UI_I_CLOCK" 'In 4 hours' '' 4h
	ui_row "$UI_I_CLOCK" 'At 09:00' 'the next nine in the morning' 0900
	ui_heading 'repeat'
	ui_row "$UI_I_CLOCK" 'On a date and time…' 'once, and I say when' date
	ui_row "$UI_I_CLOCK" 'Every day at…' 'one time, every day' daily
	ui_row "$UI_I_CLOCK" 'Every weekday at…' 'Monday to Friday' weekday
	ui_row "$UI_I_CLOCK" 'Every week on…' 'pick a weekday, then a time' weekly
	ui_row "$UI_I_CLOCK" 'Every month on…' 'pick a day of the month, then a time' monthly
} >"$tmp/when"

# The loop is not decoration: an expression systemd refuses sends the person
# back to this menu with the title and the note still known, instead of ending
# the flow and making them type it all again.
while :; do
	when=$(ui_pick 'When' "“$(trim "$text" 48)”" <"$tmp/when") || exit 0
	[ -n "${when:-}" ] || exit 0

	mode=calendar
	case $when in
	5min | 15min | 30min | 1h | 4h)
		mode=active
		expr=$when
		;;
	0900)
		# A concrete date, not `*-*-* 09:00:00`: that expression repeats every
		# morning, and "at 09:00" means the next nine, once (systemd-analyze
		# calendar shows no iteration for a fully specified date).
		expr=$(date -d 'today 09:00' '+%Y-%m-%d %H:%M:00')
		[ "$(date -d "$expr" +%s)" -gt "$(date +%s)" ] ||
			expr=$(date -d 'tomorrow 09:00' '+%Y-%m-%d %H:%M:00')
		;;
	date)
		answer=$("$UI_BIN/bar-pick" 'Date and time' -free \
			-mesg 'For example 2026-12-24 19:00; whatever date -d understands') || exit 0
		answer=$(printf '%s' "$answer" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
		[ -n "$answer" ] || continue
		# A fully specified date is what makes the timer fire once, so the answer
		# is resolved here and the timer only ever sees the resolved form.
		if ! expr=$(date -d "$answer" '+%Y-%m-%d %H:%M:00' 2>&1); then
			ui_say 'That is not a date' "$(printf '%s' "$expr" | tail -n1)" critical "$icon"
			continue
		fi
		;;
	daily | weekday | weekly | monthly)
		day=
		case $when in
		weekly)
			{
				for _d in Mon Tue Wed Thu Fri Sat Sun; do
					ui_row "$UI_I_CLOCK" "$(weekday "$_d")" "every $_d" "$_d"
				done
			} >"$tmp/weekday"
			day=$(ui_pick 'Weekday' "“$(trim "$text" 48)”" <"$tmp/weekday") || exit 0
			[ -n "${day:-}" ] || exit 0
			;;
		monthly)
			{
				_d=1
				while [ "$_d" -le 28 ]; do
					ui_row "$UI_I_CLOCK" "Day $_d" "the ${_d}$(ord "$_d") of every month" "$_d"
					_d=$((_d + 1))
				done
			} >"$tmp/monthday"
			# 1-28 and not 1-31: every month has a 28th, so the expression never
			# has to skip a month.
			day=$(ui_pick 'Day of the month' "“$(trim "$text" 48)”" <"$tmp/monthday") || exit 0
			[ -n "${day:-}" ] || exit 0
			;;
		esac
		clock=$("$UI_BIN/bar-pick" 'Time' -free \
			-mesg '24-hour, for example 09:00 or 18:30') || exit 0
		clock=$(printf '%s' "$clock" | tr -d '[:space:]')
		[ -n "$clock" ] || continue
		# The time is *not* parsed here: it is handed to systemd as part of the
		# expression below, and systemd-analyze calendar is what says whether it
		# is a time.  That keeps one parser in charge of every expression.
		case $when in
		daily) expr="*-*-* $clock" ;;
		weekday) expr="Mon-Fri $clock" ;;
		weekly) expr="$day $clock" ;;
		monthly) expr=$(printf '*-*-%02d %s' "$day" "$clock") ;;
		esac
		;;
	*) exit 0 ;;
	esac

	# The five delays need no calendar: systemd takes them as `5min`, and it is
	# the timer that turns that into a moment.
	[ "$mode" = active ] && break

	# systemd-analyze is the parser the timer uses, so its verdict is the one
	# that counts - including its wording.  LC_ALL=C keeps the labels ("Next
	# elapse:") machine-readable whatever the session's locale is.
	if ! have systemd-analyze; then
		ui_say 'Cannot check that date' 'systemd-analyze is missing, so no calendar expression can be checked; the delays above still work' critical "$icon"
		continue
	fi
	if ! reading=$(LC_ALL=C systemd-analyze calendar --iterations=1 "$expr" 2>&1); then
		ui_say 'That is not a date systemd understands' "$(printf '%s' "$reading" | tail -n1)" critical "$icon"
		continue
	fi
	nextline=$(printf '%s\n' "$reading" | sed -n 's/^ *Next elapse: *//p' | head -n1)
	case ${nextline:-} in
	never*)
		ui_say 'That time has already passed' 'systemd reads it as: never' critical "$icon"
		continue
		;;
	esac

	# The words come from systemd's normalized form, not from what was typed:
	# `9:00` and `*-*-05 9:00` normalize to `*-*-05 09:00:00`, and that is also
	# what the timer's TimersCalendar will answer later, so the list and this
	# confirmation describe a reminder the same way.  A wildcard in the date
	# part is what makes a timer repeat (a fully specified date fires once).
	normal=$(printf '%s\n' "$reading" | sed -n 's/^Normalized form: *//p' | head -n1)
	[ -n "$normal" ] || normal=$expr
	repeats=0
	case $normal in
	*'*'*) repeats=1 ;;
	esac
	words=$(repeat_words "$normal")
	detail=$nextline
	[ "$repeats" = 1 ] && detail="$words · $nextline"
	{
		ui_heading 'confirm'
		ui_row "$UI_I_CLOCK" 'Set it' "$detail" set
		ui_row "$UI_I_UNDO" 'Cancel' 'nothing is created' back
	} >"$tmp/confirm"
	ok=$(ui_pick 'Reminder' "$(ui_esc "$nextline")" <"$tmp/confirm") || exit 0
	[ "${ok:-}" = set ] || exit 0
	break
done

# ---- creating it ----------------------------------------------------------

unit="$prefix$(date +%Y%m%d%H%M%S)-$$"
desc=$text
body=$text
if [ -n "$note" ]; then
	desc="$text$tab$note"
	body="$text
$note"
fi

if [ "$mode" = active ]; then
	out=$(systemd-run --user --collect --unit="$unit" --description="$desc" \
		--on-active="$expr" \
		notify-send -a LazyOS -i "$icon" 'Reminder' "$body" 2>&1) || {
		ui_say 'Could not set the reminder' "$(printf '%s' "$out" | tail -2 | tr '\n' ' ')" critical "$icon"
		exit 1
	}
else
	# `$normal` and not `$expr`: the timer is given the expression that was just
	# confirmed, so what fires is what the person was shown.
	out=$(systemd-run --user --collect --unit="$unit" --description="$desc" \
		--on-calendar="$normal" \
		notify-send -a LazyOS -i "$icon" 'Reminder' "$body" 2>&1) || {
		ui_say 'Could not set the reminder' "$(printf '%s' "$out" | tail -2 | tr '\n' ' ')" critical "$icon"
		exit 1
	}
fi

# Ask systemd when it will actually fire instead of repeating the delay that was
# chosen: after a suspend a timer moves, and the notification should say the
# truth.
next=$(systemctl --user list-timers --all --output=json "$unit.timer" 2>/dev/null |
	jq -r '.[0].next // empty' 2>/dev/null | awk '{ printf "%d", $1 / 1000000 }') || next=
if [ -n "${next:-}" ]; then
	at=$(date -d "@$next" '+%a %d %b %H:%M')
	told="“$text”"
	if [ "${repeats:-0}" = 1 ]; then
		told="$told
$words · next $at"
	else
		# In its own line: dash cannot parse `$((... $(...)...))` nested inside
		# a command substitution inside double quotes.
		away=$((next - $(date +%s)))
		told="$told
at $at · $(left "$away")"
	fi
	ui_say Reminders "$told" normal "$icon"
else
	ui_say Reminders "“$text”" 'reminder set' normal "$icon"
fi
