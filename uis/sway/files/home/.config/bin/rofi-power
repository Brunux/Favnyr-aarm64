#!/bin/sh
# Power: lock, suspend, hibernate, log out, reboot and shut down.
#
# Omarchy's system menu is this list (Super+Escape); Deboma draws it as a
# Quickshell panel.  Here it is a rofi list, and the three rows that end the
# session ask once more through bar-pick, because none of them can be undone.
#
# This is *not* bar-power: that one is the battery panel behind the bar's
# indicator (charge, draw, time left, uptime in a swaynag banner).  The two were
# one script until Alt+Escape and Alt+Ctrl+P were reported as "does not work" -
# the keys opened a banner of numbers where a menu of actions was expected.
#
# Every row ends in a command the image already has: swaylock, sway-suspend (the
# logind -> sudo -> /sys/power/state chain), sway-hibernate (which refuses with a
# reason when there is no disk swap), swaymsg exit, systemctl reboot/poweroff.
# The last two are logind methods: polkit allows them for an active local
# session, and `sudo -n` is the fallback because this image has passwordless
# sudo.  Logging out returns to greetd, which is the greeter on tty7.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

# bar-pick, not ui_pick: this is a plain yes/no, with no glyphs to keep.
confirm() { # QUESTION
	_answer=$("$dir/bar-pick" "$1" <<'EOF'
No, go back
Yes
EOF
	) || return 1
	[ "$_answer" = Yes ]
}

# systemctl for the two rows that need it: polkit first (no password for the
# active session), sudo second.  Anything else is reported, never silent.
session_action() { # systemctl VERB, DESCRIPTION
	if systemctl "$1" 2>/dev/null; then
		exit 0
	fi
	if sudo -n systemctl "$1" 2>/dev/null; then
		exit 0
	fi
	ui_say 'Power' "Could not $2 (systemctl $1 failed, with or without sudo)" critical
	exit 1
}

# The battery line at the top is the same sysfs file the bar reads; the gauge
# omits status and time_to_empty_now on this hardware, so everything is optional.
battery() {
	_bat=/sys/class/power_supply/sbs-8-000b
	_cap=$(cat "$_bat/capacity" 2>/dev/null || true)
	_state=$(cat "$_bat/status" 2>/dev/null || true)
	if [ -n "$_cap" ]; then
		printf '%s%% · %s' "$_cap" "$(printf '%s' "${_state:-unknown}" | tr 'A-Z' 'a-z')"
	else
		printf 'unknown'
	fi
}

tmp=$(mktemp "${TMPDIR:-/tmp}/power-menu.XXXXXX")
trap 'rm -f "$tmp"' EXIT

{
	ui_heading "battery $(battery)"
	ui_row "$UI_I_LOCK" 'Lock' 'swaylock' lock
	ui_row "$UI_I_PAUSE" 'Suspend' 'lock, then sleep' suspend
	ui_row "$UI_I_MOON" 'Hibernate' 'to a disk swap, if there is one' hibernate "$UI_DIM"
	ui_row "$UI_I_OUT" 'Log out' 'back to the greeter' logout
	ui_row "$UI_I_REBOOT" 'Reboot' 'asks first' reboot "$UI_YELLOW"
	ui_row "$UI_I_POWER" 'Shut down' 'asks first' poweroff "$UI_RED"
} >"$tmp"

key=$(ui_pick 'Power' 'Enter runs · Escape closes' <"$tmp") || exit 0

case $key in
lock) exec swaylock -f -c 002b36 ;;
suspend)
	# Lock first, then sleep: what the session does on Alt+Shift+Escape, for the
	# same reason (a resume that lands on an unlocked desktop is a hole).
	swaylock -f -c 002b36 &
	sleep 1
	exec "$dir/sway-suspend"
	;;
hibernate) exec "$dir/sway-hibernate" ;;
logout) confirm 'Log out of the session?' && exec swaymsg exit ;;
reboot) confirm 'Reboot the machine?' && session_action reboot 'reboot' ;;
poweroff)
	confirm 'Shut the machine down?' && session_action poweroff 'shut down'
	;;
*) exit 0 ;;
esac
