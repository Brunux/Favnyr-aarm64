#!/bin/sh
# Download: a link, and the file in ~/Downloads.
#
# yt-dlp is in packages/tools.list, needs no daemon and no configuration: it is
# one process per link and it exits when the file is on disk.  ffmpeg (also in
# tools.list) is what merges a video stream with its audio, and node is the
# JavaScript runtime YouTube's challenges need - /etc/yt-dlp.conf names it, so
# the debug line reads "JS runtimes: node-24.21.0" instead of "none", which is
# the difference between the high-quality formats being offered and "some
# formats may be missing".
#
#   rofi-download      paste a link, or take the one already in the clipboard
#
# The file lands in ~/Downloads (created by rootfs-setup.sh) under yt-dlp's own
# name, `Title [id].ext`, and the notification says which file it was.  A link
# to a video inside a playlist downloads that video and not the playlist:
# `--no-playlist` is the one flag that keeps a shared link from turning into a
# queue of a thousand files on a 58 GB eMMC.
#
# A download is a `busy` card with a stop button, because it can take minutes on
# a slow link and the bar's spinner is the only thing that says so.  Stopping it
# kills yt-dlp, which leaves the `.part` file behind - so the notification says
# the download was stopped rather than claiming a file, and `busy cancelled` is
# what tells this script that the card is gone (the same protocol the Wi-Fi scan
# and the dictation use).
set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

downloads="$HOME/Downloads"
mkdir -p "$downloads" 2>/dev/null || true

have() { command -v "$1" >/dev/null 2>&1; }

tmp=$(mktemp -d "${TMPDIR:-/tmp}/download.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

# The first URL in the clipboard, when the clipboard holds one.  wl-paste -n
# drops the trailing newline and only the first line is read: a copied paragraph
# that happens to contain a link is not a download.
clipboard_url() {
	have wl-paste || return 0
	_line=$(wl-paste -n 2>/dev/null | head -n 1) || return 0
	case $_line in
	http://* | https://*) printf '%s' "$_line" ;;
	esac
}

while :; do
	clip=$(clipboard_url)
	files=$(find "$downloads" -maxdepth 1 -type f 2>/dev/null | wc -l) || files=0
	{
		ui_row "$UI_I_CLOUD" 'Paste a link' 'YouTube, Vimeo, SoundCloud, a direct file' link
		[ -n "$clip" ] &&
			ui_row "$UI_I_CLIPBOARD" 'The link in the clipboard' "$clip" clip
		ui_heading 'downloads'
		ui_row "$UI_I_FILES" 'The Downloads folder' \
			"$files file$(if [ "$files" -eq 1 ]; then :; else printf s; fi) · ~/Downloads" folder
		# Only while there is something to stop: a row that kills nothing is a
		# row that says the machine is busy when it is not.
		if pgrep -f '[y]t-dlp' >/dev/null 2>&1; then
			ui_row "$UI_I_STOP" 'Stop the download' \
				'kills yt-dlp; the .part file stays' stop "$UI_RED"
		fi
	} >"$tmp/rows"

	key=$(ui_pick 'Download' 'Enter downloads · Escape closes' <"$tmp/rows") || exit 0

	case $key in
	link)
		url=$("$dir/bar-pick" 'Link' -free) || continue
		;;
	clip) url=$clip ;;
	folder) exec "$dir/rofi-files" "$downloads" ;;
	stop)
		# The bracketed pattern cannot match this script's own command line,
		# and pkill's status is ignored: nothing to kill is not a failure.
		pkill -f '[y]t-dlp' 2>/dev/null || true
		ui_say Download 'Stopped · the .part file is still in ~/Downloads'
		continue
		;;
	*) exit 0 ;;
	esac

	url=$(printf '%s' "${url:-}" | tr -d '\r\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
	[ -n "$url" ] || continue
	case $url in
	http://* | https://*) ;;
	*)
		ui_say Download 'That is not a link' \
			'a download starts with http:// or https://' critical "$UI_ICON_ERROR"
		continue
		;;
	esac

	{
		ui_row "$UI_I_VIDEO" 'Video' 'the best picture and sound it can merge' video
		ui_row "$UI_I_MUSIC" 'Audio only' 'm4a, from the best audio stream' audio
	} >"$tmp/kind"
	kind=$(ui_pick 'Download' "$(ui_trim "$url" 70)" <"$tmp/kind") || continue
	case $kind in
	video | audio) ;;
	*) continue ;;
	esac

	BUSY_STOP='pkill -f "[y]t-dlp"' \
		"$dir/busy" start download 'Download' "Fetching $(ui_trim "$url" 48)…" \
		"$UI_ICON_DOWNLOAD"

	# --no-simulate is not decoration: `--print after_move:...` is a later stage
	# so it does not imply --simulate, but `--print` on its own does, and a
	# simulated run would print a path for a file it never wrote.  --no-mtime
	# keeps the file dated now instead of by the upload date, which is the order
	# the browser's search sorts by.
	set -- -P "$downloads" --no-playlist --no-mtime --no-simulate \
		--print after_move:filepath
	[ "$kind" = audio ] && set -- "$@" -x --audio-format m4a

	rc=0
	out=$(yt-dlp "$@" -- "$url" 2>"$tmp/err") || rc=$?

	# The bar's spinner was clicked: the card is gone and this run reports
	# nothing, because half a file is not a result.
	if "$dir/busy" cancelled download; then
		exit 0
	fi

	if [ "$rc" -ne 0 ]; then
		# The last lines of yt-dlp's stderr are the useful ones ("Video
		# unavailable", "Unsupported URL"); the traceback above them is not.
		err=$(tail -n 3 "$tmp/err" 2>/dev/null | tr '\n' ' ' |
			sed -e 's/  */ /g' -e 's/ *$//')
		"$dir/busy" fail download "yt-dlp: ${err:-failed with no message}" "$UI_ICON_ERROR"
		continue
	fi

	name=$(printf '%s\n' "$out" | tail -n 1)
	count=$(printf '%s\n' "$out" | grep -c . || true)
	[ -n "$name" ] || name=$(ls -t "$downloads" 2>/dev/null | head -n 1 || true)
	if [ "${count:-0}" -gt 1 ]; then
		"$dir/busy" end download "Saved $count files in ~/Downloads"
	elif [ -n "$name" ]; then
		"$dir/busy" end download "Saved $(basename -- "$name")"
	else
		"$dir/busy" end download 'Saved, in ~/Downloads'
	fi
done
