#!/bin/bash
# The detached half of Install LazyOS: the one thing that writes.
#
#   lazyos-install-run TARGET REPO
#
# ~/.config/bin/rofi-install asks the questions and starts this with setsid,
# because a copy of the system takes minutes and the menu that started it is
# gone in seconds.  From then on this is what the session watches: the busy card
# follows the installer's own steps, the bar spins, and the log below is the
# record - ~/.config/bin/lazyos-install-log opens it in a window, and the menu
# reads $state/status back the next time it is opened.
#
# What lives here and not in scripts/install-emmc.sh is preparation and
# reporting.  The preparation is exactly the two things that installer's own
# guards refuse to run with: a partition of the target mounted, and a running
# udisks2, which auto-mounts a partition the moment the new table appears and
# leaves the write half done (the failure write-sd.sh hit on this machine).  So
# this stops udisks2 - masked for the run, because stopping it does not stop
# D-Bus from activating it again in the middle of the write - and unmounts what
# is mounted.  The reporting is the log, the one-line status and the read-back
# of the disk at the end.  The install itself is one call to that script with
# CONFIRM=yes: nothing about the partitioning, the filesystems or the kernel
# partition is repeated here, and check-system.sh fails if a partitioning or
# filesystem command ever appears in this file.
#
# Deliberately not stoppable, like Format a disk and the apt install: a killed
# copy leaves a disk that is neither the old system nor the new one, so no
# BUSY_STOP is registered and the card says so when it is clicked.
#
# No `set -e`: every step is checked and reported, and an unexpected exit would
# leave $state/status saying "running" while nothing is running.

set -u

dir=$(cd -- "$(dirname -- "$0")" && pwd)
. "$dir/lib-rofi.sh"

target=${1:-}
repo=${2:-}

state=${XDG_RUNTIME_DIR:-/tmp}/lazyos-install
mkdir -p "$state" 2>/dev/null || {
	printf 'cannot create %s\n' "$state" >&2
	exit 1
}

# One run at a time.  The menu tests the pid file with kill -0, which a stale
# file can answer wrongly; this lock is released by the kernel however the
# process dies, which is the answer that matters when the thing holding it is
# rewriting a disk.
exec 9>"$state/lock" || exit 1
if ! flock -n 9; then
	printf 'another install is already running\n' >&2
	exit 1
fi

logdir=${XDG_STATE_HOME:-$HOME/.local/state}/lazyos
mkdir -p "$logdir" 2>/dev/null || logdir=$state
log=$logdir/install-$(date +%Y%m%d-%H%M%S).log

printf '%s\n' "$$" >"$state/run.pid"
printf '%s\n' "$log" >"$state/log"
printf '%s\n' "$target" >"$state/target"
printf 'running\n' >"$state/status"

# The log is the output: this runs detached, so there is no terminal to print
# to, and a person running it by hand reads the same file (tail -f) the log
# window opens.  The trap is what the menu's "did not finish" row depends on: a
# pid file that is gone is how a killed run is told from a running one.
udisks_was=no
restore_udisks() {
	[ "$udisks_was" = yes ] || return 0
	sudo -n systemctl unmask --runtime udisks2 >/dev/null 2>&1 || true
	sudo -n systemctl start udisks2 >/dev/null 2>&1 || true
}
trap 'rm -f "$state/run.pid"; restore_udisks' EXIT

set_status() { # STATE [NOTE]
	if [ -n "${2:-}" ]; then
		printf '%s: %s\n' "$1" "$2" >"$state/status"
	else
		printf '%s\n' "$1" >"$state/status"
	fi
}

busy() { "$dir/busy" "$@"; }

# fail NOTE: the one exit for anything that went wrong, before or after the
# write.  The note is the card's text and the menu's "last time" line; the log
# has the same sentence and everything that led to it.
fail() {
	printf 'ERROR: %s\n' "$1"
	set_status failed "$1"
	busy fail install "$1" "$UI_ICON_ERROR"
	exit 1
}

# The log is where everything below lands.  It is opened before anything
# happens and its failure is fatal: an install whose record cannot be read is
# not one this port is willing to run.
exec >>"$log" 2>&1 || fail "cannot write the log: $log"
printf '==> Install LazyOS: %s\n' "$(date -Ins)"
printf '    target : %s\n' "${target:-?}"
printf '    source : %s (%s)\n' "$(findmnt -n -o SOURCE / 2>/dev/null || echo '?')" "$(uname -r)"
printf '    repo   : %s\n' "${repo:-?}"
printf '    log    : %s\n' "$log"

busy start install 'Install LazyOS' "Copying this system to ${target:-the internal disk}…" "$UI_ICON_INSTALL"

# --- the two things install-emmc.sh refuses to run with -----------------------
# Its own disk_release() dies on both, after the menu said everything was fine;
# doing it here is what makes that refusal unreachable instead of surprising.

root_src=$(findmnt -n -o SOURCE / 2>/dev/null || :)
root_src=${root_src%%\[*}
root_disk=$(lsblk -snro NAME "$root_src" 2>/dev/null | tail -n 1 || :)
[ -b "$target" ] || fail "not a block device: ${target:-nothing was given}"
[ -x "$repo/scripts/install-emmc.sh" ] ||
	fail "there is no installer at ${repo:-?}/scripts/install-emmc.sh"
[ "$root_disk" = "${target##*/}" ] &&
	fail "this system is running from $target; boot the microSD and install from there"

if systemctl is-active --quiet udisks2 2>/dev/null; then
	udisks_was=yes
	printf 'Stopping udisks2 for the write (it auto-mounts a partition as soon as the new table appears)\n'
	sudo -n systemctl stop udisks2 ||
		fail 'could not stop udisks2, which would auto-mount the new partitions mid-write'
	sudo -n systemctl mask --runtime udisks2 >/dev/null 2>&1 ||
		printf '  (could not mask it; it is stopped, and the installer checks again)\n'
fi

for _part in $(lsblk -nro PATH "$target" 2>/dev/null || :); do
	[ "$_part" != "$target" ] || continue
	findmnt -rn -S "$_part" >/dev/null 2>&1 || continue
	printf 'Unmounting %s (the installer refuses a mounted target)\n' "$_part"
	sudo -n umount "$_part" || fail "could not unmount $_part"
done

# --- the install --------------------------------------------------------------
# One call, the documented one: the same script, the same CONFIRM=yes, the same
# environment a person would type.  DEVICE is forwarded because a port with more
# than one device selects it by that variable, and the installer forwards it to
# its own sudo the same way.  systemd-inhibit holds a sleep lock for the length
# of the copy, so a machine that idles into suspend does not do it with a
# half-written disk; without the binary the install still runs.
progress_lines() {
	while IFS= read -r _line; do
		_plain=$(printf '%s' "$_line" | sed -e 's/\x1b\[[0-9;]*[A-Za-z]//g')
		case $_plain in
		'==> '*) busy update install "${_plain#==> }" ;;
		esac
	done
}

run_install() { # [systemd-inhibit …]
	# env and not a bare `VAR=value` list: with no prefix "$@" is empty, and a
	# simple command whose first word came from an expansion makes bash read the
	# assignment after it as the *command* ("Failed to execute 'DEVICE='"), which
	# is a second and silent way for the install to fail before it starts.
	"$@" env DEVICE="${DEVICE:-}" DEVICE_BLOCK="$target" CONFIRM=yes \
		"$repo/scripts/install-emmc.sh" 2>&1 | tee -a "$log" | progress_lines
	install_rc=${PIPESTATUS[0]}
}

printf '\n==> %s\n' "$repo/scripts/install-emmc.sh DEVICE_BLOCK=$target CONFIRM=yes"
if command -v systemd-inhibit >/dev/null 2>&1; then
	run_install systemd-inhibit --what=sleep --mode=block --why='Installing LazyOS to the internal disk'
else
	printf '  (no systemd-inhibit: the machine could suspend in the middle of the copy)\n'
	run_install
fi

if [ "$install_rc" -ne 0 ]; then
	# The installer's own last word, with the colour it paints it in removed and
	# its `ERROR: ` prefix dropped (fail() puts one back): a notification is not a
	# terminal, and "ERROR: ERROR: …" is what a card looks like when it is.
	reason=$(sed -e 's/\x1b\[[0-9;]*[A-Za-z]//g' "$log" | sed -n 's/^ERROR: //p' | tail -n 1)
	fail "${reason:-the installer exited with status $install_rc} (log: $log)"
fi

# --- what the disk says now ---------------------------------------------------
# The read-back, because a copy that ended 0 with a disk that has no LazyOS
# partitions is not an install.  The labels are asked one by one: lsblk lists a
# disk's partitions in the order the kernel handed out their minors, and the
# partx round the layout runs can reorder them.
labels=$(lsblk -nro PARTLABEL "$target" 2>/dev/null | tr '\n' ' ')
for _want in pmOS_kernel pmOS_boot pmOS_root; do
	case $labels in
	*"$_want"*) ;;
	*) fail "the install ended but $target has no $_want partition (labels: ${labels:-none})" ;;
	esac
done
printf 'Read-back: %s\n' "$labels"

kpart=$(lsblk -nro PATH,PARTN "$target" 2>/dev/null | awk '$2 == 1 { print $1; exit }')
if [ -n "$kpart" ] && command -v futility >/dev/null 2>&1; then
	_show=$(sudo -n futility show "$kpart" 2>&1)
	case $_show in
	*'Body verification succeeded'*)
		printf 'Read-back: %s holds a dev-signed depthcharge kernel image\n' "$kpart"
		;;
	*)
		printf 'Read-back: futility did not confirm the signature on %s:\n%s\n' "$kpart" "$_show"
		fail "the kernel partition does not verify (see the log: $log)"
		;;
	esac
elif [ -z "$kpart" ]; then
	fail 'the disk has no kernel partition (partition 1) to check'
else
	printf 'Read-back: futility is not installed, so the kernel partition was not verified\n'
fi

set_status done
busy end install "Done: this system is on $target. Reboot and pick \"internal disk\" in the firmware menu."
