#!/bin/sh
# Format a disk: a USB stick or an SD card, wiped and made empty.
#
# This is the one destructive thing the session offers, so what makes it safe is
# the list, not the confirmation:
#
#   * a disk with anything *mounted* on it is not offered at all.  That single
#     rule already excludes the running root, /boot, and every stick udisks
#     mounted - and a busy disk would fail halfway anyway;
#   * a disk carrying a **ChromeOS kernel partition** is not offered: that is the
#     signature of a disk this machine boots from (p1 of the layout in
#     scripts/lib-cgpt.sh), so the eMMC, the card that wrote the system and the
#     card the system is running from are all excluded however they are named -
#     no device name is hardcoded here;
#   * zram, loop and optical devices are not disks a person formats.
#
# What is left has nothing this system needs on it, and the confirmation still
# names the device, its model and its size, with **Cancel as the first row** so a
# stray Enter does nothing.  The device is written by `parted` and `mkfs`, both
# already in the image (packages/base.list); udisks2 could do the same over
# D-Bus, but its Format method ships no CLI in Debian's package - `udiskie` has
# one, and that is a resident Python daemon this port does not install.
#
#   rofi-format          what can be formatted, and with which filesystem
#
# Reached from Places ("Format a disk"), which is where the disks are.
set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

tmp=$(mktemp -d "${TMPDIR:-/tmp}/format.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

have() { command -v "$1" >/dev/null 2>&1; }

missing=""
for _c in parted mkfs.vfat mkfs.ext4 lsblk; do
	have "$_c" || missing="$missing $_c"
done
if [ -n "$missing" ]; then
	ui_say 'Format a disk' "Missing:$missing (parted, dosfstools, e2fsprogs)" \
		critical "$UI_ICON_ERROR"
	exit 1
fi

# The ChromeOS kernel partition type.  A disk that has one is a disk this
# firmware can load a kernel from, which makes it a system disk and never a
# candidate - the eMMC and both cards of this machine are excluded by it.
KERN_TYPE=fe3a2a5d-4f32-41a7-b725-accc3285a309

candidates() {
	lsblk -dnro NAME,SIZE,MODEL,TRAN 2>/dev/null | while read -r name size model tran; do
		[ -n "${name:-}" ] || continue
		case $name in zram* | loop* | ram* | sr*) continue ;; esac
		# Anything mounted, on the disk itself or on a partition of it.
		_mnt=$(lsblk -nro MOUNTPOINT "/dev/$name" 2>/dev/null | tr -d '[:space:]' || true)
		[ -z "$_mnt" ] || continue
		# A bootable disk: one PARTTYPE read, matched with case so that no
		# `producer | grep -q` pipeline can report a false negative.
		_types=$(lsblk -nro PARTTYPE "/dev/$name" 2>/dev/null || true)
		case $_types in *"$KERN_TYPE"*) continue ;; esac
		# -r escapes a space in a model as \x20; the row shows a model, not an
		# escape sequence ("USB\x20DISK\x203.0" is not what a person reads).
		_model=$(printf '%s' "${model:-unknown model}" | sed 's/\\x20/ /g')
		ui_row "$UI_I_DISK" "/dev/$name" \
			"$_model · $size${tran:+ · $tran}" "fmt:$name" "$UI_YELLOW"
	done
}

candidates >"$tmp/rows"

if [ ! -s "$tmp/rows" ]; then
	ui_say 'Format a disk' \
		'Nothing to format: every disk here is mounted or is a system disk' \
		normal "$UI_ICON_DISK"
	exit 0
fi

key=$(ui_pick 'Format a disk' \
	'Enter picks the filesystem · Escape closes · only disks with nothing mounted are listed' \
	<"$tmp/rows") || exit 0
case $key in
fmt:*) name=${key#fmt:} ;;
*) exit 0 ;;
esac
dev=/dev/$name
info=$(lsblk -dnro SIZE,MODEL "/dev/$name" 2>/dev/null |
	sed -e 's/\\x20/ /g' -e 's/  */ /g' || true)

{
	ui_row "$UI_I_DISK" 'FAT32' 'any machine: Windows, macOS, a camera, a television' fat32
	ui_row "$UI_I_DISK" 'ext4' 'Linux only, and it keeps owners and permissions' ext4
} >"$tmp/fs"
fs=$(ui_pick 'Filesystem' "$dev · ${info:-} · everything on it is erased" <"$tmp/fs") ||
	exit 0
case $fs in
fat32 | ext4) ;;
*) exit 0 ;;
esac

# The destructive row is the second one on purpose: rofi selects the first row,
# so Enter on the confirmation cancels instead of erasing a disk.
{
	ui_row "$UI_I_UNDO" 'Cancel' 'nothing is written' cancel "$UI_GREEN"
	ui_row "$UI_I_WARN" "Erase $dev" "${info:-} · make it $fs" go "$UI_RED"
} >"$tmp/yes"
answer=$(ui_pick 'Erase this disk?' \
	"$dev · ${info:-} · every file on it is lost" <"$tmp/yes") || exit 0
[ "$answer" = go ] || exit 0

# Not stoppable, like an apt install: a kill in the middle of mkfs leaves a disk
# with half a filesystem, which is worse than waiting for it.
"$dir/busy" start format 'Format a disk' "Erasing $dev…" "$UI_ICON_DISK"

# Each step is asked for its own status instead of being nested inside the
# previous `if`: a failing `mkfs` in the body of an `if` ends the script through
# `set -e` before the card is turned into the reason, and the bar would spin
# forever on a disk that is already broken.
step=table
rc=0
out=$(sudo -n parted -s "$dev" mktable gpt 2>&1) || rc=$?
if [ "$rc" -eq 0 ]; then
	step=partition
	out=$(sudo -n parted -s "$dev" mkpart primary "$fs" 1MiB 100% 2>&1) || rc=$?
fi
if [ "$rc" -eq 0 ]; then
	# sda1 but mmcblk1p1: the kernel inserts a `p` when the device name already
	# ends in a digit.
	case $dev in
	*[0-9]) part="${dev}p1" ;;
	*) part="${dev}1" ;;
	esac
	# The node appears when udev has processed the new table; waiting for it is
	# cheaper than failing on a race.
	_n=0
	while [ ! -b "$part" ] && [ "$_n" -lt 50 ]; do
		sleep 0.1
		_n=$((_n + 1))
	done
	if [ ! -b "$part" ]; then
		rc=1
		out="$part did not appear: the kernel still has the old table"
	fi
fi
if [ "$rc" -eq 0 ]; then
	step=filesystem
	if [ "$fs" = fat32 ]; then
		out=$(sudo -n mkfs.vfat -F32 -n NUREB "$part" 2>&1) || rc=$?
	else
		out=$(sudo -n mkfs.ext4 -F -q -L NUREB "$part" 2>&1) || rc=$?
	fi
fi

if [ "$rc" -eq 0 ]; then
	"$dir/busy" end format "$dev is empty ($fs, label NUREB)"
	ui_say 'Format a disk' \
		"$dev · $fs · label NUREB · mount it from Places when you need it" \
		normal "$UI_ICON_DISK"
	exit 0
fi

"$dir/busy" fail format \
	"the $step step failed: $(printf '%s' "${out:-no message}" | tail -n 2 | tr '\n' ' ')" \
	"$UI_ICON_ERROR"
exit 1
