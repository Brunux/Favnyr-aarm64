#!/bin/sh
# What can be done with the row under the cursor: the second half of the browser.
#
# Enter in rofi-files *opens* a row; this is the menu behind Alt+1, which is
# rofi's -kb-custom-1 (rofi exits 10 instead of 0) and therefore needs
# `global-kb: true` in ~/.config/rofi/config.rasi: without it sway answers Alt+1
# with "workspace number 1" before rofi ever sees the key, and the menu acts on
# nothing at all (the finding is in the rofi bullet of AGENTS.md).
#
# Only the actions that fit the row are offered - a directory can be measured
# and packed, an archive unpacked, a disk image mounted, a video converted, and
# every row can be copied as a path or opened in a terminal - so the list is
# short and each row is one command.  Nothing here needs a package the image
# does not already have: tar/xz/zstd/unzip (packages/tools.list), ffmpeg,
# udisksctl (udisks2), wl-copy and foot.
#
#   rofi-file-actions <path>
#
# A long action (the du walk, a pack, an unpack, a transcode) is a `busy` card:
# the card is the progress and, for the ones that can be interrupted without
# leaving a half-written result that looks finished, the stop button.
set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

[ $# -ge 1 ] || exit 0
target=$1
if [ ! -e "$target" ] && [ ! -L "$target" ]; then
	ui_say 'File actions' "$(basename -- "$target") is not there any more" \
		critical "$UI_ICON_ERROR"
	exit 1
fi

have() { command -v "$1" >/dev/null 2>&1; }

base=$(basename -- "$target")
parent=$(cd -- "$(dirname -- "$target")" && pwd)
lower=$(printf '%s' "$base" | tr 'A-Z' 'a-z')

is_dir=no
[ -d "$target" ] && is_dir=yes
is_zip=no
case $lower in *.zip) is_zip=yes ;; esac
is_tar=no
case $lower in
*.tar | *.tar.gz | *.tar.xz | *.tar.bz2 | *.tar.zst | *.tgz | *.txz | *.tbz | *.tbz2 | *.tzst)
	is_tar=yes
	;;
esac
is_image=no
case $lower in *.iso | *.img) is_image=yes ;; esac
is_video=no
case $lower in
*.mp4 | *.mkv | *.webm | *.mov | *.avi | *.m4v | *.mpg | *.mpeg | *.ogv | *.wmv | *.flv | *.3gp)
	is_video=yes
	;;
esac
is_audio=no
case $lower in
*.mp3 | *.flac | *.ogg | *.oga | *.opus | *.wav | *.m4a | *.aac | *.wma | *.aiff | *.aif)
	is_audio=yes
	;;
esac

tmp=$(mktemp -d "${TMPDIR:-/tmp}/file-actions.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

{
	ui_note "$base" "$target"
	ui_heading 'actions'
	if [ "$is_dir" = yes ]; then
		ui_row "$UI_I_DISK" 'Disk usage' 'du -sh: how much it really takes' du
	fi
	ui_row "$UI_I_BOX" 'Compress' "→ $base.tar.xz, next to it" pack
	if [ "$is_zip" = yes ] || [ "$is_tar" = yes ]; then
		ui_row "$UI_I_BOX" 'Extract here' "→ a folder named after the archive" unpack
	fi
	if [ "$is_image" = yes ]; then
		ui_row "$UI_I_DISK" 'Mount the image' 'udisksctl loop-setup, then open it' mount
	fi
	if [ "$is_video" = yes ] || [ "$is_audio" = yes ]; then
		ui_row "$UI_I_VIDEO" 'Convert' 'ffmpeg: MP4 video or MP3 audio' convert
	fi
	ui_row "$UI_I_CLIPBOARD" 'Copy the path' "$target" copy
	ui_row "$UI_I_TERM" 'A terminal here' "$parent" term
} >"$tmp/rows"

key=$(ui_pick 'File actions' 'Enter runs the action · Escape closes' <"$tmp/rows") ||
	exit 0

case $key in
du)
	# The walk is the slow part on a big tree, and a killed du has nothing to
	# leave behind, so this one is stoppable.
	BUSY_STOP='pkill -f "[d]u -sh"' "$dir/busy" start du 'Disk usage' \
		"Measuring $base…" "$UI_ICON_DISK"
	rc=0
	out=$(du -sh -- "$target" 2>&1) || rc=$?
	"$dir/busy" cancelled du && exit 0
	if [ "$rc" -ne 0 ]; then
		"$dir/busy" fail du "$(printf '%s' "$out" | tail -n 1)" "$UI_ICON_ERROR"
		exit 1
	fi
	size=$(printf '%s\n' "$out" | cut -f1)
	"$dir/busy" end du "$base · $size"
	;;
pack)
	out="$parent/$base.tar.xz"
	if [ -e "$out" ]; then
		ui_say 'Compress' "$(basename -- "$out") already exists" normal "$UI_ICON_INFO"
		exit 0
	fi
	# Killing tar alone can leave the xz child writing into the archive, so the
	# stop line ends both.
	BUSY_STOP='pkill -f "[t]ar -caf"; pkill -f "[x]z"' "$dir/busy" start pack \
		'Compress' "Packing $base…" "$UI_ICON_BOX"
	rc=0
	err=$(tar -caf "$out" -C "$parent" -- "$base" 2>&1) || rc=$?
	"$dir/busy" cancelled pack && exit 0
	if [ "$rc" -ne 0 ]; then
		# A half-written archive is worse than none: it looks like a backup.
		rm -f -- "$out"
		"$dir/busy" fail pack "tar: $(printf '%s' "$err" | tail -n 1)" "$UI_ICON_ERROR"
		exit 1
	fi
	"$dir/busy" end pack "Packed $(basename -- "$out")"
	;;
unpack)
	case $lower in
	*.tar.gz) dest="$parent/${base%.tar.gz}" ;;
	*.tar.xz) dest="$parent/${base%.tar.xz}" ;;
	*.tar.bz2) dest="$parent/${base%.tar.bz2}" ;;
	*.tar.zst) dest="$parent/${base%.tar.zst}" ;;
	*) dest="$parent/${base%.*}" ;;
	esac
	if [ -e "$dest" ]; then
		ui_say 'Extract' "$(basename -- "$dest") already exists" normal "$UI_ICON_INFO"
		exit 0
	fi
	BUSY_STOP='pkill -f "[u]nzip"; pkill -f "[t]ar -x"' "$dir/busy" start unpack \
		'Extract' "Unpacking $base…" "$UI_ICON_BOX"
	rc=0
	mkdir -p -- "$dest"
	if [ "$is_zip" = yes ]; then
		err=$(unzip -q -o "$target" -d "$dest" 2>&1) || rc=$?
	else
		err=$(tar -xf "$target" -C "$dest" 2>&1) || rc=$?
	fi
	"$dir/busy" cancelled unpack && exit 0
	if [ "$rc" -ne 0 ]; then
		"$dir/busy" fail unpack \
			"$(printf '%s' "$err" | tail -n 1)" "$UI_ICON_ERROR"
		exit 1
	fi
	"$dir/busy" end unpack "Unpacked into $(basename -- "$dest")/"
	;;
mount)
	if ! have udisksctl; then
		ui_say 'Mount the image' 'udisksctl is not installed (package udisks2)' \
			critical "$UI_ICON_ERROR"
		exit 1
	fi
	rc=0
	out=$(udisksctl loop-setup -f "$target" 2>&1) || rc=$?
	loop=$(printf '%s\n' "$out" | sed -n 's/.* as \(\/dev\/loop[0-9][0-9]*\).*/\1/p' |
		tail -n 1)
	if [ "$rc" -ne 0 ] || [ -z "$loop" ]; then
		ui_say 'Mount the image' "$(printf '%s' "$out" | tail -n 1)" \
			critical "$UI_ICON_ERROR"
		exit 1
	fi
	rc=0
	out=$(udisksctl mount -b "$loop" 2>&1) || rc=$?
	if [ "$rc" -ne 0 ]; then
		# A disk image with a partition table has no filesystem of its own;
		# udisks says so and the loop device stays mapped.
		ui_say 'Mount the image' "$(printf '%s' "$out" | tail -n 1)" \
			critical "$UI_ICON_ERROR"
		exit 1
	fi
	# "Mounted /dev/loop0 at /run/media/<user>/<label>." - the full stop is
	# udisksctl's, and a path handed on with it does not exist.
	mp=$(printf '%s\n' "$out" | sed -n 's/.* at \(.*\)\.$/\1/p' | tail -n 1)
	[ -n "$mp" ] || {
		ui_say 'Mount the image' "$loop is mounted, but udisks did not say where" \
			normal "$UI_ICON_INFO"
		exit 0
	}
	exec "$dir/rofi-files" "$mp"
	;;
convert)
	if ! have ffmpeg; then
		ui_say 'Convert' 'ffmpeg is not installed (package ffmpeg)' \
			critical "$UI_ICON_ERROR"
		exit 1
	fi
	{
		if [ "$is_video" = yes ]; then
			ui_row "$UI_I_VIDEO" 'MP4' 'H.264 video with AAC audio, plays anywhere' mp4
		fi
		ui_row "$UI_I_MUSIC" 'MP3' 'the sound only, 190 kbit/s VBR' mp3
	} >"$tmp/kind"
	kind=$(ui_pick 'Convert' "$base" <"$tmp/kind") || exit 0
	case $kind in
	mp4)
		ext=mp4
		set -- -c:v libx264 -crf 23 -preset veryfast -c:a aac -b:a 160k
		;;
	mp3)
		ext=mp3
		set -- -vn -c:a libmp3lame -q:a 2
		;;
	*) exit 0 ;;
	esac
	out="$parent/${base%.*}.$ext"
	# A file asked to become what it already is would be written over itself:
	# the name gets a suffix instead, so re-encoding a film is possible and
	# nothing is destroyed.
	if [ "$out" = "$target" ]; then
		out="$parent/${base%.*}-converted.$ext"
	fi
	if [ -e "$out" ]; then
		ui_say 'Convert' "$(basename -- "$out") already exists" normal "$UI_ICON_INFO"
		exit 0
	fi
	BUSY_STOP='pkill -f "[f]fmpeg"' "$dir/busy" start convert 'Convert' \
		"$base → $(basename -- "$out")…" "$UI_ICON_VIDEO"
	rc=0
	err=$(ffmpeg -hide_banner -loglevel error -y -i "$target" "$@" "$out" 2>&1) || rc=$?
	"$dir/busy" cancelled convert && exit 0
	if [ "$rc" -ne 0 ]; then
		rm -f -- "$out"
		"$dir/busy" fail convert \
			"ffmpeg: $(printf '%s' "$err" | tail -n 1)" "$UI_ICON_ERROR"
		exit 1
	fi
	"$dir/busy" end convert "Converted to $(basename -- "$out")"
	;;
copy) ui_copy "$target" 'The path is in the clipboard' ;;
term)
	# A file's terminal is its folder's terminal.
	if [ "$is_dir" = yes ]; then
		setsid foot --working-directory="$target" >/dev/null 2>&1 &
	else
		setsid foot --working-directory="$parent" >/dev/null 2>&1 &
	fi
	;;
*) exit 0 ;;
esac
