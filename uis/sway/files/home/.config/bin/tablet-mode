#!/bin/sh
# Tablet mode: the on-screen keyboard, the touchpad off, and the screen turning
# with the device.
#
# The kernel already reports what this needs, so nothing has to be written for
# it: `cros_ec_buttons` carries SW_LID + SW_TABLET_MODE, which is what sway's
# `bindswitch tablet:on/off` (in etc/sway/config.d/28-tablet.conf) delivers, and
# `cros-ec-accel` publishes in_accel_{x,y,z}_raw under /sys/bus/iio.
#
#   tablet-mode on      keyboard up, touchpad off, the poller started
#   tablet-mode off     keyboard and poller gone, touchpad back, screen upright
#   tablet-mode toggle  whichever of those the state says
#   tablet-mode status  one line: whether it is on, and the screen rotation
#   tablet-mode poller  the 1 Hz loop (internal; `on` starts it)
#
# Nothing here is resident outside tablet mode: no daemon, no timer, just one
# process while the keyboard is detached (the keyboard itself) and one more
# sleeping for a second at a time (the poller).  Both live under
# $XDG_RUNTIME_DIR, so a session that dies takes them with it.
#
# Rotation comes from the accelerometer, which reports the reaction to gravity:
# screen up gives +Z, so the dominant axis in the screen plane is the roll.
#
#   | what the device is doing | reading  | transform |
#   |--------------------------|----------|-----------|
#   | flat, screen up          | +Z       | normal    |
#   | upright, landscape       | +Y       | normal    |
#   | upside down              | -Y       | 180       |
#   | turned clockwise         | -X       | 90        |
#   | turned counter-clockwise | +X       | 270       |
#
# The mapping assumes the panel frame ChromeOS uses (X to the right, Y to the
# top of the screen); if the screen turns the wrong way on the hardware, the
# four `transform` values in orient() are the whole fix.

set -eu

dir=$(dirname "$0")
state="${XDG_RUNTIME_DIR:-/tmp}/nureb-tablet"
kbd_bin=wvkbd-mobintl

say() { notify-send -a Nureb "${1:-Nureb}" "${2:-}" 2>/dev/null || true; }

out_name() {
	swaymsg -t get_outputs -r 2>/dev/null |
		jq -r '[ .[] | select(.focused) ][0].name // empty' 2>/dev/null |
		head -1
}

accel_dev() {
	for _d in /sys/bus/iio/devices/iio:device*; do
		[ -r "$_d/name" ] || continue
		[ "$(cat "$_d/name" 2>/dev/null)" = cros-ec-accel ] || continue
		[ -r "$_d/in_accel_x_raw" ] && [ -r "$_d/in_accel_y_raw" ] ||
			continue
		printf '%s\n' "$_d"
		return 0
	done
	return 1
}

# orient X Y Z -> normal|90|180|270, or "keep" when no axis dominates (the
# device is on a table edge, in a hand, mid-turn: better to leave the screen as
# it is than to flip it back and forth).
orient() {
	awk -v x="$1" -v y="$2" -v z="$3" 'BEGIN {
		m = sqrt(x * x + y * y + z * z)
		if (m < 1) { print "keep"; exit }
		if (z > 0.85 * m) { print "normal"; exit }
		if (y > 0.75 * m) { print "normal"; exit }
		if (y < -0.75 * m) { print "180"; exit }
		if (x < -0.75 * m) { print "90"; exit }
		if (x > 0.75 * m) { print "270"; exit }
		print "keep"
	}'
}

current_transform() {
	swaymsg -t get_outputs -r 2>/dev/null |
		jq -r '[ .[] | select(.focused) ][0].transform // empty' 2>/dev/null |
		head -1
}

apply_transform() { # TRANSFORM OUTPUT
	swaymsg output "$2" transform "$1" >/dev/null 2>&1 || true
}

is_on() {
	[ -f "$state/kbd.pid" ] || return 1
	kill -0 "$(cat "$state/kbd.pid" 2>/dev/null)" 2>/dev/null
}

poller() {
	_dev=$(accel_dev) || exit 0
	_out=$(cat "$state/out" 2>/dev/null || true)
	[ -n "$_out" ] || exit 0
	_last=""
	while [ -d "$state" ]; do
		_x=$(cat "$_dev/in_accel_x_raw" 2>/dev/null || echo 0)
		_y=$(cat "$_dev/in_accel_y_raw" 2>/dev/null || echo 0)
		_z=$(cat "$_dev/in_accel_z_raw" 2>/dev/null || echo 0)
		_t=$(orient "$_x" "$_y" "$_z")
		if [ "$_t" != keep ] && [ "$_t" != "$_last" ]; then
			apply_transform "$_t" "$_out"
			_last=$_t
		fi
		sleep 1
	done
}

start_kbd() {
	command -v "$kbd_bin" >/dev/null 2>&1 || {
		say Tablet 'the on-screen keyboard is not installed (wvkbd)'
		return 1
	}
	# Solarized, translucent, and the same font as the session: the keyboard is
	# part of the screen, not a foreign window.  -H is the portrait height and
	# -L the landscape one; both fit the 1200 px panel without covering it.
	setsid "$kbd_bin" -H 300 -L 240 -R 8 \
		--fn 'JetBrains Mono 13' \
		--bg 002b36 --fg 073642 --fg-sp 0a4a55 \
		--press 2aa198 --press-sp 268bd2 \
		--text 93a1a1 --text-sp 839496 \
		--alpha 242 >/dev/null 2>&1 &
	_pid=$!
	printf '%s\n' "$_pid" >"$state/kbd.pid"
	# A keyboard that cannot open a display exits at once, and a notification
	# claiming it is up while the screen has none is worse than saying so: the
	# switch would look dead with nothing to read anywhere.
	sleep 0.3
	if ! kill -0 "$_pid" 2>/dev/null; then
		rm -f "$state/kbd.pid"
		say Tablet 'the on-screen keyboard could not start (is there a Wayland session?)'
		return 1
	fi
	return 0
}

start_poller() {
	accel_dev >/dev/null || {
		say Tablet 'no accelerometer: the screen will not turn with the device'
		return 0
	}
	_out=$(out_name)
	[ -n "$_out" ] || return 0
	printf '%s\n' "$_out" >"$state/out"
	setsid "$dir/tablet-mode" poller >/dev/null 2>&1 &
	printf '%s\n' "$!" >"$state/poller.pid"
}

stop_pid() { # FILE
	[ -f "$1" ] || return 0
	_pid=$(cat "$1" 2>/dev/null || true)
	[ -n "$_pid" ] && kill "$_pid" 2>/dev/null || true
	rm -f "$1"
}

poller_alive() {
	[ -f "$state/poller.pid" ] || return 1
	kill -0 "$(cat "$state/poller.pid" 2>/dev/null)" 2>/dev/null
}

on() {
	if is_on; then
		# The keyboard is up: make sure the rotation is too.  A poller that
		# died leaves the screen fixed with no other sign, and the switch only
		# fires on a change, so nothing would restart it.
		poller_alive || start_poller
		return 0
	fi
	mkdir -p "$state"
	stop_pid "$state/poller.pid"
	start_kbd || { rmdir "$state" 2>/dev/null || true; return 1; }
	swaymsg input type:touchpad events disabled >/dev/null 2>&1 || true
	start_poller
	say Tablet 'Tablet mode: the keyboard is up and the screen follows the device'
}

off() {
	[ -d "$state" ] || {
		# Still undo what a killed session could have left behind.
		swaymsg input type:touchpad events enabled >/dev/null 2>&1 || true
		return 0
	}
	stop_pid "$state/poller.pid"
	stop_pid "$state/kbd.pid"
	rm -rf "$state"
	swaymsg input type:touchpad events enabled >/dev/null 2>&1 || true
	_out=$(out_name)
	if [ -n "$_out" ]; then apply_transform normal "$_out"; fi
	say Tablet 'Tablet mode off'
}

status() {
	if is_on; then
		printf 'on · screen %s\n' "$(current_transform)"
	else
		printf 'off\n'
	fi
}

case ${1:-} in
on) on ;;
off) off ;;
toggle)
	if is_on; then off; else on; fi
	;;
status) status ;;
poller) poller ;;
*)
	echo "usage: tablet-mode on|off|toggle|status" >&2
	exit 2
	;;
esac
