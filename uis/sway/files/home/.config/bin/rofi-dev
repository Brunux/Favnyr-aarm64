#!/bin/sh
# Developer: the profile, the way back from it, and a report for a bug.
#
# Three rows, and each one ends in a verb of bin/lazyos-profile, which is where
# the work is and which also runs from a terminal (this image answers ssh, and a
# machine whose session will not start still has a profile worth saving).  What
# this script adds is the two pickers a terminal does not need: the disk the
# archive goes to, and the archive that is about to be restored.
#
# The archive carries ~/.ssh and ~/.gnupg, so the default export is encrypted
# with a passphrase and the menu says so on its last row instead of leaving the
# discovery to the person who finds the stick.  The disk list is the same idea
# as rofi-places': a mounted filesystem a person can write to, or a partition
# that udisks can mount in one step, never / or /boot, and never a disk that
# ui_disk_system (lib-rofi.sh) calls the running system - exporting onto the
# card that boots this machine is not what "a USB drive" means, and the eMMC is
# not a target at all.
#
# Nothing here is resident: one rofi process while a list is open, then the
# helper's own run.  Alt+Ctrl+D opens this; the root menu carries the same row
# and the launcher entry is org.lazyos.dev.desktop.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

tmp=$(mktemp "${TMPDIR:-/tmp}/dev.XXXXXX")
trap 'rm -f "$tmp"' EXIT

# size_human BYTES
size_human() {
	if command -v numfmt >/dev/null 2>&1; then
		numfmt --to=iec --suffix=B "$1" 2>/dev/null || printf '%s B' "$1"
	else
		printf '%s B' "$1"
	fi
}

# parent_disk PARTITION_OR_DEVICE: the disk a partition lives on, so the system
# rule can be asked of it (lsblk -s walks from the source up to the disk).
parent_disk() {
	lsblk -snro NAME "$1" 2>/dev/null | tail -n 1 || :
}

# free_on PATH: what is free there, for the row's detail.  A read-only or
# otherwise unreadable target prints nothing rather than a wrong number.
free_on() {
	df -h --output=avail "$1" 2>/dev/null | tail -n 1 | tr -d ' ' ||
		df -Ph "$1" 2>/dev/null | awk 'NR == 2 { print $4 }' || :
}

# dev_targets: one row per directory this menu may write into.
#   dir:PATH      mounted and writable
#   mount:/dev/X  a filesystem that udisks has to mount first
dev_targets() {
	findmnt -rn -o TARGET,FSTYPE,OPTIONS 2>/dev/null |
		while read -r target fstype options; do
			case $fstype in
			ext2 | ext3 | ext4 | vfat | exfat | btrfs | xfs | f2fs | ntfs | ntfs3) ;;
			*) continue ;;
			esac
			case $target in
			/ | /boot | /boot/*) continue ;;
			esac
			# A read-only mount (a dirty exFAT stick comes up that way) would
			# fail after the passphrase; it is not offered.
			case ",$options," in
			*,ro,*) continue ;;
			esac
			[ -w "$target" ] || continue
			source=$(findmnt -no SOURCE -T "$target" 2>/dev/null || :)
			source=${source%%\[*}
			[ -n "$source" ] || continue
			disk=$(parent_disk "$source")
			if [ -n "$disk" ] && ui_disk_system "$disk"; then
				continue
			fi
			label=$(basename -- "$target")
			ui_row "$UI_I_DISK" "$label" "$target · $(free_on "$target") free" "dir:$target"
		done

	lsblk -rno NAME,TYPE,FSTYPE,LABEL,MOUNTPOINT 2>/dev/null |
		while read -r name type fstype label mountpoint; do
			case $type in
			part | disk) ;;
			*) continue ;;
			esac
			[ -n "$fstype" ] || continue
			[ -z "$mountpoint" ] || continue
			case $fstype in
			swap | crypto_LUKS) continue ;;
			esac
			# The SPI flash and the eMMC's hardware boot partitions are not
			# places a file goes (ui_disks carries the same exclusions).
			case $name in
			zram* | loop* | ram* | sr* | mtd* | mmcblk*boot* | mmcblk*rpmb | \
			dm-* | md* | nbd* | rbd*) continue ;;
			esac
			disk=$(parent_disk "/dev/$name")
			if [ -n "$disk" ] && ui_disk_system "$disk"; then
				continue
			fi
			shown=${label:-$name}
			shown=$(printf '%s' "$shown" | sed 's/\\x20/ /g')
			ui_row "$UI_I_DISK" "Mount $shown" "/dev/$name · $fstype" "mount:/dev/$name"
		done

	# The fallback, and the one target that never has to be mounted: the same
	# file then travels to the stick with a copy, which is what a machine with
	# no stick inserted can still do.
	ui_row "$UI_I_DOWNLOAD" 'This home folder' "$HOME/Downloads · copy it to the stick later" \
		"dir:$HOME/Downloads"
}

# pick_target PROMPT MESSAGE: print the directory the archive goes to, mounting
# the chosen partition when that is what was picked.  Exits 1 on Escape.
pick_target() {
	dev_targets >"$tmp.rows" || :
	ui_note 'Only disks this system does not need' \
		'a read-only mount is skipped' >>"$tmp.rows"
	key=$(ui_pick "${1:-Where}" "${2:-}" <"$tmp.rows") || return 1
	case $key in
	dir:*)
		target=${key#dir:}
		mkdir -p "$target" 2>/dev/null || :
		[ -d "$target" ] || {
			ui_say Developer "Cannot create $target" critical "$UI_ICON_ERROR"
			return 1
		}
		printf '%s\n' "$target"
		;;
	mount:*)
		dev=${key#mount:}
		if ! command -v udisksctl >/dev/null 2>&1; then
			ui_say Developer 'udisksctl is missing (package udisks2)' critical "$UI_ICON_ERROR"
			return 1
		fi
		if out=$(udisksctl mount -b "$dev" 2>&1); then
			mp=${out##* at }
			mp=${mp%.}
			printf '%s\n' "$mp"
		else
			ui_say Developer "$out" critical "$UI_ICON_ERROR"
			return 1
		fi
		;;
	*)
		return 1
		;;
	esac
}

# restore_rows: every exported profile this machine can see, newest first, with
# the date the archive was made and its size.  The scan itself lives in the
# helper (list-archives), so the menu and the terminal agree about where to look.
restore_rows() {
	"$dir/lazyos-profile" list-archives >"$tmp" || :
	[ -s "$tmp" ] || return 1
	tab=$(printf '\t')
	while IFS=$tab read -r path size epoch; do
		[ -n "$path" ] || continue
		when=$(date -d "@${epoch%%.*}" '+%Y-%m-%d %H:%M' 2>/dev/null) || when=
		ui_row "$UI_I_KEY" "$(basename -- "$path")" \
			"${when:+$when · }$(size_human "${size:-0}") · $path" "archive:$path"
	done <"$tmp"
}

{
	ui_row "$UI_I_BOX" 'Export my profile' \
		'keys, configs and packages, encrypted · to a disk' export
	ui_row "$UI_I_UNDO" 'Restore a profile' \
		'from an exported archive · the current files are backed up first' restore
	ui_row "$UI_I_BUG" 'Save a diagnostics bundle' \
		'the system report and this boot'"'"'s journal, for a bug report' report
	ui_note 'The archive carries ~/.ssh and ~/.gnupg' \
		'the passphrase is what protects it if the disk is lost'
} >"$tmp.menu"

key=$(ui_pick 'Developer' 'Enter opens · Escape closes' <"$tmp.menu") || exit 0
[ -n "${key:-}" ] || exit 0

case $key in
export)
	target=$(pick_target 'Export the profile to' 'Mounted disks first · Escape closes') || exit 0
	exec "$dir/lazyos-profile" export "$target"
	;;
restore)
	restore_rows >"$tmp.rows" || {
		ui_say Developer 'No exported profile on a mounted disk' normal "$UI_ICON_INFO" \
			'Insert the stick, mount it in Places, then try again'
		exit 0
	}
	history=$(ui_pick 'Restore a profile' \
		'Enter restores · the current files are backed up first · Escape closes' <"$tmp.rows") ||
		exit 0
	[ -n "${history:-}" ] || exit 0
	exec "$dir/lazyos-profile" import "${history#archive:}"
	;;
report)
	target=$(pick_target 'Save the diagnostics bundle to' \
		'No keys and no passwords are in it') || exit 0
	exec "$dir/lazyos-profile" report "$target"
	;;
esac
