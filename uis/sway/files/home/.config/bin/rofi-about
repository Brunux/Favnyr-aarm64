#!/bin/sh
# About: what this machine is, in one list.
#
# Deboma has an "About" window from its shell; the honest version here is the
# same facts as a rofi list (`fastfetch` in a terminal is one row away, and it is
# what paints the logo).  Everything is read, nothing is changed.  Three rows go
# one step further and open the log they summarise - the errors since this boot,
# the blame of the boot, the devices on the bus - because a count is what fits on
# a row and the output is what a bug report needs.  The fastfetch window is the
# exception to "nothing stays": it is a terminal, held open until it is closed,
# because a program that draws one picture and exits takes the window with it.
#
# The values come from the kernel and from procfs/sysfs, not from a package: a
# system that answers "which kernel am I running" without inxi is a system that
# can be asked that question while it is broken.  inxi and fastfetch stay what
# they are - the deep and the pretty versions, both in a terminal.

set -eu

dir=$(dirname "$0")
. "$dir/lib-rofi.sh"

have() { command -v "$1" >/dev/null 2>&1; }

model=$(tr -d '\0' <"/sys/firmware/devicetree/base/model" 2>/dev/null || true)
[ -n "${model:-}" ] || model="$(uname -m)"

revision=$(awk -F' ' '/^commit / { c = $2 } /^ui / { u = $2 } /^kernel / { k = $2 } /^built / { b = $2 }
	END { printf "%s · %s · %s · %s", c, u, k, b }' /etc/debian-aarch64-revision 2>/dev/null || true)

uptime=$(uptime -p 2>/dev/null | sed 's/^up //') || uptime=unknown

mem=$(free -h 2>/dev/null | awk 'NR == 2 { printf "%s of %s", $3, $2 }')
swap=$(awk 'NR > 1 { printf " · swap %.1f GiB", $3 / 1048576 }' /proc/swaps 2>/dev/null | head -1)

disk=$(df -h / 2>/dev/null | awk 'NR == 2 { printf "%s of %s used (%s)", $3, $2, $5 }')

# The system battery, not the first cell the kernel happens to enumerate: this
# machine also exposes the touchpad's own battery (hid-...-battery), which sits at
# 0% and would be reported as "the battery is empty" if it came first.  The SBS
# gauge is the one waybar reads too (`"bat": "sbs-8-000b"`).
batt=
for _b in /sys/class/power_supply/sbs-* /sys/class/power_supply/BAT* /sys/class/power_supply/*; do
	[ -r "$_b/capacity" ] || continue
	[ "$(cat "$_b/type" 2>/dev/null)" = Battery ] || continue
	case ${_b##*/} in hid-*) continue ;; esac
	_batt_state=$(cat "$_b/status" 2>/dev/null || true)
	batt="$(cat "$_b/capacity" 2>/dev/null)%${_batt_state:+ · $_batt_state}"
	break
done

# The active connection and its address, through NetworkManager: `ip` is not in
# the image (netlink is what NM uses) and `iw` only exists for the report, so
# nmcli is the one tool that answers both questions here.
dev=$(nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null |
	awk -F: '$3 == "connected" && $2 != "loopback" { print $1; exit }') || true
if [ -n "${dev:-}" ]; then
	con=$(nmcli -g GENERAL.CONNECTION device show "$dev" 2>/dev/null | head -1) || true
	case ${con:-} in
	'' | --) ;;
	*) ssid=$(nmcli -g 802-11-wireless.ssid connection show "$con" 2>/dev/null | head -1) || true ;;
	esac
	ip=$(nmcli -g IP4.ADDRESS device show "$dev" 2>/dev/null | head -1 |
		sed 's|/[0-9]*$||') || true
fi

compositor=$(sway --version 2>/dev/null | head -1) || compositor=unknown

# The three questions a bug report starts with: what failed since this boot, how
# long the boot took, and what is attached to the machine.  The number is what
# fits on a row and the log is one Enter away, because the answer is small and
# the output is not.
errs=$(sudo -n journalctl -q -p err -b --no-pager 2>/dev/null | wc -l) || errs=0
case ${errs:-0} in '' | *[!0-9]*) errs=0 ;; esac
boot_time=$(systemd-analyze 2>/dev/null |
	sed -n 's/^Startup finished in \(.*\) = .*$/\1/p' | head -1) || true
pci=$(lspci 2>/dev/null | wc -l) || pci=0
usb=$(lsusb 2>/dev/null | wc -l) || usb=0

summary="$model
Host: ${HOSTNAME:-$(uname -n)}
Revision: ${revision:-unknown}
Kernel: $(uname -r)
Uptime: $uptime
Memory: ${mem:-unknown}${swap}
Disk /: ${disk:-unknown}
Battery: ${batt:-none}
Wi-Fi: ${ssid:-not connected}${ip:+ · $ip}
Session: ${compositor:-unknown}"

tmp=$(mktemp "${TMPDIR:-/tmp}/about.XXXXXX")
trap 'rm -f "$tmp"' EXIT

{
	ui_row "$UI_I_DESKTOP" "$model" "${HOSTNAME:-$(uname -n)}" -
	ui_row "$UI_I_TAG" 'This image' "${revision:-no revision file}" -
	ui_row "$UI_I_CHIP" 'Kernel' "$(uname -r)" -
	ui_row "$UI_I_CLOCK" 'Uptime' "$uptime" -
	ui_row "$UI_I_BOX" 'Memory' "${mem:-unknown}${swap}" -
	ui_row "$UI_I_DISK" 'Disk (/)' "${disk:-unknown}" -
	[ -n "$batt" ] && ui_row "$UI_I_BATTERY" 'Battery' "$batt" -
	ui_row "$UI_I_WIFI" 'Network' "${ssid:-not connected}${ip:+ · $ip}" -
	ui_row "$UI_I_EYE" 'Session' "${compositor:-unknown}" -
	ui_row "$UI_I_CODE" 'Processes' "$(ps -e --no-headers 2>/dev/null | wc -l) processes" -
	ui_heading 'diagnostics'
	ui_row "$UI_I_BUG" 'Errors this boot' \
		"$errs line$(if [ "$errs" -eq 1 ]; then :; else printf s; fi) at priority err" errors
	ui_row "$UI_I_CLOCK" 'Boot time' "${boot_time:-unknown}" boot
	ui_row "$UI_I_CHIP" 'Devices' "${pci:-0} PCI · ${usb:-0} USB" devices
	ui_heading 'more'
	ui_row "$UI_I_CLIPBOARD" 'Copy this summary' 'the same lines as text' copy
	ui_row "$UI_I_TERM" 'The full picture' 'fastfetch, until you close it' fastfetch
} >"$tmp"

key=$(ui_pick 'About' 'Enter closes · the rows that act say so' <"$tmp") || exit 0

case ${key:-} in
copy) ui_copy "$summary" 'System summary copied' ;;
errors)
	# journalctl's own pager, in a terminal: the log is long, and a window that
	# holds a page of it is not the place to read the whole boot.
	exec foot --app-id=popup -T 'journalctl -p err -b' -e \
		sudo -n journalctl -p err -b
	;;
boot)
	exec foot --app-id=popup --hold -e sh -c \
		'systemd-analyze blame; printf "\n  systemd-analyze blame · close this window with Alt+Q\n"'
	;;
devices)
	exec foot --app-id=popup --hold -e sh -c \
		'lspci; printf "\n"; lsusb; printf "\n  close this window with Alt+Q\n"'
	;;
fastfetch)
	if have fastfetch; then
		# --hold: fastfetch draws once and exits, and without this the window it
		# was drawing in closes with it - "the full picture" flashed for a tenth
		# of a second.  The app-id stays `popup`, which is the float rule in
		# /etc/sway/config.d/25-bar-panels.conf; the closing line says why the
		# window is still there and how to be rid of it, since holding it is new.
		# The key it names is Alt+Q, the session's own close binding (sway's
		# `kill`), and not foot's built-in close key: the report from the card
		# says the built-in one does not answer on this keyboard, while Alt+Q
		# closes the same window.
		exec foot --app-id=popup --hold -e sh -c \
			'fastfetch; printf "\n  fastfetch has finished · close this window with Alt+Q\n"'
	fi
	ui_say About 'fastfetch is not installed (packages/tools.list)' critical "$UI_ICON_ERROR"
	;;
esac
