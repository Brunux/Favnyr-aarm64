#!/bin/sh
# Shared front-end for every menu the bar opens on a click.
#
# The bar is ported from Deboma (Omarchy + Quickshell), where each indicator
# opens a panel drawn by a resident shell process.  Here the same indicator
# opens rofi in dmenu mode instead: one short-lived process for as long as the
# popup is on screen, and nothing at all afterwards.  The look lives in
# ~/.config/rofi/solarized.rasi, the same theme the launcher uses, so every
# popup matches the bar (solarized dark, cyan rim, base02 selection) without
# repeating a colour here.
#
# rofi is also the launcher and the window switcher: one picker for the whole
# session, where this port previously ran tofi and fuzzel side by side.
#
# Usage: bar-pick PROMPT [extra rofi options] < choices
#
# The chosen line goes to stdout; a dismissal (Escape, click outside) exits 1
# with no output, which is what the callers test.
#
# Two kinds of prompt, because rofi's dmenu has to be told which it is:
#   * a list        a fixed set of lines arrives on stdin and only those may be
#                   picked (-no-custom): Escape is cancelled, Enter is a choice.
#   * a password    bar-net asks for a Wi-Fi password with -password: there is no
#                   list, the typed line is the answer, so it must be accepted
#                   (no -no-custom) and stdin must not be the terminal - rofi's
#                   dmenu reads stdin until EOF and would wait on a tty forever.

set -eu

prompt=${1:-Choose}
[ $# -eq 0 ] || shift

theme="$HOME/.config/rofi/solarized.rasi"

case " $* " in
*" -free "*)
	# Free text, no list: the typed line is the answer (a search term). Like
	# the password mode, stdin must not be the terminal - dmenu reads it until
	# EOF - so it comes from /dev/null.
	exec rofi -dmenu -theme "$theme" -p "$prompt" -lines 1 -no-show-icons \
		"$@" </dev/null
	;;
*" -password "*)
	# Masked input, no list, and nothing to pick: the answer is what is typed.
	# The entry's placeholder ("Search", from the theme) makes no sense next to a
	# password prompt, so it is dropped for this case only.
	exec rofi -dmenu -theme "$theme" -p "$prompt" -password -lines 1 -no-show-icons \
		-theme-str 'entry { placeholder: ""; }' "$@" </dev/null
	;;
esac

# -no-show-icons: the panels draw their own glyphs in the row text (lib-rofi.sh),
# and an icon column would only shift them right.  The launcher and the window
# switcher, which have real .desktop icons, are the other way round.
exec rofi -dmenu -theme "$theme" -p "$prompt" -lines 10 -no-custom -no-show-icons "$@"
