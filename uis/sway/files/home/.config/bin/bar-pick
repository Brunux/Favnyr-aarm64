#!/bin/sh
# Shared front-end for every menu the bar opens on a click.
#
# The bar is ported from Deboma (Omarchy + Quickshell), where each indicator
# opens a panel drawn by a resident shell process.  Here the same indicator
# opens fuzzel in dmenu mode instead: one short-lived process for as long as
# the popup is on screen, and nothing at all afterwards.  This script holds the
# one copy of the palette and geometry, so every popup looks like the bar
# (solarized dark, cyan selection, rounded corners) without repeating the
# flags in five places.
#
# Usage: bar-pick PROMPT [extra fuzzel options] < choices
#
# The chosen line goes to stdout; a dismissal (Escape, click outside) exits
# non-zero with no output, which is what the callers test.

set -eu

prompt=${1:-Choose}
[ $# -eq 0 ] || shift

exec fuzzel --dmenu \
	--prompt "$prompt > " \
	--font 'JetBrains Mono 11' \
	--lines 12 \
	--width 46 \
	--anchor top \
	--background 002b36ff \
	--text-color 93a1a1ff \
	--prompt-color 2aa198ff \
	--selection-color 2aa198ff \
	--selection-text-color 002b36ff \
	--border-color 2aa198ff \
	--border-width 2 \
	--border-radius 8 \
	--horizontal-pad 16 \
	--vertical-pad 10 \
	--inner-pad 4 \
	"$@"
