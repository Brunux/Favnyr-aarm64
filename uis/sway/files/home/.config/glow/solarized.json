  "list": {
    "level_indent": 2
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "horizontal_rule": {
    "color": "586e75",
    "format": "─"
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {
    "color": "eee8d5",
    "bold": true
  },
  "definition_description": {
    "block_prefix": "  ",
    "color": "93a1a1"
  },
  "html_block": {
    "color": "586e75"
  },
  "html_span": {
    "color": "586e75"
  }
