    "color": "93a1a1",
    "margin": 2
  },
  "paragraph": {
    "block_suffix": "\n",
    "color": "93a1a1"
  },
  "heading": {
    "block_suffix": "\n",
    "color": "eee8d5",
    "bold": true
  },
  "h1": {
    "prefix": "",
    "suffix": "",
    "color": "2aa198",
    "bold": true,
    "margin": 1
  },
  "h2": {
    "color": "2aa198",
    "bold": true,
    "margin": 1
  },
  "h3": {
    "color": "268bd2",
    "bold": true
  },
  "h4": {
    "color": "268bd2"
  },
  "h5": {
    "color": "93a1a1",
    "bold": true
  },
  "h6": {
    "color": "586e75",
    "bold": true
  },
  "text": {
    "color": "93a1a1"
  },
  "strong": {
    "color": "eee8d5",
    "bold": true
  },
  "emph": {
    "color": "eee8d5",
    "italic": true
  },
  "strikethrough": {
    "crossed_out": true
  },
  "link": {
    "color": "268bd2",
    "underline": true
  },
  "link_text": {
    "color": "268bd2",
    "bold": true
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "b58900",
    "background_color": "073642"
  },
  "code_block": {
    "margin": 1
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
