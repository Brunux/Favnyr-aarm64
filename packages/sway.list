# Sway desktop for the Hayato Debian image (matches Nura's current UI).
# One package per line; blank lines and lines starting with # are ignored.

# Wayland compositor + session
sway
swaybg
swayidle
swaylock
foot
fuzzel
wl-clipboard

# login manager
greetd
tuigreet

# audio
pipewire
pipewire-pulse
wireplumber
# Bluetooth audio support for PipeWire (BlueZ SPA plugins).
libspa-0.2-bluetooth
pavucontrol
alsa-ucm-conf

# graphics (panfrost) + portals
libgl1-mesa-dri
mesa-utils
xdg-desktop-portal-wlr
xdg-user-dirs

# fonts / input
fonts-dejavu-core
brightnessctl
playerctl
