# Base system packages (device-agnostic).
# One package per line; blank lines and lines starting with # are ignored.
# Device-specific packages live in devices/<codename>/packages.list.

# init / kernel plumbing
systemd-sysv
dbus
dbus-user-session
initramfs-tools
# zstd: initramfs-tools compresses the initramfs with zstd when the binary is
# present, otherwise it falls back to gzip and warns.
zstd
kmod
zram-tools

# users / auth
sudo
locales

# network
network-manager
network-manager-tui
wpasupplicant
# Regulatory database: without it cfg80211 logs
# "failed to load regulatory.db" and the WiFi stays on the world domain.
wireless-regdb
iw
openssh-server

# filesystems / storage
e2fsprogs
dosfstools
parted

# audio
# alsa-utils provides /usr/sbin/alsactl. On card add, udev
# (90-alsa-restore.rules) and alsa-restore.service run `alsactl restore`,
# which for a card with no saved state applies the UCM boot sequence. That
# boot sequence is what connects the MT8192 front-end and back-end DAIs: the
# UCM's BootSequence is never run automatically by alsa-lib (only by an
# explicit `set _boot`), so without alsactl the mt8192 PCMs fail to open with
# "no backend DAIs enabled", ACP marks the HiFi profile unsupported and
# WirePlumber falls back to a dummy sink (no speaker output). See AGENTS.md.
alsa-utils
# UCM profiles, including the MediaTek/mt8192 card.
alsa-ucm-conf
# Realtime scheduling for PipeWire/WirePlumber (otherwise they log
# "RTKit error: ServiceUnknown" and run without RT priority).
rtkit

# quality of life
ca-certificates
bash-completion
nano
htop
less
